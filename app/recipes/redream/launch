#!/bin/sh
set -eu
PICTURE_WIDTH=4
PICTURE_HEIGHT=3
PORTS="0 1 2 3"
FIRST_JOYSTICK_DEVICE=4
CONFIG=/engine/redream.cfg
LICENSE=/bios/redream.key
REDREAM_STATES=/engine/states
MENU_STATES=/engine/menu-states
SAVE_SLOT=1
LOAD_SLOT=2
cp /opt/redream/redream /engine/
find /bios -maxdepth 1 -type f -exec cp --remove-destination -t /engine/ {} +
export REDREAM_SAVES="$(printf '/engine/vmu%s.bin ' $PORTS)"
for save in $REDREAM_SAVES; do ln -sf "/saves/${save##*/}" "$save"; done
touch "$CONFIG"
sed -i '/^port[0-9]*=/d; /^language=/d; /^region=/d' "$CONFIG"
guid=$(joystick-guid)
for port in $PORTS; do echo "port$port=dev:$((FIRST_JOYSTICK_DEVICE + port)),desc:$guid,type:controller" >> "$CONFIG"; done
system-settings >> "$CONFIG"
height=${CANVAS#*x}
width=$((height * PICTURE_WIDTH / PICTURE_HEIGHT))
preload=
exec 3<&0
if [ -e "$LICENSE" ]; then
  mkfifo "$REDREAM_COMMANDS"
  if [ -d "$REDREAM_STATES" ] && [ ! -L "$REDREAM_STATES" ]; then mv "$REDREAM_STATES" "$MENU_STATES"; fi
  ln -sfT /states "$REDREAM_STATES"
  rewind /opt/redream/control $SAVE_SLOT $LOAD_SLOT .sav <&3 &
  preload=LD_PRELOAD=/opt/redream/commands.so
else
  echo "no $LICENSE: rewind needs redream premium" >&2
  cat <&3 > /dev/null &
fi
exec xwayland-run -geometry "${width}x$height" -- env $preload /engine/redream --width="$width" --height="$height" --res="$(cat "$RESOLUTION_STATE")" "$@"
