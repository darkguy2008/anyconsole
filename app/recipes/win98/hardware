BASE=/engine/base.img
ROM_DISK=/game/rom.img
DISK_SIZE=8G
SECTOR_BYTES=512
SECTORS_PER_TRACK=63
PARTITION_START=$SECTORS_PER_TRACK
PARTITION=@@$((PARTITION_START * SECTOR_BYTES))
MEMORY=1024
. /opt/win98/scsi
HARDWARE="-machine pc,accel=kvm,hpet=off -cpu host,level=13 -m $MEMORY -vga std $SCSI -nic none -rtc base=utc -global PIIX4_PM.disable_s3=1"
export MTOOLS_SKIP_CHECK=1

make_disk() {
  truncate -s "$DISK_SIZE" "$1"
  echo "start=$PARTITION_START, type=c, bootable" | sfdisk -q "$1"
  mkfs.fat -F 32 -h "$PARTITION_START" --offset "$PARTITION_START" "$1" >/dev/null
}

disk_partition() { echo "$1@@$(($(sfdisk --json "$1" | jq '.partitiontable.partitions[0].start') * SECTOR_BYTES))"; }

scsi_disk() { echo "-drive file=$2,if=none,id=disk$1,format=${3:-raw} -device scsi-hd,drive=disk$1,scsi-id=$1"; }

make_data_disk() {
  make_disk "$1"
  mmd -i "$1$PARTITION" "::/My Documents" ::/Desktop
}
