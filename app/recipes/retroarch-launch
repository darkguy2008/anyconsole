#!/bin/sh
set -eu
merge() {
  extra=$1
  shift
  jq -nrR --argjson extra "$extra" '
    [inputs | capture("^(?<key>[^ ]+) = \"(?<value>.*)\"$")] | from_entries + $extra
    | to_entries[] | "\(.key) = \"\(.value)\""' "$@"
}
merge "$(printf '%s' "$GAME_CONFIG" | jq -c '.options // {}')" /retroarch/core.opt > /tmp/core.opt
config=/retroarch/retroarch.cfg
if [ "$PICTURE" = retro ]; then
  merge '{}' /retroarch/retroarch.cfg /retroarch/retro.cfg > /tmp/retroarch.cfg
  config=/tmp/retroarch.cfg
fi
exec /retroarch/retroarch --verbose --config "$config" --libretro /retroarch/core.so "$@"
