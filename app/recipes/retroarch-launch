#!/bin/sh
set -eu
merge() {
  extra=$1
  shift
  jq -nrR --argjson extra "$extra" '
    [inputs | capture("^(?<key>[^ ]+) = \"(?<value>.*)\"$")] | from_entries + $extra
    | to_entries[] | "\(.key) = \"\(.value)\""' "$@"
}
refresh_options=$(printf '%s' "$REFRESH" | jq -c -f /retroarch/refresh.jq)
options=$(jq -n -c --argjson game "$GAME_CONFIG" --argjson refresh "$refresh_options" --arg language "$GAME_LANGUAGE" --argjson scale "$(cat "$RESOLUTION_STATE")" \
  'include "system"; include "resolution"; $refresh + system($language; $game.region // "") + ($game.options // {}) + if $scale > 1 then resolution($scale) else {} end')
merge "$options" /retroarch/core.opt > /tmp/core.opt
merge "$options" /retroarch/core.opt /retroarch/vulkan.opt > /tmp/vulkan.opt
LIBRETRO_CORE=/retroarch/core.so exec /retroarch/retroarch --verbose --config /retroarch/retroarch.cfg --libretro /retroarch/frame-size.so ${RESUME_SLOT:+--entryslot="$RESUME_SLOT"} "$@"
