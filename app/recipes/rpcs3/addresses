#!/usr/bin/python3
import sys

from capstone import CS_ARCH_X86, CS_MODE_64, CS_OP_IMM, CS_OP_REG, Cs
from capstone.x86 import X86_INS_TEST
from elftools.elf.elffile import ELFFile

SYMBOLS = {
    "G_CFG": "g_cfg",
    "FROM_STRING": "_ZN3cfg4node11from_stringESt17basic_string_viewIcSt11char_traitsIcEEb",
    "LV2_EVENT_QUEUE_SEND": "_ZN15lv2_event_queue4sendESt5tupleIJmmmmEEPbP14lv2_event_port",
    "CPU_TASK": "_ZN10ppu_thread8cpu_taskEv",
    "FINALIZE_RUN_REQUEST": "_ZN8Emulator18FinalizeRunRequestEv",
    "FAST_CALL": "_ZN10ppu_thread9fast_callEjmb",
    "GET_SFO_DIR": "_ZN5rpcs35utils26get_sfo_dir_from_game_pathERKNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEES8_",
    "USB_ADD_EVENT": "_ZN18usb_handler_thread9add_eventEmmm",
    "SLEEP_UNLOCKED": "_ZN7lv2_obj14sleep_unlockedER10cpu_threadmm",
    "GROUP_JOIN": "_Z25sys_spu_thread_group_joinR10ppu_threadjN2vm9_ptr_baseIN3stx4se_tIjLb1ELm4EEEjEES6_",
}
IMMEDIATES = {
    "EXITING_LOOP_MASK": "live_save_exiting_loop_mask",
    "PARKED_LOOP_MASK": "live_save_parked_loop_mask",
}
MEMBERS = {
    "GEM_CONFIG_MUTEX": ("named_thread<gem_config_data>", ["gem_config_data", "mtx"], "shared_mutex"),
    "GEM_TRACKER_MUTEX": ("named_thread<gem_tracker>", ["gem_tracker", "mutex"], "shared_mutex"),
    "USB_EVENT_MUTEX": ("named_thread<usb_handler_thread>", ["usb_handler_thread", "mutex_sq"], "shared_mutex"),
    "USB_EVENT_WAITERS": ("named_thread<usb_handler_thread>", ["usb_handler_thread", "sq"], "ppu_thread *"),
    "USB_EVENTS": ("named_thread<usb_handler_thread>", ["usb_handler_thread", "usbd_events"], "std::queue<std::tuple<unsigned long, unsigned long, unsigned long>, std::deque<std::tuple<unsigned long, unsigned long, unsigned long>, std::allocator<std::tuple<unsigned long, unsigned long, unsigned long> > > >"),
    "SYSUTIL_PENDING_CALLBACKS": ("sysutil_cb_manager", ["registered", "m_head", "m_data", "ptr"], "u64"),
}
STRUCTURES = ("DW_TAG_class_type", "DW_TAG_structure_type")
SCOPES = STRUCTURES + ("DW_TAG_namespace",)
ALIASES = ("DW_TAG_typedef", "DW_TAG_const_type", "DW_TAG_volatile_type")
LOOP = "_ZN10cpu_threadclEv"
IMMEDIATE_SIZE = 4


def loop_mask(instruction):
    return instruction.id == X86_INS_TEST and [operand.type for operand in instruction.operands] == [CS_OP_REG, CS_OP_IMM]


def unique_symbol(symbols, name):
    found = symbols.get_symbol_by_name(name) or []
    if len(found) != 1:
        sys.exit(f"{sys.argv[1]}: {name} not uniquely identified")
    return found[0]


def loop_mask_site(elf, symbol):
    start, size = symbol["st_value"], symbol["st_size"]
    text = elf.get_section(symbol["st_shndx"])
    code = text.data()[start - text["sh_addr"] : start - text["sh_addr"] + size]
    decoder = Cs(CS_ARCH_X86, CS_MODE_64)
    decoder.detail = True
    sites = [
        instruction.address + instruction.imm_offset
        for instruction in decoder.disasm(code, start)
        if loop_mask(instruction) and instruction.imm_size == IMMEDIATE_SIZE
    ]
    if len(sites) != 1:
        sys.exit(f"{sys.argv[1]}: {symbol.name} has {len(sites)} matching instructions, expected 1")
    return sites[0]


def qualified_name(die):
    names = []
    while True:
        name = die.attributes.get("DW_AT_name")
        if not name:
            return None
        names.insert(0, name.value.decode())
        die = die.get_parent()
        if die.tag not in SCOPES:
            return "::".join(names)


def type_name(die):
    if die.tag == "DW_TAG_pointer_type":
        return f"{type_name(die.get_DIE_from_attribute('DW_AT_type'))} *"
    return qualified_name(die)


def target(die):
    die = die.get_DIE_from_attribute("DW_AT_type")
    while die.tag in ALIASES:
        die = die.get_DIE_from_attribute("DW_AT_type")
    return die


def member_name(child):
    if child.tag == "DW_TAG_inheritance":
        return qualified_name(target(child))
    name = child.attributes.get("DW_AT_name")
    return name.value.decode() if child.tag == "DW_TAG_member" and name else None


def member_offset(die, path, expected_type):
    offset = 0
    for name in path:
        matches = [child for child in die.iter_children() if member_name(child) == name]
        location = matches[0].attributes.get("DW_AT_data_member_location") if len(matches) == 1 else None
        if not location or not isinstance(location.value, int):
            sys.exit(f"{qualified_name(die)}: {name} not uniquely identified at a constant offset")
        offset += location.value
        die = target(matches[0])
    if (found := type_name(matches[0].get_DIE_from_attribute("DW_AT_type"))) != expected_type:
        sys.exit(f"{'.'.join(path)} is a {found}, expected {expected_type}")
    return offset


def member_offsets(paths):
    owners = {owner for owner, _, _ in MEMBERS.values()}
    offsets = {macro: set() for macro in MEMBERS}
    for path in paths:
        with open(path, "rb") as library:
            for unit in ELFFile(library).get_dwarf_info().iter_CUs():
                for die in unit.iter_DIEs():
                    if die.tag in STRUCTURES and "DW_AT_declaration" not in die.attributes and (owner := qualified_name(die)) in owners:
                        for macro, (wanted, members, expected_type) in MEMBERS.items():
                            if wanted == owner:
                                offsets[macro].add(member_offset(die, members, expected_type))
    for macro, (owner, members, _) in MEMBERS.items():
        if len(offsets[macro]) != 1:
            sys.exit(f"{owner}: {len(offsets[macro])} layouts for {'.'.join(members)}, expected 1")
        print(f'-D{macro}="{owner}",{offsets[macro].pop():#x}')


def constant(elf, symbols, name):
    symbol = unique_symbol(symbols, name)
    section = elf.get_section(symbol["st_shndx"])
    start = symbol["st_value"] - section["sh_addr"]
    return int.from_bytes(section.data()[start : start + symbol["st_size"]], "little")


with open(sys.argv[2], "rb") as hook:
    elf = ELFFile(hook)
    symbols = elf.get_section_by_name(".dynsym")
    for macro, name in IMMEDIATES.items():
        print(f"-D{macro}={constant(elf, symbols, name):#x}")

with open(sys.argv[1], "rb") as binary:
    elf = ELFFile(binary)
    symbols = elf.get_section_by_name(".symtab")
    if not symbols:
        sys.exit(f"{sys.argv[1]}: no .symtab")
    for macro, name in SYMBOLS.items():
        print(f"-D{macro}={unique_symbol(symbols, name)['st_value']:#x}")
    print(f"-DLOOP_MASK_SITE={loop_mask_site(elf, unique_symbol(symbols, LOOP)):#x}")

member_offsets(sys.argv[3:])
