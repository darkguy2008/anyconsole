#!/bin/sh
set -eu
STATES=/states
CONTROL=$1
SAVE_SLOT=$2
LOAD_SLOT=$3
SAVED_SUFFIX=.$SAVE_SLOT$4
LOADED_SUFFIX=.$LOAD_SLOT$4

next_slot() {
  next=1
  for state in "$STATES"/*.state[0-9]*; do
    index=${state##*.state}
    case $index in *[!0-9]*) continue ;; esac
    [ "$index" -lt "$next" ] || next=$((index + 1))
  done
  echo "$next"
}

publish() { mv "$STATES/$1" "$STATES/${1%"$SAVED_SUFFIX"}.state$(next_slot)"; }

publish_saves() {
  inotifywait -m -q -e moved_to -e close_write --format %f "$STATES" | while IFS= read -r name; do
    case $name in *"$SAVED_SUFFIX") publish "$name" ;; esac
  done
}

load() {
  case $1 in
    0) number= ;;
    *) number=$1 ;;
  esac
  for state in "$STATES"/*.state"$number"; do
    [ -e "$state" ] || { echo "no state with slot $1" >&2; return 1; }
    ln -f "$state" "${state%.state"$number"}$LOADED_SUFFIX" && "$CONTROL" load "$LOAD_SLOT"
  done
}

publish_saves &
while read -r command argument; do
  case $command in
    SAVE_STATE) "$CONTROL" save "$SAVE_SLOT" ;;
    LOAD_STATE_SLOT) load "$argument" ;;
    *) echo "unknown command $command" >&2; false ;;
  esac || echo "$command $argument failed" >&2
done
