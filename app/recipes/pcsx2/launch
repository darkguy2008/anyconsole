#!/bin/sh
set -eu
PCSX2=$XDG_CONFIG_HOME/PCSX2
SETTINGS_VERSION=1
PAD_PORTS=2
OPENGL_RENDERER=12
VULKAN_RENDERER=14
OSD_MESSAGES_NONE=0
SAVE_SLOT=01
LOAD_SLOT=02
PICTURE_WIDTH=4
PICTURE_HEIGHT=3
PICTURE_ASPECT=$PICTURE_WIDTH:$PICTURE_HEIGHT
WIDESCREEN_ASPECT_RATIO="Auto 4:3/3:2"
NATIVE_SCALE=1

pad() {
  printf '[Pad%s]\nType = DualShock2\n' "$1"
  while read -r control binding; do printf '%s = SDL-%s/%s\n' "$control" "$(($1 - 1))" "$binding"; done < /opt/pcsx2/pad.map
}

pads() {
  for port in $(seq $PAD_PORTS); do pad "$port"; done
}

enhanced() { printf '%s' "$ENHANCED" | jq -r --arg key "$1" --arg default "$2" '.[$key] // $default'; }

settings() {
  cat <<SETTINGS
[UI]
SettingsVersion = $SETTINGS_VERSION
HideMouseCursor = true
[Folders]
MemoryCards = /saves
Savestates = /states
[EmuCore]
EnablePINE = true
BackupSavestate = false
EnableWideScreenPatches = $widescreen
[MemoryCards]
Slot1_Filename = ${game%.*}.ps2
Slot2_Enable = false
[EmuCore/GS]
Renderer = $renderer
VsyncEnable = true
SyncToHostRefreshRate = true
UseVSyncForTiming = true
SkipDuplicateFrames = false
AspectRatio = $aspect_ratio
FMVAspectRatioSwitch = $PICTURE_ASPECT
upscale_multiplier = $(enhanced scale $NATIVE_SCALE)
OsdMessagesPos = $OSD_MESSAGES_NONE
[EmuCore/Speedhacks]
vuThread = true
[Logging]
EnableSystemConsole = true
EnableFileLogging = false
EnableTimestamps = false
$(pads)
SETTINGS
}

renderer=$OPENGL_RENDERER
if [ "${1:-}" = --vulkan ]; then
  renderer=$VULKAN_RENDERER
  shift
fi
game=${1##*/}
widescreen=$(enhanced widescreen false)
aspect_ratio=$PICTURE_ASPECT
[ "$widescreen" = false ] || aspect_ratio=$WIDESCREEN_ASPECT_RATIO
rm -rf "$PCSX2/patches"
mkdir -p "$PCSX2/inis" "$PCSX2/bios" "$PCSX2/patches"
ln -sf /bios/* "$PCSX2/bios/"
find "${1%/*}" -maxdepth 1 -iname '*.pnach' -exec ln -s -t "$PCSX2/patches" {} +
settings > "$PCSX2/inis/PCSX2.ini"
exec 3<&0
RESUME_SLOT= rewind /opt/pcsx2/pine $SAVE_SLOT $LOAD_SLOT .p2s <&3 &
set -- -- "$1"
[ -z "$RESUME_SLOT" ] || set -- -statefile /states/*.state"$RESUME_SLOT" "$@"
height=${CANVAS#*x}
width=$((height * PICTURE_WIDTH / PICTURE_HEIGHT))
exec xwayland-run -geometry "${width}x$height" -- with-window-manager /opt/pcsx2/AppRun -nogui -fullscreen "$@"
