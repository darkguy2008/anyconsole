#!/bin/sh
. /etc/profile
. /etc/anyconsole.conf
mount -t proc proc /proc
mkdir -p /dev/pts
mount -t devpts -o ptmxmode=0666 devpts /dev/pts
ln -sf pts/ptmx /dev/ptmx
mount -t ramfs ramfs /run
mount -o remount,rw /
load_drivers
splash drm
mount -t ext4 "$(findfs LABEL=data)" /data
mount -t vfat "$(findfs LABEL=ESP)" /boot/efi
for status in /sys/class/drm/card*-*/status; do
  [ "$(cat "$status")" = connected ] || continue
  gfxmode="$(head -1 "${status%/status}/modes"),auto"
  grub-editenv "$GRUBENV" list | grep -qxF "gfxmode=$gfxmode" || grub-editenv "$GRUBENV" set gfxmode="$gfxmode"
  break
done
mkdir -p /data/root /data/ota /data/dhcpcd /data/dropbear /data/saves /run/stores "$GAMES_DIR" "$LOG_DIR" \
  "$PAD_NODES" "$INPUT_NODES" "$INPUTS_DIR" "$CATALOG_DIR" "$SOCKETS_DIR"
mkdir -m 700 -p "$XDG_RUNTIME_DIR"
mount -t cgroup2 cgroup2 /sys/fs/cgroup
otad mark-good
read -r boot_count 2>/dev/null < /data/boots || boot_count=0
boot_count=$((boot_count + 1))
echo "$boot_count" > /data/boots
. /etc/anyconsole-release
echo "anyconsole $VERSION slot=$(otad slot) boots=$boot_count"
setsid otad watch >> /data/otad.log 2>&1 &
