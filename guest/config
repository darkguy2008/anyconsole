MODULES="e1000e r8169 af_packet vfat nls_cp437 nls_utf8 virtio_pci evdev uinput joydev usbhid hid-generic overlay cifs"
MODULE_TREES="kernel/sound"
API_PORT=8080

PAD_FIFO=/run/pad
PAD_NODES=/run/pads
INPUT_NODES=/run/input
INPUTS_DIR=/run/inputs
STATE_FILE=/run/state.json
DISPLAY_FILE=/run/display/state.json
SETTINGS_FILE=/data/settings.json
RENDER_GPU_FILE=/data/render-gpu
RESOLUTIONS="720 1080 1440 2160"
STORES_FILE=/data/stores
CATALOG_DIR=/run/catalog
GAMES_DIR=/data/games
SOCKETS_DIR=/run/games
REWIND_DIR=/run/rewind
LOG_DIR=/data/log
GUIDE_DEVICE="anyconsole guide"
VOLUME_LIMIT=1.0
GAME_IMAGE=anyconsole
REWIND_LABEL=anyconsole.rewind
BIOS_DIR=/data/bios
PAD_NAME="Sony Interactive Entertainment DualSense Wireless Controller"
CONTROLLER_MAPPINGS=/usr/share/anyconsole/gamecontrollerdb.txt
SHARED_WITH_C="PAD_FIFO PAD_NODES INPUT_NODES INPUTS_DIR STATE_FILE DISPLAY_FILE SETTINGS_FILE RENDER_GPU_FILE RESOLUTIONS STORES_FILE CATALOG_DIR GAMES_DIR SOCKETS_DIR REWIND_DIR LOG_DIR GUIDE_DEVICE VOLUME_LIMIT REWIND_LABEL CONTROLLER_MAPPINGS PAD_NAME"

load_drivers() {
  modprobe -a $MODULES
  systemd-udevd --daemon
  udevadm trigger --action=add
  udevadm settle
}

OTA_HOST=10.0.0.236
OTA_INTERVAL=5
SYNC_DELAY=20
AUTO_INSTALL=0
AUTO_REBOOT=0
GRUBENV=/boot/efi/grub/grubenv
