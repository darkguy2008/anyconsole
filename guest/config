MODULES="e1000e r8169 af_packet vfat nls_cp437 nls_utf8 virtio_pci evdev uinput uhid overlay cifs"
MODULE_TREES="kernel/sound kernel/arch/x86/kvm kernel/drivers/hid kernel/drivers/input/joystick kernel/drivers/bluetooth kernel/net/bluetooth kernel/crypto"
API_PORT=8080

PAD_FIFO=/run/pad
PAD_NODES=/run/pads
INPUT_NODES=/run/input
STATE_FILE=/run/state.json
SESSION_FILE=/run/session.json
DISPLAY_FILE=/run/display/state.json
CONTROLLERS_FILE=/run/controllers/state.json
OVERLAY_FIFO=/run/overlay
SETTINGS_FILE=/data/settings.json
RENDER_GPU_FILE=/data/render-gpu
RESOLUTIONS="720 1080 1440 2160"
SLEEP_MINUTES="10 30 60 0"
STICK_REACH_DIVISOR=4
STORES_FILE=/data/stores
SMB=smb://
CATALOG_DIR=/run/catalog
GAMES_DIR=/data/games
SOCKETS_DIR=/run/games
REWIND_DIR=/run/rewind
LOG_DIR=/data/log
VOLUME_LIMIT=1.0
GAME_IMAGE=anyconsole
REWIND_LABEL=anyconsole.rewind
BIOS_DIR=/data/bios
PROFILES_DIR=/data/profiles
PROFILES=4
PADS=4
INPUT_DEVICES_MAX=64
WORD_MAX=31
NO_GAME=-
MANIFEST=manifest.json
REMOTE_PAD_NAME="Remote pad"
REMOTE_KEYBOARD_NAME="Remote keyboard"
EMULATE_LABEL=anyconsole.emulate
SPLASH_IMAGE=/usr/share/anyconsole/splash.png
KEYBOARD_NAME="anyconsole keyboard"
INPUT_RULES=/etc/udev/rules.d/70-anyconsole-input.rules
PAD_NAME="Sony Interactive Entertainment DualSense Wireless Controller"
MOTION_NAME="$PAD_NAME Motion Sensors"
CONTROLLER_MAPPINGS=/usr/share/anyconsole/gamecontrollerdb.txt
NUMBERS_SHARED_WITH_C="STICK_REACH_DIVISOR PROFILES PADS INPUT_DEVICES_MAX WORD_MAX"
SHARED_WITH_C="PAD_FIFO PAD_NODES INPUT_NODES STATE_FILE SESSION_FILE DISPLAY_FILE CONTROLLERS_FILE OVERLAY_FIFO SETTINGS_FILE RENDER_GPU_FILE RESOLUTIONS SLEEP_MINUTES STORES_FILE CATALOG_DIR GAMES_DIR SOCKETS_DIR REWIND_DIR LOG_DIR VOLUME_LIMIT REWIND_LABEL EMULATE_LABEL PROFILES_DIR NO_GAME MANIFEST REMOTE_PAD_NAME REMOTE_KEYBOARD_NAME SPLASH_IMAGE KEYBOARD_NAME CONTROLLER_MAPPINGS PAD_NAME MOTION_NAME"

load_drivers() {
  modprobe -a $MODULES
  systemd-udevd --daemon
  udevadm trigger --action=add
  udevadm settle
}

OTA_HOST=10.0.0.236
OTA_INTERVAL=5
SYNC_DELAY=20
AUTO_INSTALL=0
AUTO_REBOOT=0
GRUBENV=/boot/efi/grub/grubenv
