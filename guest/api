#!/bin/sh
. /etc/profile
. /etc/anyconsole.conf
. /etc/anyconsole-release
STATE_DIR=/data/ota

reply() { printf 'Status: %s\r\nContent-Type: application/json\r\n\r\n%s\n' "$1" "$2"; }
body() { head -c "${CONTENT_LENGTH:-0}"; }

remove_store() {
  case $1 in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -ge 1 ] && [ "$1" -le "$(wc -l < "$STORES_FILE")" ] || return 1
  awk -v position="$1" 'NR != position' "$STORES_FILE" > "$STORES_FILE.partial"
  mv "$STORES_FILE.partial" "$STORES_FILE"
}

action() {
  request=$(body | jq -ce .) || { reply 400 '{"ok":false,"error":"the request is not JSON"}'; return; }
  result=$(printf '%s\n' "$request" | socat STDIO,ignoreeof "UNIX-CONNECT:$OVERLAY_SOCKET") || result=
  [ -n "$result" ] || result='{"ok":false,"error":"the overlay closed the connection without a reply"}'
  if printf '%s' "$result" | jq -e .ok >/dev/null; then reply 200 "$result"; else reply 409 "$result"; fi
}

screenshot() {
  shot=$(mktemp)
  if WAYLAND_DISPLAY=$WAYLAND_SOCKET grim - > "$shot"; then printf 'Content-Type: image/png\r\n\r\n'; cat "$shot"; else reply 409 '{"error":"no screen to capture"}'; fi
  rm -f "$shot"
}

status() {
  [ -f $STATE_DIR/state ] && . $STATE_DIR/state
  printf '{"version":%s,"slot":"%s","inactive_staged":%s,"ota":"%s","boots":%s,"address":"%s","uptime":%s}' \
    "$VERSION" "$(otad slot)" "${STAGED_VERSION:-0}" "${STATE:-none}" "$(cat /data/boots)" \
    "$(global_addresses | head -n 1)" "$(cut -d. -f1 /proc/uptime)"
}

case "$REQUEST_METHOD $PATH_INFO" in
  "GET /status") reply 200 "$(status)" ;;
  "GET /state") reply 200 "$(cat "$STATE_FILE")" ;;
  "POST /update") otad update && reply 200 "$(status)" || reply 409 "$(status)" ;;
  "POST /reboot") reply 200 "$(status)"; exec 1>&-; reboot ;;
  "POST /poweroff") reply 200 "$(status)"; exec 1>&-; poweroff ;;
  "POST /stores")
    store=$(body)
    case $store in
      "$SMB"?*/?*) echo "$store" >> "$STORES_FILE" && reply 200 '{}' ;;
      *) reply 400 "{\"error\":\"a store is ${SMB}[user:password@]host/share/path\"}" ;;
    esac ;;
  "DELETE /stores/"*) remove_store "${PATH_INFO#/stores/}" && reply 200 '{}' || reply 404 '{"error":"no such store"}' ;;
  "POST /settings") { body; echo; } | { read -r name value; settings "$name" "$value"; } && reply 200 '{}' || reply 400 '{"error":"no such setting or value"}' ;;
  "POST /input") { body; echo; } | while IFS= read -r line; do [ -z "$line" ] || printf '%s\n' "$line" > "$PAD_FIFO"; done && reply 200 '{}' ;;
  "POST /action") action ;;
  "GET /screenshot") screenshot ;;
  "POST /volume") wpctl set-volume -l "$VOLUME_LIMIT" @DEFAULT_AUDIO_SINK@ "$(body)%" && reply 200 '{}' || reply 409 '{"error":"no audio output"}' ;;
  *) reply 404 '{"error":"no such endpoint"}' ;;
esac
