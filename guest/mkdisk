#!/bin/sh
set -eu
disk=$1 release=$2 esp=$3
ESP_MIB=512
SLOT_MIB=2048
mount_point=$(mktemp -d)
exec 9<"$disk"
flock 9

part() { case $disk in *[0-9]) echo "${disk}p$1" ;; *) echo "$disk$1" ;; esac; }

partition_disk() {
  sfdisk -q --wipe always --wipe-partitions always "$disk" <<TABLE
label: gpt
size=${ESP_MIB}MiB, type=uefi, name=ESP
size=${SLOT_MIB}MiB, type=linux, name=root-a
size=${SLOT_MIB}MiB, type=linux, name=root-b
type=linux, name=data
TABLE
  mkfs.fat -F32 -n ESP "$(part 1)" >/dev/null
  mke2fs -qF -t ext4 -L root-a "$(part 2)"
  mke2fs -qF -t ext4 -L root-b "$(part 3)"
  mke2fs -qF -t ext4 -L data "$(part 4)"
}

fill() {
  mount "$(part "$1")" "$mount_point"
  cp -a "$2"/. "$mount_point"/
  umount "$mount_point"
}

partition_disk
fill 2 "$release"
fill 3 "$release"
fill 1 "$esp"
rmdir "$mount_point"
