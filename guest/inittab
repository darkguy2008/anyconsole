::sysinit:/etc/rc
tty1::respawn:/opt/anyconsole/kiosk
::respawn:/bin/padd
ttyS0::respawn:-/bin/sh
::respawn:/bin/dhcpcd -B -4 eth0
::respawn:/bin/dropbear -F -R -E
::respawn:/bin/sh -c '. /etc/anyconsole.conf; exec /bin/httpd -f -p $API_PORT -h /www'
::respawn:/bin/sh -c '. /etc/anyconsole.conf; exec dockerd --config-file /etc/docker/daemon.json >>$LOG_DIR/dockerd.log 2>&1'
::respawn:/bin/sh -c '. /etc/profile; . /etc/anyconsole.conf; exec pipewire >>$LOG_DIR/pipewire.log 2>&1'
::ctrlaltdel:/bin/reboot
::shutdown:/bin/umount -a -r
