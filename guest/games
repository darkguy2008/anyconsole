#!/bin/sh
set -eu
. /etc/anyconsole.conf
. /etc/anyconsole-release
. /usr/share/anyconsole/oci
LAUNCH_LABEL=anyconsole.launch
VULKAN_LABEL=anyconsole.vulkan
BIOS_LABEL=anyconsole.bios
INSTALL_LABEL=anyconsole.install
PREPARE_LABEL=anyconsole.prepare
DEVICES_LABEL=anyconsole.devices
TOUCHPAD_LABEL=anyconsole.touchpad
SHARED_LABEL=anyconsole.shared
SANDBOX="--init --network none --cap-drop ALL --security-opt no-new-privileges --read-only --tmpfs /tmp --tmpfs /dev/shm"
ENGINE_SOURCE=rsync://$OTA_HOST/$ENGINES_MODULE
ENGINE_RUN=/run/engines
LOADED=$ENGINE_IMAGES/loaded
PREPARED=$ENGINE_IMAGES/prepared
FAILED=$ENGINE_IMAGES/failed
STORE=$ENGINE_IMAGES/store
STAGING=$ENGINE_IMAGES/staging

fetch_published() { rsync -rt --delete --mkpath "$ENGINE_SOURCE/contracts/$ENGINE_CONTRACT/" "$PUBLISHED_ENGINES/"; }

platforms() {
  [ -d "$PUBLISHED_ENGINES" ] || fetch_published
  ls "$PUBLISHED_ENGINES" | sed -n 's/\.json$//p'
}

progress() { awk -v RS='\r' -v step="$1" '$2 != shown { shown = $2; print step, $2 + 0; fflush() }'; }

image_config() { docker image inspect -f '{{json .Config}}' "$GAME_IMAGE/$1" 2>/dev/null || echo '{}'; }

image_id() { docker image inspect -f '{{.Id}}' "$GAME_IMAGE/$1" 2>/dev/null || :; }

engines() { docker image ls --format '{{.Repository}}' "$GAME_IMAGE/*" | sed "s|^$GAME_IMAGE/||"; }

fetch_blobs() { rsync -rt --ignore-existing --mkpath --files-from=- "$@" "$ENGINE_SOURCE/" "$STORE/"; }

lock_store() {
  exec 7>"$ENGINE_RUN/store.lock"
  flock -s 7
}

prune_store() {
  flock -n -x 7 || return 0
  set -- "$LOADED"/*.json
  [ -f "$1" ] || set --
  prune_blobs "$STORE" "$ENGINE_RUN/keep" "$@" || return 0
}

download() (
  set -o pipefail
  lock_store
  staged=$STAGING/$1
  rm -rf "$staged"
  mkdir -p "$staged" "$LOADED"
  cp "$PUBLISHED_ENGINES/$1.json" "$staged/index.json"
  echo "downloading 0"
  blobs=$(blobs_of "$STORE" "$staged/index.json")
  printf 'oci-layout\n%s\n' "$blobs" | fetch_blobs --no-inc-recursive --info=progress2 | progress downloading
  for blob in oci-layout $blobs; do
    mkdir -p "$staged/$(dirname "$blob")"
    ln "$STORE/$blob" "$staged/$blob"
  done
  echo unpacking
  tar -c -C "$staged" . | docker load -q >/dev/null
  [ "$(image_id "$1")" = "$(published_digest "$staged/index.json")" ] || { echo "the downloaded $1 engine is not the published one" >&2; exit 1; }
  mv "$staged/index.json" "$LOADED/$1.json"
  rm -rf "$staged"
  docker image prune -f >/dev/null
  prune_store
)

follow() {
  tail -n 1 -F "$ENGINE_RUN/$1.progress" 2>/dev/null &
  follower=$!
  flock 8
  kill "$follower"
}

prepare_engine() {
  [ "$(cat "$PREPARED/$1" 2>/dev/null)" != "$2" ] || return 0
  hook=$(label_of "$image" "$PREPARE_LABEL")
  [ -z "$hook" ] || {
    echo building | tee -a "$ENGINE_RUN/$1.progress"
    docker run --rm $SANDBOX $(platform_access "$1") --entrypoint "$hook" "$GAME_IMAGE/$1" >&2
  }
  mkdir -p "$PREPARED"
  echo "$2" > "$PREPARED/$1"
}

label_of() { printf '%s' "$1" | jq -r --arg name "$2" '.Labels[$name] // empty'; }

label() { label_of "$(image_config "$1")" "$2"; }

labels() { image_config "$1" | jq -c '.Labels // {}'; }

lock_engine() {
  mkdir -p "$ENGINE_RUN"
  exec 8>"$ENGINE_RUN/$1.lock"
}

prepare() {
  lock_engine "$1"
  flock -n 8 || follow "$1"
  [ -f "$PUBLISHED_ENGINES/$1.json" ] || fetch_published
  [ -f "$PUBLISHED_ENGINES/$1.json" ] || { echo "no $1 engine is published for this console" >&2; return 1; }
  published=$(published_digest "$PUBLISHED_ENGINES/$1.json")
  [ "$(image_id "$1")" = "$published" ] || (set -o pipefail; download "$1" | tee "$ENGINE_RUN/$1.progress")
  image=$(image_config "$1")
  prepare_engine "$1" "$published"
}

remove_engine() {
  lock_engine "$1"
  flock 8
  [ -z "$(image_id "$1")" ] || docker image rm "$GAME_IMAGE/$1" >/dev/null
  rm -f "$LOADED/$1.json" "$PREPARED/$1" "$FAILED/$1"
  lock_store
  prune_store
}

forget_built() {
  [ ! -e "$ENGINE_IMAGES/forgot-built" ] || return 0
  docker image ls -q --filter "label=$RECIPE_LABEL" | sort -u | xargs -r docker image rm -f >/dev/null
  docker builder prune -af >/dev/null
  mkdir -p "$ENGINE_IMAGES"
  touch "$ENGINE_IMAGES/forgot-built"
}

update() {
  forget_built
  fetch_published 2>/dev/null || return 0
  mkdir -p "$FAILED"
  for platform in $(engines); do
    [ -f "$PUBLISHED_ENGINES/$platform.json" ] || continue
    digest=$(published_digest "$PUBLISHED_ENGINES/$platform.json")
    { [ "$(cat "$PREPARED/$platform" 2>/dev/null)" = "$digest" ] || [ "$(cat "$FAILED/$platform" 2>/dev/null)" = "$digest" ]; } && continue
    [ -z "$(containers)" ] || return 0
    "$0" prepare "$platform" >/dev/null || echo "$digest" > "$FAILED/$platform"
  done
}

route_touchpad() { echo "touchpad ${1:-pointer}" > "$PAD_FIFO"; }

screen_state() { if [ -e "$GAMES_DIR/$1/$2/$SCREEN_FILE" ]; then echo on; else echo off; fi; }

platform_access() {
  bios=$(label_of "$image" "$BIOS_LABEL")
  [ -z "$bios" ] || { mkdir -p "$BIOS_DIR/$1"; echo "-v $BIOS_DIR/$1:$bios:ro"; }
  for device in $(label_of "$image" "$DEVICES_LABEL"); do echo "--device $device"; done
  for volume in $(printf '%s' "$image" | jq -r '(.Volumes // {}) | keys[]'); do
    mkdir -p "$ENGINES/$1$volume"
    echo "-v $ENGINES/$1$volume:$volume"
  done
}

mount_store() {
  share=${2#"$SMB"} options=ro,soft
  case $share in
    *@*) credentials=${share%%@*} share=${share#*@} ;;
    *) credentials= options=$options,guest ;;
  esac
  mkdir -p "$STORE_MOUNTS/$1"
  mounted=$(awk -v point="$STORE_MOUNTS/$1" '$2 == point { print $1 }' /proc/mounts)
  [ "$mounted" != "//$share" ] || return 0
  [ -z "$mounted" ] || umount -l "$STORE_MOUNTS/$1"
  USER=${credentials%%:*} PASSWD=${credentials#*:} mount.cifs "//$share" "$STORE_MOUNTS/$1" -o "$options"
}

refresh_store() {
  mount_store "$1" "$2" &&
    rsync -a --delete --delay-updates --include='/*/' --include='/*/manifest.json' \
      $(platforms | sed 's|.*|--include=/*/&/|') --exclude='*' "$STORE_MOUNTS/$1/" "$CATALOG_DIR/$1/" ||
    { rm -rf "${CATALOG_DIR:?}/$1"; ! mountpoint -q "$STORE_MOUNTS/$1" || umount -l "$STORE_MOUNTS/$1"; return; }
  rsync -rt --omit-dir-times --existing --include='/*/' --include="/*/$MANIFEST" --exclude='*' "$CATALOG_DIR/$1/" "$GAMES_DIR/"
}

prune() {
  for catalog in "$CATALOG_DIR"/*; do
    [ ! -d "$catalog" ] || [ "${catalog##*/}" -le "$1" ] || rm -rf "$catalog"
  done
  for mount in "$STORE_MOUNTS"/*; do
    [ ! -d "$mount" ] || [ "${mount##*/}" -le "$1" ] || { ! mountpoint -q "$mount" || umount -l "$mount"; rmdir "$mount"; }
  done
}

refresh() {
  store=0
  if [ -f "$STORES_FILE" ]; then
    platforms >/dev/null
    while read -r url; do
      store=$((store + 1))
      refresh_store $store "$url" &
    done < "$STORES_FILE"
    wait
  fi
  prune $store
}

copy() (
  set -o pipefail
  rsync -a --no-inc-recursive --info=progress2 "$1" "$2" | progress copying
)

install() {
  prepare "$3"
  rm -rf "$GAMES_DIR/$2/.$3"
  mkdir -p "$GAMES_DIR/$2/.$3"
  cp "$STORE_MOUNTS/$1/$2/manifest.json" "$GAMES_DIR/$2/"
  copy "$STORE_MOUNTS/$1/$2/$3/rom/" "$GAMES_DIR/$2/.$3/rom/"
  hook=$(label_of "$image" "$INSTALL_LABEL")
  [ -z "$hook" ] || { echo "installing"; docker run --rm $SANDBOX $(platform_access "$3") -v "$GAMES_DIR/$2/.$3/rom:/game" --entrypoint "$hook" "$GAME_IMAGE/$3" >&2; }
  mv "$GAMES_DIR/$2/.$3" "$GAMES_DIR/$2/$3"
}

uninstall() {
  rm -rf "${GAMES_DIR:?}/$1/$2"
  [ -n "$(find "$GAMES_DIR/$1" -mindepth 1 -maxdepth 1 -type d)" ] || rm -rf "${GAMES_DIR:?}/$1"
  [ -n "$(find "$GAMES_DIR" -mindepth 2 -maxdepth 2 -type d -name "$2")" ] || remove_engine "$2"
}

launch_file() {
  for extension in $(label_of "$image" "$LAUNCH_LABEL"); do
    file=$(find "$1" -maxdepth 1 -iname "*.$extension" | head -n 1)
    [ -z "$file" ] || { echo "${file##*/}"; return; }
  done
  echo "no launchable file in $1" >&2
  return 1
}

hold_idle_latency() {
  latency=$(cat $IDLE_LATENCIES 2>/dev/null | sort -n | grep -vxm1 0) || return 0
  exec 3>/dev/cpu_dma_latency
  printf '%#010x' "$latency" >&3
}

run() {
  rom=$GAMES_DIR/$1/$2/rom saves=$PROFILES_DIR/$5/saves/$1-$2
  image=$(image_config "$2")
  file=$(launch_file "$rom")
  mkdir -p "$saves"
  shared=$(label_of "$image" "$SHARED_LABEL")
  [ -z "$shared" ] || { mkdir -p "$GAMES_DIR/$1/$2/shared"; shared="-v $GAMES_DIR/$1/$2/shared:$shared"; }
  display=$(cat "$DISPLAY_FILE")
  video=
  route_touchpad "$(label_of "$image" "$TOUCHPAD_LABEL")"
  ! printf '%s' "$display" | jq -e .vulkan >/dev/null || video=$(label_of "$image" "$VULKAN_LABEL")
  hold_idle_latency
  exec docker run --rm -i --label "$GAME_LABEL=$1/$2" $SANDBOX $(platform_access "$2") $shared \
    --device /dev/dri --device-cgroup-rule 'c 13:* rw' -v "$PAD_NODES:/dev/input:ro" \
    -v "$3:/run/wayland" -v "$4:/states" -e WAYLAND_DISPLAY=/run/wayland/wayland-0 -e XDG_RUNTIME_DIR=/tmp \
    -e CANVAS="$(printf '%s' "$display" | jq -r .canvas)" -e PADS="$PADS" -e PAD_NAME="$PAD_NAME" -e MOTION_NAME="$MOTION_NAME" -e MICROPHONE="$MICROPHONE_NODE" -e SCREEN="$(screen_state "$1" "$2")" \
    -e GAME_CONFIG="$(jq -c --arg platform "$2" '.[$platform] // {}' "$GAMES_DIR/$1/manifest.json")" \
    -e REFRESH="$(jq -r --arg platform "$2" --argjson display "$display" --argjson mhz "$MHZ_PER_HZ" '.[$platform].refresh // ($display.refresh / $mhz)' "$GAMES_DIR/$1/manifest.json")" \
    -v "$XDG_RUNTIME_DIR/pulse/native:/run/pulse/native" -e PULSE_SERVER=unix:/run/pulse/native \
    -v "$rom:/game:ro" -v "$saves:/saves" "$GAME_IMAGE/$2" $video "/game/$file"
}

containers() { docker ps -q --filter "label=$GAME_LABEL${1:+=$1/$2}"; }

pause() { containers "$1" "$2" | xargs -r docker pause >/dev/null; }

resume() {
  image=$(image_config "$2") running=$(containers "$1" "$2")
  printf '%s\n' $running | xargs -r docker unpause >/dev/null
  route_touchpad "$(label_of "$image" "$TOUCHPAD_LABEL")"
  hook=$(label_of "$image" "$SCREEN_LABEL")
  [ -z "$hook" ] || printf '%s\n' $running | xargs -r -I{} docker exec {} "$hook" "$(screen_state "$1" "$2")"
}

close() { containers "$1" "$2" | xargs -r docker stop >/dev/null; }

stop() { containers | xargs -r docker rm -f >/dev/null; }

case "${1:-}" in
  refresh|prepare|install|uninstall|run|pause|resume|close|stop|labels|update) command=$1; shift; $command "$@" ;;
  *) cat >&2 <<'USAGE'
usage: games <command>
  refresh                         mount every store in /data/stores and list its games
  prepare <platform>              download the platform's published engine unless it is current, printing "<step> [percent]"
  install <store> <slug> <platform>  prepare the platform's engine and copy the game from a store, printing "<step> [percent]"
  uninstall <slug> <platform>     delete an installed game, keeping every profile's saves, and the engine with the platform's last game
  run <slug> <platform> <wayland dir> <states dir> <profile>  play an installed game in its sandbox with the profile's saves
  pause <slug> <platform>         freeze a running game
  resume <slug> <platform>        unfreeze a running game and show its second screen if chosen
  close <slug> <platform>         stop a running game, killing it if it hasn't quit by docker's stop timeout
  stop                            remove every running game container
  labels <platform>               print the labels of the platform's image as JSON
  update                          while no game runs, bring every downloaded engine to its published version
USAGE
    exit 1 ;;
esac
