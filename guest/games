#!/bin/sh
set -eu
. /etc/anyconsole.conf
MOUNTS=/run/stores
SAVES=/data/saves
ENGINES=/data/engines
RECIPES=/opt/anyconsole/recipes
PLATFORMS=/run/platforms
LAUNCH_LABEL=anyconsole.launch
GAME_LABEL=anyconsole.game
RECIPE_LABEL=anyconsole.recipe
VULKAN_LABEL=anyconsole.vulkan
BIOS_LABEL=anyconsole.bios
INSTALL_LABEL=anyconsole.install
SANDBOX="--init --network none --cap-drop ALL --security-opt no-new-privileges --read-only --tmpfs /tmp"
SMB=smb://

platforms() {
  [ -s $PLATFORMS ] || docker build -q --call targets,format=json $RECIPES |
    jq -r '.targets[] | select(.description) | .name' > $PLATFORMS
  cat $PLATFORMS
}

recipe_sum() { find $RECIPES -type f | sort | xargs cat | sha256sum | cut -d' ' -f1; }

build() (
  set -o pipefail
  docker build --progress=rawjson --network host --label "$RECIPE_LABEL=$2" --target "$1" -t "$GAME_IMAGE/$1" $RECIPES 2>&1 >/dev/null |
    jq -nR --unbuffered -r 'foreach (inputs | fromjson? // ("\(.)\n" | stderr | empty) | .vertexes[]? | select(.name | startswith("[internal]") | not)) as $vertex
      ({done: {}, percent: -1}; .done[$vertex.digest] = $vertex.completed | .shown = .percent
        | .percent = ([.percent, ((.done | map_values(values) | length) * 100 / (.done | length) | floor)] | max);
      select(.percent > .shown) | "building \(.percent)")'
)

image_config() { docker image inspect -f '{{json .Config}}' "$GAME_IMAGE/$1" 2>/dev/null || echo '{}'; }

label_of() { printf '%s' "$1" | jq -r --arg name "$2" '.Labels[$name] // empty'; }

label() { label_of "$(image_config "$1")" "$2"; }

prepare() {
  recipe=$(recipe_sum)
  image=$(image_config "$1")
  [ "$(label_of "$image" "$RECIPE_LABEL")" = "$recipe" ] || { build "$1" "$recipe"; image=$(image_config "$1"); }
}

mounts() {
  bios=$(label_of "$image" "$BIOS_LABEL")
  [ -z "$bios" ] || { mkdir -p "$BIOS_DIR/$1"; echo "-v $BIOS_DIR/$1:$bios:ro"; }
  for volume in $(printf '%s' "$image" | jq -r '(.Volumes // {}) | keys[]'); do
    mkdir -p "$ENGINES/$1$volume"
    echo "-v $ENGINES/$1$volume:$volume"
  done
}

mount_store() {
  share=${2#"$SMB"} options=ro,soft
  case $share in
    *@*) credentials=${share%%@*} share=${share#*@} ;;
    *) credentials= options=$options,guest ;;
  esac
  mkdir -p "$MOUNTS/$1"
  mounted=$(awk -v point="$MOUNTS/$1" '$2 == point { print $1 }' /proc/mounts)
  [ "$mounted" != "//$share" ] || return 0
  [ -z "$mounted" ] || umount -l "$MOUNTS/$1"
  USER=${credentials%%:*} PASSWD=${credentials#*:} mount.cifs "//$share" "$MOUNTS/$1" -o "$options"
}

refresh_store() {
  mount_store "$1" "$2" &&
    rsync -a --delete --delay-updates --include='/*/' --include='/*/manifest.json' \
      $(platforms | sed 's|.*|--include=/*/&/|') --exclude='*' "$MOUNTS/$1/" "$CATALOG_DIR/$1/" ||
    { rm -rf "${CATALOG_DIR:?}/$1"; ! mountpoint -q "$MOUNTS/$1" || umount -l "$MOUNTS/$1"; }
}

prune() {
  for catalog in "$CATALOG_DIR"/*; do
    [ ! -d "$catalog" ] || [ "${catalog##*/}" -le "$1" ] || rm -rf "$catalog"
  done
  for mount in "$MOUNTS"/*; do
    [ ! -d "$mount" ] || [ "${mount##*/}" -le "$1" ] || { ! mountpoint -q "$mount" || umount -l "$mount"; rmdir "$mount"; }
  done
}

refresh() {
  store=0
  if [ -f "$STORES_FILE" ]; then
    platforms >/dev/null
    while read -r url; do
      store=$((store + 1))
      refresh_store $store "$url" &
    done < "$STORES_FILE"
    wait
  fi
  prune $store
}

copy() (
  set -o pipefail
  rsync -a --no-inc-recursive --info=progress2 "$1" "$2" | awk -v RS='\r' '$2 != shown { shown = $2; print "copying", $2 + 0; fflush() }'
)

install() {
  prepare "$3"
  rm -rf "$GAMES_DIR/$2/.$3"
  mkdir -p "$GAMES_DIR/$2/.$3"
  cp "$MOUNTS/$1/$2/manifest.json" "$GAMES_DIR/$2/"
  copy "$MOUNTS/$1/$2/$3/rom/" "$GAMES_DIR/$2/.$3/rom/"
  hook=$(label_of "$image" "$INSTALL_LABEL")
  [ -z "$hook" ] || { echo "installing"; docker run --rm $SANDBOX $(mounts "$3") -v "$GAMES_DIR/$2/.$3/rom:/game" --entrypoint "$hook" "$GAME_IMAGE/$3" >&2; }
  mv "$GAMES_DIR/$2/.$3" "$GAMES_DIR/$2/$3"
}

uninstall() {
  rm -rf "${GAMES_DIR:?}/$1/$2"
  [ -n "$(find "$GAMES_DIR/$1" -mindepth 1 -maxdepth 1 -type d)" ] || rm -rf "${GAMES_DIR:?}/$1"
}

launch_file() {
  for extension in $(label_of "$image" "$LAUNCH_LABEL"); do
    file=$(find "$1" -maxdepth 1 -iname "*.$extension" | head -n 1)
    [ -z "$file" ] || { echo "${file##*/}"; return; }
  done
  echo "no launchable file in $1" >&2
  return 1
}

run() {
  rom=$GAMES_DIR/$1/$2/rom saves=$SAVES/$1-$2
  image=$(image_config "$2")
  file=$(launch_file "$rom")
  mkdir -p "$saves"
  display=$(cat "$DISPLAY_FILE")
  video=
  ! printf '%s' "$display" | jq -e .vulkan >/dev/null || video=$(label_of "$image" "$VULKAN_LABEL")
  exec docker run --rm -i --label "$GAME_LABEL=$1/$2" $SANDBOX $(mounts "$2") \
    --device /dev/dri --device-cgroup-rule 'c 13:* rw' -v "$PAD_NODES:/dev/input:ro" \
    -v "$3:/run/wayland" -v "$4:/states" -v "$5:/frames" -e WAYLAND_DISPLAY=/run/wayland/wayland-0 -e XDG_RUNTIME_DIR=/tmp \
    -e CANVAS="$(printf '%s' "$display" | jq -r .canvas)" -e PAD_NAME="$PAD_NAME" \
    -v "$XDG_RUNTIME_DIR/pulse/native:/run/pulse/native" -e PULSE_SERVER=unix:/run/pulse/native \
    -v "$rom:/game:ro" -v "$saves:/saves" "$GAME_IMAGE/$2" $video "/game/$file"
}

containers() { docker ps -q --filter "label=$GAME_LABEL${1:+=$1/$2}"; }

pause() { containers "$1" "$2" | xargs -r docker pause >/dev/null; }

resume() { containers "$1" "$2" | xargs -r docker unpause >/dev/null; }

stop() { containers | xargs -r docker rm -f >/dev/null; }

case "${1:-}" in
  refresh|prepare|install|uninstall|run|pause|resume|stop|label) command=$1; shift; $command "$@" ;;
  *) cat >&2 <<'USAGE'
usage: games <command>
  refresh                         mount every store in /data/stores and list its games
  prepare <platform>              build the platform recipe unless it is current, printing "building <percent>"
  install <store> <slug> <platform>  build the platform recipe and copy the game from a store, printing "<step> [percent]"
  uninstall <slug> <platform>     delete an installed game, keeping its saves
  run <slug> <platform> <wayland dir> <states dir> <frames dir>  play an installed game in its sandbox
  pause <slug> <platform>         freeze a running game
  resume <slug> <platform>        unfreeze a running game
  stop                            remove every running game container
  label <platform> <label>        print a label of the platform's image
USAGE
    exit 1 ;;
esac
