#!/bin/sh
set -eux
BINARIES="/bin/busybox /usr/bin/btop /usr/bin/rsync /usr/bin/grub-editenv"
apt-get update
apt-get install -y --no-install-recommends busybox btop ncurses-base rsync grub-common pax-utils
ROOTFS=/rootfs
mkdir -p $ROOTFS/etc $ROOTFS/proc $ROOTFS/sys $ROOTFS/dev $ROOTFS/run $ROOTFS/tmp \
  $ROOTFS/mnt $ROOTFS/data $ROOTFS/boot/efi $ROOTFS/usr/share/terminfo/l $ROOTFS/usr/share/udhcpc $ROOTFS/opt
lddtree --copy-to-tree $ROOTFS --bindir /bin --libdir /lib $BINARIES
busybox --install -s $ROOTFS/bin
ln -s bin $ROOTFS/sbin; ln -s ../bin $ROOTFS/usr/bin; ln -s ../bin $ROOTFS/usr/sbin; ln -s lib $ROOTFS/lib64
ln -s /data/root $ROOTFS/root
cp /usr/share/terminfo/l/linux $ROOTFS/usr/share/terminfo/l/
printf 'export LANG=C.UTF-8\nexport TERM=linux\nexport PATH=/bin:/opt/anyconsole\n' > $ROOTFS/etc/profile
cp /src/vm/guest/rc /src/vm/guest/inittab /src/vm/guest/otad.conf $ROOTFS/etc/
cp /src/vm/guest/otad $ROOTFS/bin/
cp /src/vm/guest/udhcpc.script $ROOTFS/usr/share/udhcpc/default.script
cp -a /src/app $ROOTFS/opt/anyconsole
printf 'VERSION=%s\n' "$VERSION" > $ROOTFS/etc/anyconsole-release
chmod +x $ROOTFS/etc/rc $ROOTFS/bin/otad $ROOTFS/usr/share/udhcpc/default.script
cp -a /src/vm/stage/. $ROOTFS/
mknod $ROOTFS/dev/console c 5 1
mknod $ROOTFS/dev/null c 1 3
tar -C $ROOTFS -czf /src/vm/rootfs.tar.gz .
