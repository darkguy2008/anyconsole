#!/bin/sh
set -eu
cd "$(dirname "$0")"
. config
. guest/config
api() { ssh "$DEPLOY_HOST" curl -fsS -X "$1" "localhost:$API_PORT/cgi-bin/api/$2"; echo; }

case "${1:-status}" in
  status) api GET status ;;
  update|reboot|poweroff) api POST "$1" ;;
  push)
    ./deploy
    api POST update
    api POST reboot ;;
  image)
    rsync -a --delete --exclude .git --exclude-from=.gitignore ./ "$DEPLOY_HOST:$DEPLOY_PATH/"
    ssh "$DEPLOY_HOST" "cd $DEPLOY_PATH && sh build/image >/dev/null"
    rsync -S --progress "$DEPLOY_HOST:$DEPLOY_PATH/build/out/installer.img" build/out/ ;;
  flash)
    disks=$(diskutil list external physical | awk '/^\/dev\/disk/ { print $1 }')
    [ -n "$disks" ] || { echo "no external disk plugged in" >&2; exit 1; }
    set --
    for disk in $disks; do set -- "$@" "$disk  $(diskutil info "$disk" | awk -F': *' '/Media Name|Disk Size/ { printf "%s  ", $2 }')"; done
    PS3="flash build/out/installer.img to (ERASES it): "
    select choice in "$@"; do [ -n "$choice" ] && break; done
    disk=${choice%% *}
    [ -n "$disk" ] || exit 1
    diskutil unmountDisk "$disk"
    sudo dd if=build/out/installer.img of="/dev/r${disk#/dev/}" bs=4m status=progress
    diskutil eject "$disk" ;;
  start) ssh "$DEPLOY_HOST" "setsid $DEPLOY_PATH/build/run >/dev/null 2>&1 &" ;;
  link) ssh "$DEPLOY_HOST" "echo set_link $NIC $2 | socat - UNIX-CONNECT:$DEPLOY_PATH/build/out/monitor.sock" >/dev/null ;;
  ssh) shift; exec sshpass -p "$CONSOLE_PASSWORD" ssh -J "$DEPLOY_HOST" -p "$SSH_PORT" root@127.0.0.1 "$@" ;;
  log) ssh "$DEPLOY_HOST" "tail -n ${2:-40} $DEPLOY_PATH/build/out/boot.log" ;;
  *) echo "usage: console [status|update|reboot|poweroff|push|image|flash|start|link on|off|ssh|log]" >&2; exit 1 ;;
esac
