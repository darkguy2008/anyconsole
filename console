#!/bin/sh
set -eu
cd "$(dirname "$0")"
. ./config
. guest/config
INSTALLER=build/out/installer.img
REBOOT_SECONDS=300
POLL_SECONDS=2
build_on_host() { on_host sh "$DEPLOY_PATH/build/host" sh build/image >/dev/null; }
build_image() {
  build_on_host
  rsync -S --mkpath --progress "$DEPLOY_HOST:$DEPLOY_PATH/$INSTALLER" "$INSTALLER"
}
on_vm_host() {
  ssh "$DEPLOY_HOST" "cd $DEPLOY_PATH && { flock -n $VM_FILE true && { echo 'no VM is running for this worktree, start one with: console start' >&2; exit 1; }; . ./$VM_FILE && $1; }"
}
SSH_HOST=root@${CONSOLE_BOX:-127.0.0.1}
ssh_route() {
  [ -z "${CONSOLE_BOX:-}" ] || return 0
  port=$(on_vm_host 'echo $VM_SSH_PORT') || return
  echo "-J $DEPLOY_HOST -p $port"
}
api_raw() {
  request="curl --fail-with-body -sS ${API_TIMEOUT:+-m $API_TIMEOUT} -X $1 --data-binary @-"
  if [ -n "${CONSOLE_BOX:-}" ]; then
    printf '%s' "${3:-}" | $request "$CONSOLE_BOX:$API_PORT/cgi-bin/api/$2"
  else
    printf '%s' "${3:-}" | on_vm_host "$request localhost:\$VM_API_PORT/cgi-bin/api/$2"
  fi
}
api() { api_raw "$@"; echo; }
action() { api POST action "$(jq -n '[$ARGS.positional[] | index("=") as $at | {(.[:$at]): .[$at + 1:]}] | add' --args "$@")"; }

wait_for_version() {
  for attempt in $(seq $((REBOOT_SECONDS / POLL_SECONDS))); do
    API_TIMEOUT=$POLL_SECONDS api GET status 2>/dev/null | jq -e ".version == $1" >/dev/null && { echo "running v$1"; return; }
    sleep $POLL_SECONDS
  done
  echo "the console did not come back on v$1 within ${REBOOT_SECONDS}s" >&2
  exit 1
}

case "${1:-status}" in
  status) api GET status ;;
  state) api GET state ;;
  store)
    case "${2:-}" in
      list) api GET state | jq -r '.stores | to_entries[] | "\(.key + 1)  \(.value.label)  \(if .value.online then "online" else "offline" end)"' ;;
      add) api POST stores "$3" ;;
      del) api DELETE "stores/$3" ;;
      *) exec "$0" help ;;
    esac ;;
  input) shift; api POST input "$(printf '%s\n' "$@")" ;;
  action) shift; action "$@" ;;
  screenshot) api_raw GET screenshot > "$2" ;;
  login) action action=login arg="$2" ${3:+"device=$3"} ;;
  logout)
    reply=$(action action=log-out profile="$2") || { echo "$reply"; exit 1; }
    if [ "$(echo "$reply" | jq -r .state.screen)" = logout ]; then action action=confirm-log-out profile="$2"; else echo "$reply"; fi ;;
  volume) api POST volume "$2" ;;
  set) api POST settings "$2 ${3:-}" ;;
  update|reboot|poweroff) api POST "$1" ;;
  push)
    ./deploy
    version=$(cat VERSION)
    api POST update | jq -e ".inactive_staged == $version" >/dev/null || { echo "the console did not stage v$version" >&2; exit 1; }
    api POST reboot >/dev/null
    wait_for_version "$version" ;;
  image)
    sync_host
    build_image ;;
  flash)
    set --
    for disk in $(diskutil list external physical | awk '/^\/dev\/disk/ { sub("^/dev/", "", $1); print $1 }'); do
      set -- "$@" "$disk$(diskutil info "$disk" | awk -F': *' '/Media Name|Disk Size/ { printf "  %s", $2 }')"
    done
    [ $# -gt 0 ] || { echo "no external disk plugged in" >&2; exit 1; }
    PS3="flash $INSTALLER to (ERASES it): "
    select disk; do [ -n "$disk" ] && break; done
    disk=${disk%% *}
    [ -n "$disk" ] || exit 1
    diskutil unmountDisk "$disk"
    sudo dd if="$INSTALLER" of="/dev/r$disk" bs=4m status=progress
    diskutil eject "$disk" ;;
  test)
    shift
    sync_host
    build_on_host
    on_host sh "$DEPLOY_PATH/build/test" "$@" ;;
  start) on_host sh "$DEPLOY_PATH/build/run" ;;
  link) ssh "$DEPLOY_HOST" "echo set_link $NIC $2 | socat - UNIX-CONNECT:$DEPLOY_PATH/build/out/monitor.sock" >/dev/null ;;
  ssh) shift; route=$(ssh_route); with_password ssh $route "$SSH_HOST" "$@" ;;
  bios) route=$(ssh_route); with_password rsync -a -e "ssh $route" "$2/" "$SSH_HOST:$BIOS_DIR/" ;;
  log) ssh "$DEPLOY_HOST" "tail -n ${2:-40} $DEPLOY_PATH/build/out/boot.log" ;;
  help) cat >&2 <<'USAGE'
usage: console [box address] <command>
  without an address, commands go to this worktree's QEMU test VM
  status     show the running console's OTA state
  state      show the console's screen, games, stores, audio and controllers
  store add smb://[user:password@]host/share/path  add a game store
  store list  number every game store and show whether it is online
  store del <n>  remove the nth store listed by store list
  input <line>...  send remote pad lines ("1 a 1", "1 guide 0"), remote keyboard events ("EV_KEY KEY_LEFTMETA 1"), "pair" or "forget <address>"
  action <field=value>...  run a menu action and print {ok, error, notifications, state}; fields: action (see state's .rows[].action), label, value, arg, game (slug/platform), profile, device, step
  screenshot <file>  save a PNG of the console's screen
  login <profile> [device]  sign a profile in, optionally with a device id from state
  logout <profile>  sign a profile out, closing the games it launched
  volume <percent>  set the output volume
  set display [label]  show the console on this display from state (none = Auto)
  set mode [mode]  drive the display at this mode from state's .display.modes, e.g. 3840x2160@60000 (none = Auto)
  set resolution <height>  render games and menus at this 16:9 height (0 = Auto)
  set sleep <minutes>  disconnect idle Bluetooth controllers after this long (0 = never)
  update     make it sync and stage the published release
  reboot     reboot it
  poweroff   power it off
  push       deploy a new release, then update and reboot it
  image      build disk + USB installer in this worktree's workspace on the build host, fetch installer.img
  flash      write installer.img to an external disk (erases it)
  test [name...]  build, then split the named tests over TEST_VMS QEMU VMs on slots of their own, each installed from the USB image (default: all, see TESTS and TEST_VMS in build/test)
  start      boot this worktree's QEMU test VM on the build host and print its VNC address
  link on|off  connect or unplug the VM's network cable
  ssh [cmd]  shell into the running console
  bios <folder>  copy <folder>/<platform>/<files> into the console's BIOS store
  log [n]    tail the VM's serial boot log
USAGE
    exit 1 ;;
  *)
    [ -z "${CONSOLE_BOX:-}" ] && [ $# -gt 1 ] || exec "$0" help
    box=$1
    shift
    CONSOLE_BOX=$box exec "$0" "$@" ;;
esac
