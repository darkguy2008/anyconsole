#!/bin/sh
set -eu
cd "$(dirname "$0")"
. vm/guest/otad.conf
api() { ssh "$DEPLOY_HOST" curl -fsS -X "$1" "localhost:$API_PORT/cgi-bin/api/$2"; echo; }

case "${1:-status}" in
  status) api GET status ;;
  update|reboot|poweroff) api POST "$1" ;;
  push)
    ./deploy.sh
    api POST update
    api POST reboot ;;
  start) ssh "$DEPLOY_HOST" "setsid $DEPLOY_PATH/vm/run.sh >/dev/null 2>&1 &" ;;
  link) ssh "$DEPLOY_HOST" "echo set_link $NIC $2 | socat - UNIX-CONNECT:$DEPLOY_PATH/vm/monitor.sock" >/dev/null ;;
  ssh) shift; exec sshpass -p "$CONSOLE_PASSWORD" ssh -o ProxyCommand="ssh $DEPLOY_HOST socat - TCP:127.0.0.1:$SSH_PORT" root@anyconsole "$@" ;;
  log) ssh "$DEPLOY_HOST" "tail -n ${2:-40} $DEPLOY_PATH/vm/boot.log" ;;
  *) echo "usage: console [status|update|reboot|poweroff|push|start|link on|off|ssh|log]" >&2; exit 1 ;;
esac
