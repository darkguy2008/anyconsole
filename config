CONSOLE_PASSWORD=anyconsole

NIC=nic0
VM_MEMORY_MIB=2048
SLOT_SSH_PORT=2300
SLOT_API_PORT=8100
SLOT_VNC_DISPLAY=10
VM_FILE=build/out/vm

DEPLOY_HOST=ale
WORKSPACES=anyconsole-workspaces
HOST_DIR=/srv/anyconsole
RELEASES_DIR=$HOST_DIR/rel
LOCK_DIR=/run/anyconsole
BASE_IMAGE_PREFIX=anyconsole-rootfs-base
TEST_IMAGE_PREFIX=anyconsole-test

TEST_STORE=build/out/store
OVMF_DIR=build/out
OVMF_CODE=$OVMF_DIR/OVMF_CODE.fd
OVMF_VARS=$OVMF_DIR/OVMF_VARS.fd
TEST_BIOS=$HOST_DIR/bios

fetch() {
  directory=$1 name=$2 url=$3
  if curl -fsSL -R --remove-on-error -z "$directory/$name" -o "$directory/$name.part" "$url"; then
    [ ! -f "$directory/$name.part" ] || mv "$directory/$name.part" "$directory/$name"
  else
    [ -f "$directory/$name" ]
  fi
}
run_qemu() {
  vars=$1 disk=$2 forwards=$3
  shift 3
  qemu-system-x86_64 -machine q35,accel=kvm -cpu host -smp 4 -m $VM_MEMORY_MIB \
    -drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE" -drive if=pflash,format=raw,file="$vars" \
    -device ich9-ahci,id=ahci -drive file="$disk",format=raw,if=none,id=d0 -device ide-hd,drive=d0,bus=ahci.0 \
    -netdev "user,id=net0,$forwards,smb=$PWD/$TEST_STORE" -device e1000e,netdev=net0,id=$NIC \
    -audiodev none,id=sound -device ich9-intel-hda -device hda-micro,audiodev=sound -vga none -device virtio-vga-gl -display egl-headless "$@"
}
engine_contract() { cat "$1/guest/games" "$1/guest/thumbnails" | sha256sum | cut -d' ' -f1; }
RELEASE_LOCK_SECONDS=1800
UNDATED=0
lock_releases() {
  exec 9>>"$RELEASES_DIR/.lock"
  flock -w $RELEASE_LOCK_SECONDS 9 || { echo "another publish held $RELEASES_DIR for ${RELEASE_LOCK_SECONDS}s" >&2; exit 1; }
}
export_engine_image() {
  name=$1 destination=$2
  shift 2
  SOURCE_DATE_EPOCH=$UNDATED docker buildx build -q --network host --provenance=false --sbom=false --output "type=oci,name=$name,tar=false,dest=$destination" "$@" >/dev/null
}
releases_rsyncd_conf() {
  path=$1
  shift
  printf 'use chroot = no\nuid = root\ngid = root\n'
  printf '%s\n' "$@"
  printf '[rel]\npath = %s\nread only = yes\n[%s]\npath = %s/%s\nread only = yes\n' "$path" "$ENGINES_MODULE" "$path" "$ENGINES_MODULE"
}
with_password() { SSH_ASKPASS="$PWD/build/askpass" SSH_ASKPASS_REQUIRE=force "$@"; }
workspace_name() { slug=$(printf %s "${1##*/}" | tr -c 'a-z0-9._-' _) && checksum=$(printf %s "$1" | cksum) && printf '%s-%s\n' "$slug" "${checksum%% *}"; }
live_workspaces() {
  worktrees=$(git worktree list --porcelain) || return
  while read -r key worktree; do
    if [ "$key" = worktree ]; then workspace=$(workspace_name "$worktree") || return; printf '%s ' "$workspace"; fi
  done <<EOF
$worktrees
EOF
}
DEPLOY_PATH=$WORKSPACES/$(workspace_name "$(pwd -P)")
sync_host() {
  live=$(live_workspaces) || return
  rsync -a --mkpath --delete --exclude .git --exclude-from=.gitignore ./ "$DEPLOY_HOST:$DEPLOY_PATH/"
  ssh "$DEPLOY_HOST" sh "$DEPLOY_PATH/build/prune" "${DEPLOY_PATH##*/}" "$live"
}
on_host() { ssh "$DEPLOY_HOST" flock -s -o "$DEPLOY_PATH.lock" "$@"; }
published_version() {
  if [ -f "$RELEASES_DIR/index" ]; then (. "$RELEASES_DIR/index"; echo "$REL"); else echo 0; fi
}
require_newer() {
  published=$(published_version)
  [ "$1" -gt "$published" ] || { echo "v$1 is not newer than the published v$published; raise VERSION first" >&2; exit 1; }
}
