#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. ./config
. guest/config
. guest/oci
RECIPES=app/recipes
BUILT=build/out/rel/$ENGINES_MODULE
PUBLISHED=$RELEASES_DIR/$ENGINES_MODULE
LIST=contracts/$(engine_contract .)
RETROARCH_REPO=https://github.com/libretro/RetroArch
RETROARCH_WAYLAND_FIX=a0e2372730
HTTP_NOT_FOUND=404

platforms() { docker build -q --call targets,format=json $RECIPES | jq -r '.targets[] | select(.description) | "\(.name)\t\(.description)"'; }

export_engine() {
  name=docker.io/$GAME_IMAGE/$1:latest
  export_engine_image "$name" "$BUILT" --target "$1" --label "$NAME_LABEL=$2" $RECIPES
  index=$BUILT/$LIST/$1.json
  jq --arg name "$name" '.manifests |= [map(select(.annotations["io.containerd.image.name"] == $name)) | last]' "$BUILT/index.json" > "$index"
  config=$BUILT/$(blob_paths '.config.digest' "$BUILT/$(blob_paths '.manifests[0].digest' "$index")")
  jq --slurpfile image "$config" '.manifests[0].annotations += ($image[0].config.Labels // {})' "$index" > "$index.partial"
  mv "$index.partial" "$index"
}

retroarch_arg() { printf '%s' "$1" | jq -r --arg name "$2" '.args[] | select(.name == $name) | .value'; }

warn_retroarch_pin() {
  outline=$(docker build -q --call outline,format=json --target retroarch $RECIPES)
  stable=$(retroarch_arg "$outline" RETROARCH)
  pinned_build=$(retroarch_arg "$outline" RETROARCH_BUILD)
  tags=$(git ls-remote --tags --refs $RETROARCH_REPO 'v*')
  latest=$(printf '%s\n' "$tags" | sed 's|^.*refs/tags/v||' | sort -V | tail -n 1)
  [ "$latest" = "$stable" ] || echo "RetroArch $latest is out: if it has $RETROARCH_WAYLAND_FIX, pin it as RETROARCH_BUILD and its ADD --checksum in $RECIPES/Dockerfile instead of $pinned_build" >&2
  status=$(curl -sI --retry 3 -o /dev/null -w '%{http_code}' "$pinned_build")
  [ "$status" != $HTTP_NOT_FOUND ] || echo "the pinned RetroArch build $pinned_build is gone: pin a newer nightly as RETROARCH_BUILD and its ADD --checksum in $RECIPES/Dockerfile" >&2
}

fetch_blobs() { echo "$1 lacks a blob its engine lists name" >&2; return 1; }

prune() {
  keep=$(mktemp)
  prune_blobs "$1" "$keep" "$1"/contracts/*/*.json || { rm "$keep"; echo "kept every blob in $1" >&2; return 1; }
  rm "$keep"
}

build() {
  warn_retroarch_pin
  rm -rf "$BUILT/index.json" "$BUILT/contracts"
  mkdir -p "$BUILT/$LIST"
  platforms | while IFS="$(printf '\t')" read -r platform description; do export_engine "$platform" "$description"; done
  prune "$BUILT"
}

publish() {
  lock_releases
  rsync -a --ignore-existing --mkpath "$BUILT/oci-layout" "$BUILT/blobs" "$PUBLISHED/"
  rsync -a --delete --mkpath "$BUILT/$LIST/" "$PUBLISHED/$LIST/"
  prune "$PUBLISHED"
}

case "${1:-}" in
  build|publish) "$1" ;;
  *) echo "usage: build/engines build|publish" >&2; exit 1 ;;
esac
