#!/bin/sh
set -eux

ROOTFS=/rootfs
LIBDIR=/usr/lib/x86_64-linux-gnu
BINARIES="/usr/bin/wayland-info /usr/bin/grim /bin/busybox /usr/bin/mountpoint /usr/sbin/modprobe /bin/padd /bin/splash /bin/overlay /bin/compositor /sbin/sfdisk /sbin/mke2fs /sbin/mkfs.fat /usr/bin/btop /usr/bin/rsync /usr/bin/grub-editenv /usr/bin/flock /usr/sbin/dropbear /usr/sbin/dhcpcd /usr/bin/udevadm /usr/sbin/mount.cifs /usr/bin/jq"
GBM_BACKEND=$LIBDIR/gbm/dri_gbm.so
EGL_VENDORS=/usr/share/glvnd/egl_vendor.d
VULKAN_DRIVERS=/usr/share/vulkan/icd.d
SOFTWARE_VULKAN_DRIVER=lvp_icd.json
UDEV="/usr/bin/udevadm $LIBDIR/systemd/libsystemd-shared-*.so"
AUDIO="/usr/bin/pipewire /usr/bin/pipewire-pulse /usr/bin/wireplumber /usr/bin/wpctl /usr/bin/pw-dump"
AUDIO_PLUGINS="$LIBDIR/pipewire-0.3 $LIBDIR/spa-0.2 $LIBDIR/wireplumber-0.5"
DOCKER="/usr/bin/dockerd /usr/bin/docker /usr/bin/containerd /usr/bin/containerd-shim-runc-v2 /usr/bin/runc"
DOCKER_PLUGINS=/usr/libexec/docker/cli-plugins
DATA="/usr/lib/udev/hwdb.bin /usr/share/pipewire /usr/share/wireplumber /usr/share/alsa /usr/share/alsa-card-profile /usr/lib/udev/rules.d /etc/fonts /usr/share/fonts/opentype/inter/Inter-Regular.otf /etc/ssl/certs/ca-certificates.crt"
WLR_PROTOCOLS_URL=https://gitlab.freedesktop.org/wlroots/wlr-protocols/-/raw/master/unstable
WLR_PROTOCOLS="wlr-layer-shell-unstable-v1 wlr-foreign-toplevel-management-unstable-v1 wlr-screencopy-unstable-v1"
PROTOCOLS=$(pkg-config --variable=pkgdatadir wayland-protocols)
CFLAGS="-O2 -Wall -Wextra -Werror -I/tmp"
. /src/config
. /src/guest/config

make_skeleton() {
  mkdir -p $ROOTFS/etc $ROOTFS/proc $ROOTFS/sys $ROOTFS/dev $ROOTFS/run $ROOTFS/tmp \
    $ROOTFS/mnt $ROOTFS/data $ROOTFS/boot/efi $ROOTFS/usr/share/terminfo/l $ROOTFS/usr/lib $ROOTFS/var/lib \
    $ROOTFS/www/cgi-bin $ROOTFS/opt $ROOTFS/usr/share/anyconsole $ROOTFS/etc/docker $ROOTFS/etc/pipewire/pipewire.conf.d $ROOTFS/etc/wireplumber/wireplumber.conf.d
  ln -s /run $ROOTFS/var/run
}

fetch() { curl -fsSL -R -z "$DOWNLOAD_CACHE/$1" -o "$DOWNLOAD_CACHE/$1" "$2" || [ -f "$DOWNLOAD_CACHE/$1" ]; }

write_shared_header() {
  for name in $SHARED_WITH_C; do
    eval "value=\$$name"
    printf '#define %s "%s"\n' "$name" "$value"
  done > /tmp/anyconsole.h
}

vulkan_drivers() { find $VULKAN_DRIVERS -name '*.json' ! -name $SOFTWARE_VULKAN_DRIVER; }

dlopened() {
  { jq -r .ICD.library_path $EGL_VENDORS/*.json $(vulkan_drivers)
    readelf -n --wide $UDEV | sed -n 's/^.*Dlopen Metadata: //p' | jq -r '.[].soname[]'
  } | sort -u | while read -r library; do [ ! -e "$LIBDIR/$library" ] || echo "$LIBDIR/$library"; done
}

build_padd() { gcc $CFLAGS -o /bin/padd /src/guest/padd.c $(sdl2-config --cflags --libs) $(pkg-config --cflags --libs libevdev); }

generate_protocol() {
  wayland-scanner client-header "$1" "/tmp/$(basename "$1" .xml).h"
  wayland-scanner private-code "$1" "/tmp/$(basename "$1" .xml).c"
}

fetch_wlr_protocols() {
  for name in $WLR_PROTOCOLS; do fetch "$name.xml" "$WLR_PROTOCOLS_URL/$name.xml"; done
}

build_splash() {
  generate_protocol "$PROTOCOLS/stable/xdg-shell/xdg-shell.xml"
  gcc $CFLAGS -o /bin/splash /src/guest/splash.c /tmp/xdg-shell.c \
    $(pkg-config --cflags --libs libdrm libpng pixman-1 wayland-client) -lm
  rsvg-convert -o $ROOTFS/usr/share/anyconsole/splash.png /src/guest/splash.svg
}

build_overlay() {
  generate_protocol "$DOWNLOAD_CACHE/wlr-layer-shell-unstable-v1.xml"
  generate_protocol "$DOWNLOAD_CACHE/wlr-foreign-toplevel-management-unstable-v1.xml"
  generate_protocol "$PROTOCOLS/staging/security-context/security-context-v1.xml"
  generate_protocol "$DOWNLOAD_CACHE/wlr-screencopy-unstable-v1.xml"
  gcc $CFLAGS -o /bin/overlay /src/guest/overlay.c /tmp/wlr-layer-shell-unstable-v1.c /tmp/wlr-foreign-toplevel-management-unstable-v1.c \
    /tmp/security-context-v1.c /tmp/wlr-screencopy-unstable-v1.c /tmp/xdg-shell.c $(pkg-config --cflags --libs cairo pixman-1 json-c libevdev wayland-client) -lm
}

build_compositor() {
  for protocol in "$PROTOCOLS/stable/xdg-shell/xdg-shell.xml" "$PROTOCOLS/unstable/pointer-constraints/pointer-constraints-unstable-v1.xml" \
    "$DOWNLOAD_CACHE/wlr-layer-shell-unstable-v1.xml" "$DOWNLOAD_CACHE/wlr-foreign-toplevel-management-unstable-v1.xml"; do
    wayland-scanner server-header "$protocol" "/tmp/$(basename "$protocol" .xml)-protocol.h"
  done
  gcc $CFLAGS -DWLR_USE_UNSTABLE -o /bin/compositor /src/guest/compositor.c \
    $(pkg-config --cflags --libs wlroots-0.18 wayland-server xkbcommon libdrm json-c vulkan egl glesv2) -lm
}

copy_binaries() {
  dlopened=$(dlopened)
  lddtree --copy-to-tree $ROOTFS --bindir /bin --libdir /lib $BINARIES $GBM_BACKEND $dlopened $AUDIO $DOCKER
  lddtree --copy-to-tree $ROOTFS --libdir /lib $(find $AUDIO_PLUGINS -name '*.so')
  ln -s udevadm $ROOTFS/bin/systemd-udevd
  cp -a --parents $DATA $DOCKER_PLUGINS $ROOTFS/
  mkdir -p $ROOTFS$EGL_VENDORS $ROOTFS$VULKAN_DRIVERS $ROOTFS/usr/share/X11 $ROOTFS$LIBDIR/gbm
  for library in $dlopened; do mv "$ROOTFS/bin/${library##*/}" $ROOTFS/lib/; done
  mv $ROOTFS/bin/dri_gbm.so $ROOTFS$LIBDIR/gbm/
  cp $EGL_VENDORS/*.json $ROOTFS$EGL_VENDORS/
  cp $(vulkan_drivers) $ROOTFS$VULKAN_DRIVERS/
  cp -a /usr/share/X11/xkb $ROOTFS/usr/share/X11/
  cp -a /usr/share/libinput $ROOTFS/usr/share/
  mkdir -p $ROOTFS$LIBDIR/gconv
  cp $LIBDIR/gconv/IBM850.so $LIBDIR/gconv/gconv-modules.cache $ROOTFS$LIBDIR/gconv/
}

install_busybox() {
  busybox --install -s $ROOTFS/bin
  ln -s bin $ROOTFS/sbin
  ln -s ../bin $ROOTFS/usr/bin
  ln -s ../bin $ROOTFS/usr/sbin
  ln -s lib $ROOTFS/lib64
  ln -s /data/root $ROOTFS/root
}

configure_network() {
  ln -s /data/dhcpcd $ROOTFS/var/lib/dhcpcd
  cp -a /usr/lib/dhcpcd $ROOTFS/usr/lib/
  cp /etc/dhcpcd.conf $ROOTFS/etc/
}

configure_users() {
  ln -s /data/dropbear $ROOTFS/etc/dropbear
  printf 'root:x:0:0:root:/root:/bin/sh\ndhcpcd:x:100:65534::/:/bin/false\n' > $ROOTFS/etc/passwd
  printf 'root:%s:::::::\n' "$(busybox mkpasswd -m sha512 "$CONSOLE_PASSWORD")" > $ROOTFS/etc/shadow
  chmod 600 $ROOTFS/etc/shadow
  printf 'root:x:0:\nnogroup:x:65534:\n' > $ROOTFS/etc/group
}

configure_locale() {
  cp /usr/share/terminfo/l/linux $ROOTFS/usr/share/terminfo/l/
  printf 'export LANG=C.UTF-8\nexport TERM=linux\nexport PATH=/bin:/opt/anyconsole\nexport HOME=/root\nexport XDG_RUNTIME_DIR=/run/user\n' > $ROOTFS/etc/profile
}

install_system() {
  cp /src/guest/rc /src/guest/inittab $ROOTFS/etc/
  cp /src/guest/config $ROOTFS/etc/anyconsole.conf
  cp /src/guest/otad /src/guest/installer /src/guest/mkdisk /src/guest/games /src/guest/settings $ROOTFS/bin/
  cp /src/guest/daemon.json $ROOTFS/etc/docker/
  cp /src/guest/pipewire.conf $ROOTFS/etc/pipewire/pipewire.conf.d/anyconsole.conf
  cp /src/guest/wireplumber.conf $ROOTFS/etc/wireplumber/wireplumber.conf.d/anyconsole.conf
  cp /src/guest/api $ROOTFS/www/cgi-bin/
  printf 'VERSION=%s\n' "$VERSION" > $ROOTFS/etc/anyconsole-release
}

install_app() { cp -a /src/app $ROOTFS/opt/anyconsole; }

finalize() {
  chmod +x $ROOTFS/etc/rc $ROOTFS/bin/otad $ROOTFS/bin/installer $ROOTFS/bin/mkdisk $ROOTFS/bin/games $ROOTFS/bin/settings $ROOTFS/www/cgi-bin/api
  cp -a /src/build/out/stage/. $ROOTFS/
  mknod $ROOTFS/dev/console c 5 1
  mknod $ROOTFS/dev/null c 1 3
}

make_skeleton
write_shared_header
fetch_wlr_protocols
build_padd
build_splash
build_overlay
build_compositor
copy_binaries
install_busybox
configure_network
configure_users
configure_locale
install_system
install_app
finalize
