#!/bin/sh
set -eux

ROOTFS=/rootfs
LIBDIR=/usr/lib/x86_64-linux-gnu
BINARIES="/bin/busybox /bin/padd /bin/splash /sbin/sfdisk /sbin/mke2fs /sbin/mkfs.fat /usr/bin/btop /usr/bin/rsync /usr/bin/grub-editenv /usr/bin/flock /usr/sbin/dropbear /usr/sbin/dhcpcd"
RETROARCH_URL=https://buildbot.libretro.com/stable/1.22.2/linux/x86_64/RetroArch.7z
RETROARCH_DIR=/tmp/retroarch
SEAT="/usr/bin/cage $RETROARCH_DIR/squashfs-root/usr/bin/retroarch $LIBDIR/gbm/dri_gbm.so $LIBDIR/libEGL_mesa.so.0"
CORE_URL=https://buildbot.libretro.com/nightly/linux/x86_64/latest/fceumm_libretro.so.zip
ROM_URL=https://shiru.untergrund.net/files/nes/alter_ego.zip
PAD_PROFILE_URL='https://raw.githubusercontent.com/libretro/retroarch-joypad-autoconfig/master/linuxraw/Sony%20Interactive%20Entertainment%20DualSense%20Wireless%20Controller.cfg'
CFLAGS="-O2 -Wall -Wextra -Werror"
. /src/config

make_skeleton() {
  mkdir -p $ROOTFS/etc $ROOTFS/proc $ROOTFS/sys $ROOTFS/dev $ROOTFS/run $ROOTFS/tmp \
    $ROOTFS/mnt $ROOTFS/data $ROOTFS/boot/efi $ROOTFS/usr/share/terminfo/l $ROOTFS/usr/lib $ROOTFS/var/lib \
    $ROOTFS/www/cgi-bin $ROOTFS/opt $ROOTFS/usr/share/anyconsole
}

fetch() { curl -fsSL -R -z "$DOWNLOAD_CACHE/$1" -o "$DOWNLOAD_CACHE/$1" "$2" || [ -f "$DOWNLOAD_CACHE/$1" ]; }

fetch_retroarch() {
  fetch retroarch.7z "$RETROARCH_URL"
  7z e -o$RETROARCH_DIR "$DOWNLOAD_CACHE/retroarch.7z" RetroArch-Linux-x86_64/RetroArch-Linux-x86_64.AppImage >/dev/null
  chmod +x $RETROARCH_DIR/RetroArch-Linux-x86_64.AppImage
  (cd $RETROARCH_DIR && ./RetroArch-Linux-x86_64.AppImage --appimage-extract >/dev/null)
  for bundled in $RETROARCH_DIR/squashfs-root/usr/lib/*; do
    ! [ -e "$LIBDIR/${bundled##*/}" ] || rm "$bundled"
  done
}

build_padd() { gcc $CFLAGS -o /bin/padd /src/guest/padd.c $(sdl2-config --cflags --libs); }

build_splash() {
  xdg_shell=$(pkg-config --variable=pkgdatadir wayland-protocols)/stable/xdg-shell/xdg-shell.xml
  wayland-scanner client-header "$xdg_shell" /tmp/xdg-shell.h
  wayland-scanner private-code "$xdg_shell" /tmp/xdg-shell.c
  gcc $CFLAGS -I/tmp -o /bin/splash /src/guest/splash.c /tmp/xdg-shell.c \
    $(pkg-config --cflags --libs libdrm libpng pixman-1 wayland-client) -lm
  rsvg-convert -o $ROOTFS/usr/share/anyconsole/splash.png /src/guest/splash.svg
}

copy_binaries() {
  lddtree --copy-to-tree $ROOTFS --bindir /bin --libdir /lib $BINARIES $SEAT
  mkdir -p $ROOTFS/usr/share/glvnd/egl_vendor.d $ROOTFS/usr/share/X11 $ROOTFS$LIBDIR/gbm
  mv $ROOTFS/bin/libEGL_mesa.so.0 $ROOTFS/lib/
  mv $ROOTFS/bin/dri_gbm.so $ROOTFS$LIBDIR/gbm/
  cp /usr/share/glvnd/egl_vendor.d/50_mesa.json $ROOTFS/usr/share/glvnd/egl_vendor.d/
  cp -a /usr/share/X11/xkb $ROOTFS/usr/share/X11/
  cp -a /usr/share/libinput $ROOTFS/usr/share/
  mkdir -p $ROOTFS$LIBDIR/gconv
  cp $LIBDIR/gconv/IBM850.so $LIBDIR/gconv/gconv-modules.cache $ROOTFS$LIBDIR/gconv/
}

install_busybox() {
  busybox --install -s $ROOTFS/bin
  ln -s bin $ROOTFS/sbin
  ln -s ../bin $ROOTFS/usr/bin
  ln -s ../bin $ROOTFS/usr/sbin
  ln -s lib $ROOTFS/lib64
  ln -s /data/root $ROOTFS/root
}

configure_network() {
  ln -s /data/dhcpcd $ROOTFS/var/lib/dhcpcd
  cp -a /usr/lib/dhcpcd $ROOTFS/usr/lib/
  cp /etc/dhcpcd.conf $ROOTFS/etc/
}

configure_users() {
  ln -s /data/dropbear $ROOTFS/etc/dropbear
  printf 'root:x:0:0:root:/root:/bin/sh\ndhcpcd:x:100:65534::/:/bin/false\n' > $ROOTFS/etc/passwd
  printf 'root:%s:::::::\n' "$(busybox mkpasswd -m sha512 "$CONSOLE_PASSWORD")" > $ROOTFS/etc/shadow
  chmod 600 $ROOTFS/etc/shadow
  printf 'root:x:0:\nnogroup:x:65534:\n' > $ROOTFS/etc/group
}

configure_locale() {
  cp /usr/share/terminfo/l/linux $ROOTFS/usr/share/terminfo/l/
  printf 'export LANG=C.UTF-8\nexport TERM=linux\nexport PATH=/bin:/opt/anyconsole\n' > $ROOTFS/etc/profile
}

install_system() {
  cp /src/guest/rc /src/guest/inittab $ROOTFS/etc/
  cp /src/guest/config $ROOTFS/etc/anyconsole.conf
  cp /src/guest/otad /src/guest/installer /src/guest/mkdisk $ROOTFS/bin/
  cp /src/guest/api $ROOTFS/www/cgi-bin/
  printf 'VERSION=%s\n' "$VERSION" > $ROOTFS/etc/anyconsole-release
}

install_app() {
  cp -a /src/app $ROOTFS/opt/anyconsole
  mkdir -p $ROOTFS/opt/anyconsole/cores $ROOTFS/opt/anyconsole/games
  fetch core.zip "$CORE_URL"
  7z x -y -o$ROOTFS/opt/anyconsole/cores "$DOWNLOAD_CACHE/core.zip" >/dev/null
  fetch rom.zip "$ROM_URL"
  7z x -y -o/tmp/rom "$DOWNLOAD_CACHE/rom.zip" >/dev/null
  cp "$(find /tmp/rom -iname '*.nes' | head -1)" $ROOTFS/opt/anyconsole/games/alter_ego.nes
  fetch pad-profile.cfg "$PAD_PROFILE_URL"
  install -D "$DOWNLOAD_CACHE/pad-profile.cfg" -t $ROOTFS/opt/anyconsole/autoconfig/linuxraw
}

finalize() {
  chmod +x $ROOTFS/etc/rc $ROOTFS/bin/otad $ROOTFS/bin/installer $ROOTFS/bin/mkdisk $ROOTFS/www/cgi-bin/api
  cp -a /src/build/out/stage/. $ROOTFS/
  mknod $ROOTFS/dev/console c 5 1
  mknod $ROOTFS/dev/null c 1 3
}

make_skeleton
fetch_retroarch
build_padd
build_splash
copy_binaries
install_busybox
configure_network
configure_users
configure_locale
install_system
install_app
finalize
