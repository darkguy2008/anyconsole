#!/bin/sh
set -eux
. /src/config
. /src/guest/config

ROOTFS=/rootfs
LIBDIR=/usr/lib64
BINARIES="/usr/bin/wayland-info /usr/bin/grim /usr/bin/socat /usr/bin/busybox /usr/bin/mountpoint /usr/bin/modprobe /bin/padd /bin/splash /bin/overlay /bin/compositor /usr/bin/sfdisk /usr/bin/mke2fs /usr/bin/mkfs.fat /usr/bin/btop /usr/bin/rsync /usr/bin/grub2-editenv /usr/bin/flock /usr/bin/nsenter /usr/bin/dropbear /usr/bin/dhcpcd /usr/bin/udevadm /usr/bin/mount.cifs /usr/bin/jq /usr/bin/curl /usr/libexec/bluetooth/bluetoothd /usr/bin/dbus-daemon /usr/bin/seatd"
GBM_BACKEND=$LIBDIR/gbm/dri_gbm.so
EGL_VENDORS=/usr/share/glvnd/egl_vendor.d
VULKAN_DRIVERS=/usr/share/vulkan/icd.d
SOFTWARE_VULKAN_DRIVER=lvp_icd
AUDIO="/usr/bin/pipewire /usr/bin/pipewire-pulse /usr/bin/wireplumber /usr/bin/wpctl /usr/bin/pw-dump /usr/bin/pw-cli"
AUDIO_PLUGINS="$LIBDIR/pipewire-0.3 $LIBDIR/spa-0.2 $LIBDIR/wireplumber-0.5"
DOCKER="/usr/bin/dockerd /usr/bin/docker /usr/bin/containerd /usr/bin/containerd-shim-runc-v2 /usr/bin/runc /usr/libexec/docker/docker-init"
BUS_CONFIG=/usr/share/dbus-1/system.conf
DATA="$ZONEINFO_DIR /usr/lib/udev/hwdb.bin /usr/share/pipewire /usr/share/spa-0.2 /usr/share/wireplumber /usr/share/alsa /usr/share/alsa-card-profile /usr/lib/udev/rules.d $(pkg-config --variable=xkb_root xkbcommon) $CA_BUNDLE $BUS_CONFIG /usr/share/dbus-1/system.d/bluetooth.conf"
WLR_PROTOCOLS_URL=https://gitlab.freedesktop.org/wlroots/wlr-protocols/-/raw/master/unstable
WLR_PROTOCOLS="wlr-layer-shell-unstable-v1 wlr-foreign-toplevel-management-unstable-v1"
PROTOCOLS=$(pkg-config --variable=pkgdatadir wayland-protocols)
BACKGROUND_EFFECT=$PROTOCOLS/staging/ext-background-effect/ext-background-effect-v1.xml
CFLAGS="-O2 -Wall -Wextra -Werror -I/tmp"
GLES_SHADER="--es --version 300 --glsl-emit-ubo-as-plain-uniforms"
RETRO_SEMANTICS="MVP OutputSize SourceSize OriginalSize FrameCount Rotation"
SYSTEM_LOCALES=/usr/lib/locale
MESSAGES_TEMPLATE=/tmp/$TEXT_DOMAIN.pot

make_skeleton() {
  mkdir -p $ROOTFS/etc $ROOTFS/proc $ROOTFS/sys $ROOTFS/dev $ROOTFS/run $ROOTFS/tmp \
    $ROOTFS/mnt $ROOTFS/data $ROOTFS/boot/efi $ROOTFS/usr/share/terminfo/l $ROOTFS/usr/lib $ROOTFS/lib $ROOTFS/var/lib \
    $ROOTFS/www/cgi-bin $ROOTFS/opt $ROOTFS/usr/share/anyconsole $ROOTFS/etc/docker $ROOTFS/etc/bluetooth $ROOTFS/etc/pipewire/pipewire.conf.d $ROOTFS/etc/wireplumber/wireplumber.conf.d $ROOTFS/usr/local/share/wireplumber/scripts/device $ROOTFS/usr/local/share/wireplumber/scripts/default-nodes $ROOTFS/etc/modprobe.d
  ln -s /run $ROOTFS/var/run
  ln -s ../lib $ROOTFS$LIBDIR
}

write_shared_header() {
  {
    for name in $SHARED_WITH_C; do
      eval "value=\$$name"
      printf '#define %s "%s"\n' "$name" "$value"
    done
    for name in $NUMBERS_SHARED_WITH_C; do
      eval "value=\$$name"
      printf '#define %s %s\n' "$name" "$value"
    done
  } > /tmp/anyconsole.h
}

vulkan_drivers() { find $VULKAN_DRIVERS -name '*.json' ! -name "$SOFTWARE_VULKAN_DRIVER.*"; }

installed() {
  while read -r library; do
    case $library in /*) ;; *) library=$LIBDIR/$library ;; esac
    [ ! -e "$library" ] || echo "$library"
  done | sort -u
}

dlopened() {
  found=$(jq -r .ICD.library_path $EGL_VENDORS/*.json $(vulkan_drivers) | installed)
  until
    previous=$found
    found=$({ echo "$previous"; /src/build/dlopen-requests $(lddtree -l $BINARIES $GBM_BACKEND $AUDIO $DOCKER $previous); } | installed)
    [ "$found" = "$previous" ]
  do :; done
  echo "$found"
}

build_padd() { gcc $CFLAGS -o /bin/padd /src/guest/padd.c $(sdl2-config --cflags --libs) $(pkg-config --cflags --libs libevdev libsystemd libudev json-c opus zlib) -lm; }

generate_protocol() {
  wayland-scanner client-header "$1" "/tmp/$(basename "$1" .xml).h"
  wayland-scanner private-code "$1" "/tmp/$(basename "$1" .xml).c"
}

fetch_wlr_protocols() {
  for name in $WLR_PROTOCOLS; do fetch "$DOWNLOAD_CACHE" "$name.xml" "$WLR_PROTOCOLS_URL/$name.xml"; done
}

build_splash() {
  generate_protocol "$PROTOCOLS/stable/xdg-shell/xdg-shell.xml"
  gcc $CFLAGS -o /bin/splash /src/guest/splash.c /tmp/xdg-shell.c \
    $(pkg-config --cflags --libs libdrm libpng pixman-1 wayland-client) -lm
  rsvg-convert -o $ROOTFS$SPLASH_IMAGE /src/guest/splash.svg
}

build_overlay() {
  generate_protocol "$DOWNLOAD_CACHE/wlr-layer-shell-unstable-v1.xml"
  generate_protocol "$DOWNLOAD_CACHE/wlr-foreign-toplevel-management-unstable-v1.xml"
  generate_protocol "$PROTOCOLS/staging/security-context/security-context-v1.xml"
  generate_protocol "$PROTOCOLS/staging/ext-foreign-toplevel-list/ext-foreign-toplevel-list-v1.xml"
  generate_protocol "$PROTOCOLS/staging/ext-image-capture-source/ext-image-capture-source-v1.xml"
  generate_protocol "$PROTOCOLS/staging/ext-image-copy-capture/ext-image-copy-capture-v1.xml"
  generate_protocol "$PROTOCOLS/stable/linux-dmabuf/linux-dmabuf-v1.xml"
  generate_protocol "$BACKGROUND_EFFECT"
  gcc $CFLAGS -o /bin/overlay /src/guest/overlay.c /src/guest/scene.c /src/guest/script.c /src/guest/sound.c /src/guest/shader.c \
    /tmp/wlr-layer-shell-unstable-v1.c /tmp/wlr-foreign-toplevel-management-unstable-v1.c /tmp/security-context-v1.c /tmp/ext-foreign-toplevel-list-v1.c \
    /tmp/ext-image-capture-source-v1.c /tmp/ext-image-copy-capture-v1.c /tmp/linux-dmabuf-v1.c /tmp/xdg-shell.c /tmp/ext-background-effect-v1.c /usr/local/lib/libquickjs.a /usr/local/lib/libyogacore.a \
    $(pkg-config --cflags --libs cairo libpng pixman-1 json-c wayland-client wayland-egl egl glesv2 gbm libdrm freetype2 harfbuzz opusfile libpipewire-0.3 libturbojpeg) \
    -lstdc++ -lm -pthread
}

build_compositor() {
  for protocol in "$PROTOCOLS/stable/xdg-shell/xdg-shell.xml" "$PROTOCOLS/unstable/pointer-constraints/pointer-constraints-unstable-v1.xml" \
    "$DOWNLOAD_CACHE/wlr-layer-shell-unstable-v1.xml" "$DOWNLOAD_CACHE/wlr-foreign-toplevel-management-unstable-v1.xml" \
    "$PROTOCOLS/staging/ext-image-capture-source/ext-image-capture-source-v1.xml" "$PROTOCOLS/staging/ext-image-copy-capture/ext-image-copy-capture-v1.xml" \
    "$BACKGROUND_EFFECT"; do
    wayland-scanner server-header "$protocol" "/tmp/$(basename "$protocol" .xml)-protocol.h"
  done
  gcc $CFLAGS -DWLR_USE_UNSTABLE -o /bin/compositor /src/guest/compositor.c /src/guest/shader.c /tmp/ext-image-capture-source-v1.c /tmp/ext-foreign-toplevel-list-v1.c /tmp/ext-background-effect-v1.c \
    $(pkg-config --cflags --libs wlroots-0.19 pixman-1 wayland-server xkbcommon libdrm json-c vulkan egl glesv2 libpng) -lm
}

copy_binaries() {
  dlopened=$(dlopened)
  lddtree --copy-to-tree $ROOTFS --bindir /bin --libdir /lib $BINARIES $GBM_BACKEND $dlopened $AUDIO $DOCKER
  lddtree --copy-to-tree $ROOTFS --libdir /lib $(find $AUDIO_PLUGINS -name '*.so')
  ln -s udevadm $ROOTFS/bin/systemd-udevd
  cp -aL --parents $DATA $ROOTFS/
  mkdir -p $ROOTFS$EGL_VENDORS $ROOTFS$VULKAN_DRIVERS $ROOTFS$LIBDIR/gbm
  for library in $dlopened; do mv "$ROOTFS/bin/${library##*/}" $ROOTFS/lib/; done
  mv $ROOTFS/bin/dri_gbm.so $ROOTFS$LIBDIR/gbm/
  cp $EGL_VENDORS/*.json $ROOTFS$EGL_VENDORS/
  cp $(vulkan_drivers) $ROOTFS$VULKAN_DRIVERS/
  cp -a /usr/share/libinput $ROOTFS/usr/share/
  mkdir -p $ROOTFS$LIBDIR/gconv
  cp $LIBDIR/gconv/IBM850.so $LIBDIR/gconv/gconv-modules.cache $ROOTFS$LIBDIR/gconv/
}

install_busybox() {
  /usr/bin/busybox --install -s $ROOTFS/bin
  ln -s bin $ROOTFS/sbin
  ln -s ../bin $ROOTFS/usr/bin
  ln -s ../bin $ROOTFS/usr/sbin
  ln -s lib $ROOTFS/lib64
  ln -s /data/root $ROOTFS/root
}

configure_network() {
  ln -s /data/dhcpcd $ROOTFS/var/lib/dhcpcd
  ln -s /data/bluetooth $ROOTFS/var/lib/bluetooth
  cp -a --parents /usr/libexec/dhcpcd-run-hooks /usr/libexec/dhcpcd-hooks $ROOTFS/
  cp /etc/dhcpcd.conf /src/guest/dhcpcd.exit-hook $ROOTFS/etc/
}

configure_users() {
  bus_user=$(xmllint --xpath 'string(/busconfig/user)' $BUS_CONFIG)
  ln -s /data/dropbear $ROOTFS/etc/dropbear
  printf 'root:x:0:0:root:/root:/bin/sh\ndhcpcd:x:100:65534::/:/bin/false\n%s:x:101:101::/:/bin/false\n' "$bus_user" > $ROOTFS/etc/passwd
  printf 'root:%s:::::::\n' "$(busybox mkpasswd -m sha512 "$CONSOLE_PASSWORD")" > $ROOTFS/etc/shadow
  chmod 600 $ROOTFS/etc/shadow
  printf 'root:x:0:\n%s:x:101:\nnogroup:x:65534:\n' "$bus_user" > $ROOTFS/etc/group
}

configure_locale() {
  cp /usr/share/terminfo/l/linux $ROOTFS/usr/share/terminfo/l/
  printf 'export LANG=C.UTF-8\nexport TERM=linux\nexport PATH=/bin:/opt/anyconsole\nexport HOME=/root\nexport XDG_RUNTIME_DIR=/run/user\n' > $ROOTFS/etc/profile
  cp -a --parents $SYSTEM_LOCALES/$MESSAGES_LOCALE/LC_MESSAGES $ROOTFS/
}

extract_messages() {
  xgettext -o $MESSAGES_TEMPLATE --from-code=UTF-8 -L C -k_ -kN_ /src/guest/overlay.c /src/guest/padd.c
  xgettext -j -o $MESSAGES_TEMPLATE -L Shell -kstep -kprogress /src/guest/games
  xgettext -j -o $MESSAGES_TEMPLATE --from-code=UTF-8 -L JavaScript -ktranslate /src/app/skins/*/*.js
}

install_translations() {
  extract_messages
  for catalog in /src/guest/locale/*.po; do
    language=$(basename "$catalog" .po)
    msgcmp "$catalog" $MESSAGES_TEMPLATE
    mkdir -p "$ROOTFS$LOCALE_DIR/$language/LC_MESSAGES"
    msgfmt -c -o "$ROOTFS$LOCALE_DIR/$language/LC_MESSAGES/$TEXT_DOMAIN.mo" "$catalog"
  done
}

install_system() {
  cp /src/guest/rc /src/guest/inittab $ROOTFS/etc/
  cp /src/guest/config $ROOTFS/etc/anyconsole.conf
  cp /src/guest/otad /src/guest/installer /src/guest/mkdisk /src/guest/games /src/guest/thumbnails /src/guest/settings $ROOTFS/bin/
  cp /src/guest/daemon.json $ROOTFS/etc/docker/
  cp /src/guest/oci $ROOTFS/usr/share/anyconsole/
  cp /src/guest/bluez-input.conf $ROOTFS/etc/bluetooth/input.conf
  cp /src/guest/gamecontrollerdb.txt "$ROOTFS$CONTROLLER_MAPPINGS"
  sed "s/@KERNEL_ARGS@/$KERNEL_ARGS/" /src/guest/grub.cfg > "$ROOTFS$GRUB_CONFIG"
  grub2-editenv $ROOTFS/boot/kernel.env create
  grub2-editenv $ROOTFS/boot/kernel.env set extra="$KERNEL_ARGS"
  sed -e "s/@MICROPHONE_NODE@/$MICROPHONE_NODE/g" -e "s/@BLOW_NODE@/$BLOW_NODE/g" /src/guest/pipewire.conf > $ROOTFS/etc/pipewire/pipewire.conf.d/anyconsole.conf
  cp /src/guest/wireplumber.conf $ROOTFS/etc/wireplumber/wireplumber.conf.d/anyconsole.conf
  cp /src/guest/find-detected-profile.lua $ROOTFS/usr/local/share/wireplumber/scripts/device/
  cp /src/guest/find-real-default-source.lua $ROOTFS/usr/local/share/wireplumber/scripts/default-nodes/
  printf 'blacklist snd_pcsp\n' > $ROOTFS/etc/modprobe.d/anyconsole.conf
  cp /src/guest/api $ROOTFS/www/cgi-bin/
  printf 'VERSION=%s\nENGINE_CONTRACT=%s\n' "$VERSION" "$(engine_contract /src)" > $ROOTFS/etc/anyconsole-release
}

hide_input_from_compositor() {
  mkdir -p "$ROOTFS${INPUT_RULES%/*}"
  printf 'SUBSYSTEM=="input", KERNEL=="event*", ENV{LIBINPUT_IGNORE_DEVICE}="1"\nSUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="%s", ENV{LIBINPUT_IGNORE_DEVICE}=""\n' \
    "$KEYBOARD_NAME" > "$ROOTFS$INPUT_RULES"
}

install_app() { rsync -a --exclude /recipes /src/app/ $ROOTFS/opt/anyconsole/; }

install_assets() {
  list=$1 folder=$2
  while read -r file source checksum; do
    [ -f "$DOWNLOAD_CACHE/$checksum" ] || fetch "$DOWNLOAD_CACHE" "$checksum" "$source"
    echo "$checksum  $DOWNLOAD_CACHE/$checksum" | sha256sum -c --quiet
    install -D -m 644 "$DOWNLOAD_CACHE/$checksum" "$folder/$file"
  done < "$list"
}

install_skin_assets() {
  for list in /src/app/skins/*/assets; do install_assets "$list" "$ROOTFS$SKINS_DIR/$(basename "$(dirname "$list")")"; done
}

slang_expand() {
  awk 'function expand(path,  folder, line, included, status) {
    folder = path
    sub(/[^\/]*$/, "", folder)
    while ((status = (getline line < path)) > 0) {
      if (line ~ /^#include "[^"]*"$/) {
        included = line
        gsub(/^#include "|"$/, "", included)
        expand(folder included)
      } else if (line ~ /^#pragma / && line !~ /^#pragma (stage|parameter|name) /) {
        print "unsupported in " path ": " line > "/dev/stderr"
        exit 1
      } else if (line !~ /^#pragma name /) print line
    }
    if (status < 0) {
      print "cannot read " path > "/dev/stderr"
      exit 1
    }
    close(path)
  }
  BEGIN { expand(ARGV[1]); exit }' "$1"
}

slang_stage() { awk -v wanted="$1" '/^#pragma stage /{stage = $3; next} stage == "" || stage == wanted' "$2"; }

slang_parameters() { awk -F '"' '/^#pragma parameter /{split($1, words, " "); split($3, numbers, " "); print words[3], numbers[1]}' "$1"; }

preset_pairs() {
  awk 'function read(path,  folder, line, status, referenced, key, separator) {
    folder = path
    sub(/[^\/]*$/, "", folder)
    while ((status = (getline line < path)) > 0) {
      if (line ~ /^#reference "[^"]*"$/) {
        referenced = line
        gsub(/^#reference "|"$/, "", referenced)
        read(folder referenced)
      } else if (line !~ /^[ \t]*(#|$)/) {
        separator = index(line, "=")
        if (!separator) {
          print "unparsed line in " path ": " line > "/dev/stderr"
          exit 1
        }
        key = substr(line, 1, separator - 1)
        gsub(/^[ \t]+|[ \t]+$/, "", key)
        value[key] = substr(line, separator + 1)
        gsub(/^[ \t]+|[ \t]+$|"/, "", value[key])
        folder_of[key] = folder
      }
    }
    if (status < 0) {
      print "cannot read " path > "/dev/stderr"
      exit 1
    }
    close(path)
  }
  BEGIN {
    read(ARGV[1])
    if ("textures" in value) split(value["textures"], names, ";")
    for (n in names) texture[names[n]]
    for (key in value) print key, (key ~ /^shader[0-9]+$/ || key in texture) ? folder_of[key] value[key] : value[key]
    exit
  }' "$1"
}

preset_values() { awk 'NR == FNR { value[$1] = $2; next } { print $1, ($1 in value) ? value[$1] : $2 }' "$1" -; }

preset_passes() {
  awk -v unread="$2" -v textures="$3" '
  function pick(key, fallback) { asked[key]; return (key in value) ? value[key] : fallback }
  function allowed(kind, choice, choices) {
    if (index(" " choices " ", " " choice " ")) return choice
    print "unsupported " kind " " choice > "/dev/stderr"
    exit 1
  }
  { value[$1] = $2 }
  END {
    shaders = pick("shaders", 0)
    for (pass = 0; pass < shaders; pass++) {
      type = pick("scale_type" pass, pass == shaders - 1 ? "viewport" : "source")
      scale = pick("scale" pass, 1)
      print pick("shader" pass, ""), allowed("scale_type", pick("scale_type_x" pass, type), "source viewport absolute"), pick("scale_x" pass, scale), allowed("scale_type", pick("scale_type_y" pass, type), "source viewport absolute"),
        pick("scale_y" pass, scale), (pick("filter_linear" pass, "false") == "true"), (pick("float_framebuffer" pass, "false") == "true"),
        pick("frame_count_mod" pass, 0)
    }
    count = split(pick("textures", ""), names, ";")
    for (n = 1; n <= count; n++)
      print names[n], pick(names[n], ""), (pick(names[n] "_linear", "false") == "true"), (pick(names[n] "_mipmap", "false") == "true"),
        allowed("wrap_mode", pick(names[n] "_wrap_mode", "clamp_to_border"), "clamp_to_border clamp_to_edge repeat mirrored_repeat") > textures
    for (key in value) if (!(key in asked)) print key > unread
  }' "$1"
}

reject_unread() {
  awk 'FILENAME == ARGV[1] { unread[$1]; next } { delete unread[$1] }
  END { for (key in unread) { print "unsupported preset key " key > "/dev/stderr"; failed = 1 }; exit failed }' "$@"
}

reject_samplers() {
  slang_stage fragment "$1" | awk -v source="$1" -v pass="$2" -v last="$3" 'function earlier(name, prefix, limit) { return name ~ ("^" prefix "[0-9]+$") && substr(name, length(prefix) + 1) + 0 < limit }
  FILENAME == ARGV[1] { texture[$1]; next }
  match($0, /uniform sampler2D [A-Za-z_][A-Za-z0-9_]*/) {
    split(substr($0, RSTART, RLENGTH), words)
    name = words[3]
    if (name == "Source" || name == "Original" || name in texture || earlier(name, "PassFeedback", last) || earlier(name, "PassOutput", pass)) next
    print "unsupported sampler " name " in " source > "/dev/stderr"
    failed = 1
  }
  END { exit failed }' "$4" -
}

reject_uniforms() {
  { slang_parameters "$1"; printf '%s\n' $RETRO_SEMANTICS; } | cut -d ' ' -f 1 > /tmp/known
  for stage in vert frag; do spirv-cross "/tmp/$2.$stage.spv" --reflect; done |
    jq -r '[(.ubos + .push_constants)[]?.type] as $blocks | .types[$blocks[]].members[].name' | sort -u | grep -vxF -f /tmp/known |
    awk -v source="$1" '{ print "unsupported uniform " $0 " in " source > "/dev/stderr"; failed = 1 } END { exit failed }'
}

install_textures() {
  while read -r name image _; do
    case $image in *.png) ;; *) echo "unsupported texture image $image" >&2; return 1 ;; esac
    install -m 644 "$image" "$1/$name.png"
  done < /tmp/textures
  cut -d ' ' -f 1,3- /tmp/textures > "$1/textures"
}

build_chain() {
  chain=$ROOTFS$SHADERS_DIR/$(basename "$1" .slangp)
  mkdir -p "$chain"
  preset_pairs "$1" > /tmp/preset
  : > /tmp/preset.unread
  : > /tmp/textures
  preset_passes /tmp/preset /tmp/preset.unread /tmp/textures > /tmp/passes
  cut -d ' ' -f 2- /tmp/passes > "$chain/passes"
  install_textures "$chain"
  last=$(($(wc -l < /tmp/passes) - 1))
  pass=0
  for shader in $(cut -d ' ' -f 1 /tmp/passes); do
    output=$chain/$pass
    slang_expand "$shader" > "/tmp/$pass.slang"
    reject_samplers "/tmp/$pass.slang" $pass $last "$chain/textures"
    slang_stage vertex "/tmp/$pass.slang" | glslang --stdin -V -S vert -o "/tmp/$pass.vert.spv"
    slang_stage fragment "/tmp/$pass.slang" | glslang --stdin -V -S frag -o "/tmp/$pass.frag.spv"
    reject_uniforms "/tmp/$pass.slang" $pass
    spirv-cross "/tmp/$pass.vert.spv" $GLES_SHADER --output "$output.vert"
    spirv-cross "/tmp/$pass.frag.spv" $GLES_SHADER --output "$output.frag"
    slang_parameters "/tmp/$pass.slang" | preset_values /tmp/preset > "$output.parameters"
    pass=$((pass + 1))
  done
  reject_unread /tmp/preset.unread "$chain"/*.parameters
}

build_shaders() {
  install_assets /src/guest/shaders/assets /tmp/shaders
  cp /src/guest/shaders/*.slangp /tmp/shaders/
  for preset in /tmp/shaders/*.slangp; do build_chain "$preset"; done
}

finalize() {
  chmod +x $ROOTFS/etc/rc $ROOTFS/bin/otad $ROOTFS/bin/installer $ROOTFS/bin/mkdisk $ROOTFS/bin/games $ROOTFS/bin/settings $ROOTFS/www/cgi-bin/api
  cp -a /src/build/out/stage/. $ROOTFS/
  mknod $ROOTFS/dev/console c 5 1
  mknod $ROOTFS/dev/null c 1 3
}

make_skeleton
write_shared_header
fetch_wlr_protocols
build_padd
build_splash
build_overlay
build_compositor
copy_binaries
install_busybox
configure_network
configure_users
configure_locale
install_translations
install_system
hide_input_from_compositor
install_app
install_skin_assets
build_shaders
finalize
