#!/bin/sh
set -eux

ROOTFS=/rootfs
LIBDIR=/usr/lib/x86_64-linux-gnu
BINARIES="/bin/busybox /usr/bin/btop /usr/bin/rsync /usr/bin/grub-editenv /usr/bin/flock /usr/sbin/dropbear /usr/sbin/dhcpcd"
SEAT="/usr/bin/cage /usr/bin/retroarch $LIBDIR/dri/swrast_dri.so $LIBDIR/dri/kms_swrast_dri.so $LIBDIR/dri/virtio_gpu_dri.so $LIBDIR/gbm/dri_gbm.so $LIBDIR/libEGL_mesa.so.0 $LIBDIR/libGLX_mesa.so.0"
CORE_URL=https://buildbot.libretro.com/nightly/linux/x86_64/latest/fceumm_libretro.so.zip
ROM_URL=https://shiru.untergrund.net/files/nes/alter_ego.zip
. /src/config

install_packages() {
  apt-get update
  apt-get install -y --no-install-recommends busybox btop ncurses-base rsync grub-common pax-utils dropbear-bin dhcpcd-base \
    cage retroarch libgl1 libgl1-mesa-dri mesa-libgallium libglx-mesa0 libegl-mesa0 libgles2 xkb-data curl ca-certificates unzip
}

make_skeleton() {
  mkdir -p $ROOTFS/etc $ROOTFS/proc $ROOTFS/sys $ROOTFS/dev $ROOTFS/run $ROOTFS/tmp \
    $ROOTFS/mnt $ROOTFS/data $ROOTFS/boot/efi $ROOTFS/usr/share/terminfo/l $ROOTFS/usr/lib $ROOTFS/var/lib \
    $ROOTFS/www/cgi-bin $ROOTFS/opt
}

copy_binaries() {
  lddtree --copy-to-tree $ROOTFS --bindir /bin --libdir /lib $BINARIES $SEAT
  mv $ROOTFS/bin/*_dri.so $ROOTFS/bin/dri_gbm.so $ROOTFS/bin/libEGL_mesa.so.0 $ROOTFS/bin/libGLX_mesa.so.0 $ROOTFS/lib/
  mkdir -p $ROOTFS/usr/share/glvnd/egl_vendor.d $ROOTFS/usr/share/X11
  cp /usr/share/glvnd/egl_vendor.d/50_mesa.json $ROOTFS/usr/share/glvnd/egl_vendor.d/
  cp -a /usr/share/X11/xkb $ROOTFS/usr/share/X11/
}

install_busybox() {
  busybox --install -s $ROOTFS/bin
  ln -s bin $ROOTFS/sbin
  ln -s ../bin $ROOTFS/usr/bin
  ln -s ../bin $ROOTFS/usr/sbin
  ln -s lib $ROOTFS/lib64
  ln -s /data/root $ROOTFS/root
}

configure_network() {
  ln -s /data/dhcpcd $ROOTFS/var/lib/dhcpcd
  cp -a /usr/lib/dhcpcd $ROOTFS/usr/lib/
  cp /etc/dhcpcd.conf $ROOTFS/etc/
}

configure_users() {
  ln -s /data/dropbear $ROOTFS/etc/dropbear
  printf 'root:x:0:0:root:/root:/bin/sh\ndhcpcd:x:100:65534::/:/bin/false\n' > $ROOTFS/etc/passwd
  printf 'root:%s:::::::\n' "$(busybox mkpasswd -m sha512 "$CONSOLE_PASSWORD")" > $ROOTFS/etc/shadow
  chmod 600 $ROOTFS/etc/shadow
  printf 'root:x:0:\nnogroup:x:65534:\n' > $ROOTFS/etc/group
}

configure_locale() {
  cp /usr/share/terminfo/l/linux $ROOTFS/usr/share/terminfo/l/
  printf 'export LANG=C.UTF-8\nexport TERM=linux\nexport PATH=/bin:/opt/anyconsole\n' > $ROOTFS/etc/profile
}

install_system() {
  cp /src/guest/rc /src/guest/inittab $ROOTFS/etc/
  cp /src/config $ROOTFS/etc/anyconsole.conf
  cp /src/guest/otad $ROOTFS/bin/
  cp /src/guest/api $ROOTFS/www/cgi-bin/
  printf 'VERSION=%s\n' "$VERSION" > $ROOTFS/etc/anyconsole-release
}

install_app() {
  cp -a /src/app $ROOTFS/opt/anyconsole
  mkdir -p $ROOTFS/opt/anyconsole/cores $ROOTFS/opt/anyconsole/games
  curl -fsSL "$CORE_URL" -o /tmp/core.zip
  unzip -o /tmp/core.zip -d $ROOTFS/opt/anyconsole/cores
  curl -fsSL "$ROM_URL" -o /tmp/rom.zip
  unzip -o /tmp/rom.zip -d /tmp/rom
  cp "$(find /tmp/rom -iname '*.nes' | head -1)" $ROOTFS/opt/anyconsole/games/alter_ego.nes
}

finalize() {
  chmod +x $ROOTFS/etc/rc $ROOTFS/bin/otad $ROOTFS/www/cgi-bin/api
  cp -a /src/build/out/stage/. $ROOTFS/
  mknod $ROOTFS/dev/console c 5 1
  mknod $ROOTFS/dev/null c 1 3
  tar -C $ROOTFS -czf /src/build/out/rootfs.tar.gz .
}

install_packages
make_skeleton
copy_binaries
install_busybox
configure_network
configure_users
configure_locale
install_system
install_app
finalize
