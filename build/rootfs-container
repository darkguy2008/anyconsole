#!/bin/sh
set -eux

ROOTFS=/rootfs
LIBDIR=/usr/lib64
BINARIES="/usr/bin/wayland-info /usr/bin/grim /usr/bin/socat /usr/bin/busybox /usr/bin/mountpoint /usr/bin/modprobe /bin/padd /bin/splash /bin/overlay /bin/compositor /usr/bin/sfdisk /usr/bin/mke2fs /usr/bin/mkfs.fat /usr/bin/btop /usr/bin/rsync /usr/bin/grub2-editenv /usr/bin/flock /usr/bin/nsenter /usr/bin/dropbear /usr/bin/dhcpcd /usr/bin/udevadm /usr/bin/mount.cifs /usr/bin/jq /usr/libexec/bluetooth/bluetoothd /usr/bin/dbus-daemon /usr/bin/seatd"
GBM_BACKEND=$LIBDIR/gbm/dri_gbm.so
EGL_VENDORS=/usr/share/glvnd/egl_vendor.d
VULKAN_DRIVERS=/usr/share/vulkan/icd.d
SOFTWARE_VULKAN_DRIVER=lvp_icd
AUDIO="/usr/bin/pipewire /usr/bin/pipewire-pulse /usr/bin/wireplumber /usr/bin/wpctl /usr/bin/pw-dump /usr/bin/pw-cli"
AUDIO_PLUGINS="$LIBDIR/pipewire-0.3 $LIBDIR/spa-0.2 $LIBDIR/wireplumber-0.5"
DOCKER="/usr/bin/dockerd /usr/bin/docker /usr/bin/containerd /usr/bin/containerd-shim-runc-v2 /usr/bin/runc /usr/libexec/docker/docker-init"
DOCKER_PLUGINS=/usr/libexec/docker/cli-plugins
BUS_CONFIG=/usr/share/dbus-1/system.conf
DATA="/usr/lib/udev/hwdb.bin /usr/share/pipewire /usr/share/spa-0.2 /usr/share/wireplumber /usr/share/alsa /usr/share/alsa-card-profile /usr/lib/udev/rules.d /usr/share/X11/xkb /etc/ssl/certs/ca-certificates.crt $BUS_CONFIG /usr/share/dbus-1/system.d/bluetooth.conf"
WLR_PROTOCOLS_URL=https://gitlab.freedesktop.org/wlroots/wlr-protocols/-/raw/master/unstable
WLR_PROTOCOLS="wlr-layer-shell-unstable-v1 wlr-foreign-toplevel-management-unstable-v1"
PROTOCOLS=$(pkg-config --variable=pkgdatadir wayland-protocols)
BACKGROUND_EFFECT=$PROTOCOLS/staging/ext-background-effect/ext-background-effect-v1.xml
CFLAGS="-O2 -Wall -Wextra -Werror -I/tmp"
. /src/config
. /src/guest/config

make_skeleton() {
  mkdir -p $ROOTFS/etc $ROOTFS/proc $ROOTFS/sys $ROOTFS/dev $ROOTFS/run $ROOTFS/tmp \
    $ROOTFS/mnt $ROOTFS/data $ROOTFS/boot/efi $ROOTFS/usr/share/terminfo/l $ROOTFS/usr/lib $ROOTFS/lib $ROOTFS/var/lib \
    $ROOTFS/www/cgi-bin $ROOTFS/opt $ROOTFS/usr/share/anyconsole $ROOTFS/etc/docker $ROOTFS/etc/bluetooth $ROOTFS/etc/pipewire/pipewire.conf.d $ROOTFS/etc/wireplumber/wireplumber.conf.d $ROOTFS/usr/local/share/wireplumber/scripts/device $ROOTFS/usr/local/share/wireplumber/scripts/default-nodes $ROOTFS/etc/modprobe.d
  ln -s /run $ROOTFS/var/run
  ln -s ../lib $ROOTFS$LIBDIR
}

write_shared_header() {
  {
    for name in $SHARED_WITH_C; do
      eval "value=\$$name"
      printf '#define %s "%s"\n' "$name" "$value"
    done
    for name in $NUMBERS_SHARED_WITH_C; do
      eval "value=\$$name"
      printf '#define %s %s\n' "$name" "$value"
    done
  } > /tmp/anyconsole.h
}

vulkan_drivers() { find $VULKAN_DRIVERS -name '*.json' ! -name "$SOFTWARE_VULKAN_DRIVER.*"; }

installed() {
  while read -r library; do
    case $library in /*) ;; *) library=$LIBDIR/$library ;; esac
    [ ! -e "$library" ] || echo "$library"
  done | sort -u
}

dlopened() {
  found=$(jq -r .ICD.library_path $EGL_VENDORS/*.json $(vulkan_drivers) | installed)
  until
    previous=$found
    found=$({ echo "$previous"; /src/build/dlopen-requests $(lddtree -l $BINARIES $GBM_BACKEND $AUDIO $DOCKER $previous); } | installed)
    [ "$found" = "$previous" ]
  do :; done
  echo "$found"
}

build_padd() { gcc $CFLAGS -o /bin/padd /src/guest/padd.c $(sdl2-config --cflags --libs) $(pkg-config --cflags --libs libevdev libsystemd libudev json-c opus zlib) -lm; }

generate_protocol() {
  wayland-scanner client-header "$1" "/tmp/$(basename "$1" .xml).h"
  wayland-scanner private-code "$1" "/tmp/$(basename "$1" .xml).c"
}

fetch_wlr_protocols() {
  for name in $WLR_PROTOCOLS; do fetch "$DOWNLOAD_CACHE" "$name.xml" "$WLR_PROTOCOLS_URL/$name.xml"; done
}

build_splash() {
  generate_protocol "$PROTOCOLS/stable/xdg-shell/xdg-shell.xml"
  gcc $CFLAGS -o /bin/splash /src/guest/splash.c /tmp/xdg-shell.c \
    $(pkg-config --cflags --libs libdrm libpng pixman-1 wayland-client) -lm
  rsvg-convert -o $ROOTFS$SPLASH_IMAGE /src/guest/splash.svg
}

build_overlay() {
  generate_protocol "$DOWNLOAD_CACHE/wlr-layer-shell-unstable-v1.xml"
  generate_protocol "$DOWNLOAD_CACHE/wlr-foreign-toplevel-management-unstable-v1.xml"
  generate_protocol "$PROTOCOLS/staging/security-context/security-context-v1.xml"
  generate_protocol "$PROTOCOLS/staging/ext-foreign-toplevel-list/ext-foreign-toplevel-list-v1.xml"
  generate_protocol "$PROTOCOLS/staging/ext-image-capture-source/ext-image-capture-source-v1.xml"
  generate_protocol "$PROTOCOLS/staging/ext-image-copy-capture/ext-image-copy-capture-v1.xml"
  generate_protocol "$PROTOCOLS/stable/linux-dmabuf/linux-dmabuf-v1.xml"
  generate_protocol "$BACKGROUND_EFFECT"
  gcc $CFLAGS -o /bin/overlay /src/guest/overlay.c /src/guest/scene.c /src/guest/script.c /src/guest/sound.c /src/guest/shader.c \
    /tmp/wlr-layer-shell-unstable-v1.c /tmp/wlr-foreign-toplevel-management-unstable-v1.c /tmp/security-context-v1.c /tmp/ext-foreign-toplevel-list-v1.c \
    /tmp/ext-image-capture-source-v1.c /tmp/ext-image-copy-capture-v1.c /tmp/linux-dmabuf-v1.c /tmp/xdg-shell.c /tmp/ext-background-effect-v1.c /usr/local/lib/libquickjs.a /usr/local/lib/libyogacore.a \
    $(pkg-config --cflags --libs cairo pixman-1 json-c wayland-client wayland-egl egl glesv2 gbm libdrm freetype2 harfbuzz opusfile libpipewire-0.3) \
    -lstdc++ -lm
}

build_compositor() {
  for protocol in "$PROTOCOLS/stable/xdg-shell/xdg-shell.xml" "$PROTOCOLS/unstable/pointer-constraints/pointer-constraints-unstable-v1.xml" \
    "$DOWNLOAD_CACHE/wlr-layer-shell-unstable-v1.xml" "$DOWNLOAD_CACHE/wlr-foreign-toplevel-management-unstable-v1.xml" \
    "$PROTOCOLS/staging/ext-image-capture-source/ext-image-capture-source-v1.xml" "$PROTOCOLS/staging/ext-image-copy-capture/ext-image-copy-capture-v1.xml" \
    "$BACKGROUND_EFFECT"; do
    wayland-scanner server-header "$protocol" "/tmp/$(basename "$protocol" .xml)-protocol.h"
  done
  gcc $CFLAGS -DWLR_USE_UNSTABLE -o /bin/compositor /src/guest/compositor.c /src/guest/shader.c /tmp/ext-image-capture-source-v1.c /tmp/ext-foreign-toplevel-list-v1.c /tmp/ext-background-effect-v1.c \
    $(pkg-config --cflags --libs wlroots-0.19 pixman-1 wayland-server xkbcommon libdrm json-c vulkan egl glesv2) -lm
}

copy_binaries() {
  dlopened=$(dlopened)
  lddtree --copy-to-tree $ROOTFS --bindir /bin --libdir /lib $BINARIES $GBM_BACKEND $dlopened $AUDIO $DOCKER
  lddtree --copy-to-tree $ROOTFS --libdir /lib $(find $AUDIO_PLUGINS -name '*.so')
  ln -s udevadm $ROOTFS/bin/systemd-udevd
  cp -aL --parents $DATA $DOCKER_PLUGINS $ROOTFS/
  mkdir -p $ROOTFS$EGL_VENDORS $ROOTFS$VULKAN_DRIVERS $ROOTFS$LIBDIR/gbm
  for library in $dlopened; do mv "$ROOTFS/bin/${library##*/}" $ROOTFS/lib/; done
  mv $ROOTFS/bin/dri_gbm.so $ROOTFS$LIBDIR/gbm/
  cp $EGL_VENDORS/*.json $ROOTFS$EGL_VENDORS/
  cp $(vulkan_drivers) $ROOTFS$VULKAN_DRIVERS/
  cp -a /usr/share/libinput $ROOTFS/usr/share/
  mkdir -p $ROOTFS$LIBDIR/gconv
  cp $LIBDIR/gconv/IBM850.so $LIBDIR/gconv/gconv-modules.cache $ROOTFS$LIBDIR/gconv/
}

install_busybox() {
  /usr/bin/busybox --install -s $ROOTFS/bin
  ln -s bin $ROOTFS/sbin
  ln -s ../bin $ROOTFS/usr/bin
  ln -s ../bin $ROOTFS/usr/sbin
  ln -s lib $ROOTFS/lib64
  ln -s /data/root $ROOTFS/root
}

configure_network() {
  ln -s /data/dhcpcd $ROOTFS/var/lib/dhcpcd
  ln -s /data/bluetooth $ROOTFS/var/lib/bluetooth
  cp -a --parents /usr/libexec/dhcpcd-run-hooks /usr/libexec/dhcpcd-hooks $ROOTFS/
  cp /etc/dhcpcd.conf /src/guest/dhcpcd.exit-hook $ROOTFS/etc/
}

configure_users() {
  bus_user=$(xmllint --xpath 'string(/busconfig/user)' $BUS_CONFIG)
  ln -s /data/dropbear $ROOTFS/etc/dropbear
  printf 'root:x:0:0:root:/root:/bin/sh\ndhcpcd:x:100:65534::/:/bin/false\n%s:x:101:101::/:/bin/false\n' "$bus_user" > $ROOTFS/etc/passwd
  printf 'root:%s:::::::\n' "$(busybox mkpasswd -m sha512 "$CONSOLE_PASSWORD")" > $ROOTFS/etc/shadow
  chmod 600 $ROOTFS/etc/shadow
  printf 'root:x:0:\n%s:x:101:\nnogroup:x:65534:\n' "$bus_user" > $ROOTFS/etc/group
}

configure_locale() {
  cp /usr/share/terminfo/l/linux $ROOTFS/usr/share/terminfo/l/
  printf 'export LANG=C.UTF-8\nexport TERM=linux\nexport PATH=/bin:/opt/anyconsole\nexport HOME=/root\nexport XDG_RUNTIME_DIR=/run/user\n' > $ROOTFS/etc/profile
}

install_system() {
  cp /src/guest/rc /src/guest/inittab $ROOTFS/etc/
  cp /src/guest/config $ROOTFS/etc/anyconsole.conf
  cp /src/guest/otad /src/guest/installer /src/guest/mkdisk /src/guest/games /src/guest/settings $ROOTFS/bin/
  cp /src/guest/daemon.json $ROOTFS/etc/docker/
  cp /src/guest/bluez-input.conf $ROOTFS/etc/bluetooth/input.conf
  cp /src/guest/gamecontrollerdb.txt "$ROOTFS$CONTROLLER_MAPPINGS"
  sed "s/@KERNEL_ARGS@/$KERNEL_ARGS/" /src/guest/grub.cfg > "$ROOTFS$GRUB_CONFIG"
  grub2-editenv $ROOTFS/boot/kernel.env create
  grub2-editenv $ROOTFS/boot/kernel.env set extra="$KERNEL_ARGS"
  sed -e "s/@MICROPHONE_NODE@/$MICROPHONE_NODE/g" -e "s/@BLOW_NODE@/$BLOW_NODE/g" /src/guest/pipewire.conf > $ROOTFS/etc/pipewire/pipewire.conf.d/anyconsole.conf
  cp /src/guest/wireplumber.conf $ROOTFS/etc/wireplumber/wireplumber.conf.d/anyconsole.conf
  cp /src/guest/find-detected-profile.lua $ROOTFS/usr/local/share/wireplumber/scripts/device/
  cp /src/guest/find-real-default-source.lua $ROOTFS/usr/local/share/wireplumber/scripts/default-nodes/
  printf 'blacklist snd_pcsp\n' > $ROOTFS/etc/modprobe.d/anyconsole.conf
  cp /src/guest/api $ROOTFS/www/cgi-bin/
  printf 'VERSION=%s\n' "$VERSION" > $ROOTFS/etc/anyconsole-release
}

hide_input_from_compositor() {
  mkdir -p "$ROOTFS${INPUT_RULES%/*}"
  printf 'SUBSYSTEM=="input", KERNEL=="event*", ENV{LIBINPUT_IGNORE_DEVICE}="1"\nSUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="%s", ENV{LIBINPUT_IGNORE_DEVICE}=""\n' \
    "$KEYBOARD_NAME" > "$ROOTFS$INPUT_RULES"
}

install_app() { cp -a /src/app $ROOTFS/opt/anyconsole; }

install_skin_assets() {
  for list in /src/app/skins/*/assets; do
    folder=$ROOTFS$SKINS_DIR/$(basename "$(dirname "$list")")
    while read -r file source checksum; do
      [ -f "$DOWNLOAD_CACHE/$checksum" ] || fetch "$DOWNLOAD_CACHE" "$checksum" "$source"
      echo "$checksum  $DOWNLOAD_CACHE/$checksum" | sha256sum -c --quiet
      install -D -m 644 "$DOWNLOAD_CACHE/$checksum" "$folder/$file"
    done < "$list"
  done
}

finalize() {
  chmod +x $ROOTFS/etc/rc $ROOTFS/bin/otad $ROOTFS/bin/installer $ROOTFS/bin/mkdisk $ROOTFS/bin/games $ROOTFS/bin/settings $ROOTFS/www/cgi-bin/api
  cp -a /src/build/out/stage/. $ROOTFS/
  mknod $ROOTFS/dev/console c 5 1
  mknod $ROOTFS/dev/null c 1 3
}

make_skeleton
write_shared_header
fetch_wlr_protocols
build_padd
build_splash
build_overlay
build_compositor
copy_binaries
install_busybox
configure_network
configure_users
configure_locale
install_system
hide_input_from_compositor
install_app
install_skin_assets
finalize
