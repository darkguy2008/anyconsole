#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. guest/config
. build/apt-cache

VERSION=$(cat VERSION)
KERNEL_VERSION=$(basename /lib/modules/*-lts)
MODULE_DIR=/lib/modules/$KERNEL_VERSION
STAGE=build/out/stage
INITRAMFS_FEATURES="base ata scsi usb nvme ext4"
INITRAMFS_CACHE=build/out/cache/initramfs-$KERNEL_VERSION-$(echo $INITRAMFS_FEATURES | tr " " -)
MODULE_TREE=build/out/module-tree
MODULE_FEATURES=build/out/features
RELEASE=rel/$VERSION
BASE_IMAGE=anyconsole-rootfs-base

install_firmware() { apk add -q linux-firmware; }

stage_kernel() {
  rm -rf "$STAGE"
  mkdir -p "$STAGE/boot" build/out/cache
  [ -f "$INITRAMFS_CACHE" ] ||
    mkinitfs -F "$INITRAMFS_FEATURES" -o "$INITRAMFS_CACHE" "$KERNEL_VERSION"
  cp "$INITRAMFS_CACHE" "$STAGE/boot/initramfs"
  cp /boot/vmlinuz-lts "$STAGE/boot/kernel"
}

stage_modules() {
  rm -rf "$MODULE_TREE"
  mkdir -p "$MODULE_FEATURES" "$STAGE/lib"
  softdeps=$(modinfo -F softdep $MODULES | tr ' ' '\n' | grep -v ':$')
  { modinfo -n $MODULES $softdeps | grep "^$MODULE_DIR/" | sed "s|^$MODULE_DIR/||"; printf "%s\n" $MODULE_TREES; } > "$MODULE_FEATURES/anyconsole.modules"
  mkinitfs -l -k -t "$PWD/$MODULE_TREE" -P "$PWD/$MODULE_FEATURES" -F "base kms anyconsole" "$KERNEL_VERSION" >/dev/null
  cp -a "$MODULE_TREE/lib/modules" "$MODULE_TREE/lib/firmware" "$STAGE/lib/"
  find "$STAGE/lib/modules" -name '*.ko.gz' -exec gunzip {} +
  depmod -b "$STAGE" "$KERNEL_VERSION"
}

build_base() {
  ensure_apt_cache
  docker build --network host --build-arg APT_PROXY="$APT_PROXY" -t "$BASE_IMAGE" - < build/base.Dockerfile
}

build_userspace() {
  rm -rf "$RELEASE"
  mkdir -p "$RELEASE" build/out/cache/downloads
  docker run --rm -e VERSION="$VERSION" -e DOWNLOAD_CACHE=/downloads \
    -v "$PWD:/src" -v "$PWD/$RELEASE:/rootfs" -v "$PWD/build/out/cache/downloads:/downloads" \
    "$BASE_IMAGE" sh /src/build/rootfs-container
}

dedup_releases() { hardlink -q -t rel; }

install_firmware
stage_kernel
stage_modules
build_base
build_userspace
dedup_releases
