#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. config

VERSION=$(cat VERSION)
KERNEL_VERSION=$(basename /lib/modules/*-lts)
STAGE=build/out/stage
INITRAMFS_CACHE=build/out/cache/initramfs-$KERNEL_VERSION
RELEASE=rel/$VERSION

stage_kernel() {
  rm -rf "$STAGE"
  mkdir -p "$STAGE/boot" build/out/cache
  [ -f "$INITRAMFS_CACHE" ] ||
    mkinitfs -F "base ata scsi usb nvme ext4 kms" -o "$INITRAMFS_CACHE" "$KERNEL_VERSION"
  cp "$INITRAMFS_CACHE" "$STAGE/boot/initramfs"
  cp /boot/vmlinuz-lts "$STAGE/boot/kernel"
  cp --parents -t "$STAGE" "/lib/modules/$KERNEL_VERSION/modules.builtin"
  for module in $MODULES; do modprobe --show-depends "$module"; done |
    awk '$1 == "insmod" { print $2 }' | sort -u | xargs cp --parents -t "$STAGE"
  find "$STAGE/lib/modules/$KERNEL_VERSION" -name '*.ko.gz' -exec gunzip -f {} +
  depmod -b "$PWD/$STAGE" "$KERNEL_VERSION"
}

build_userspace() {
  docker run --rm -e VERSION="$VERSION" -v "$PWD:/src" debian:trixie sh /src/build/rootfs-container
}

publish_release() {
  rm -rf "$STAGE" "$RELEASE"
  mkdir -p "$RELEASE"
  tar -xzf build/out/rootfs.tar.gz -C "$RELEASE"
}

stage_kernel
build_userspace
publish_release
