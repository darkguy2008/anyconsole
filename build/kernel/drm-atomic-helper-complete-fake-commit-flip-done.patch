From 2d1968a8bc4898e6b5c2317a205641b6b148cefc Mon Sep 17 00:00:00 2001
From: Alemar Osorio <alemarosorio@gmail.com>
Date: Mon, 12 Oct 2026 01:44:58 -0600
Subject: [PATCH] drm/atomic-helper: Complete fake_commit->flip_done at setup
 time

Planes and connectors that have no CRTC in both their old and new state
are tracked through state->fake_commit. Its flip_done is completed only
from drm_atomic_helper_wait_for_flip_done(), which runs in the commit
tail after the real CRTC commits have flipped. The page flip event is
sent to userspace before that, from the vblank handling of the CRTC.

Userspace that issues its next nonblocking commit as soon as it gets the
event can therefore still find the fake_commit of the previous commit
incomplete. If that commit touches the same unbound plane again, for
example wlroots, which disables its cursor plane (FB_ID=0, CRTC_ID=0) in
every page flip while no cursor is shown, drm_atomic_helper_setup_commit()
fails it with -EBUSY:

  [PLANE:77:cursor A] busy with a previous commit

Commit 2de42f79bb21 ("drm/atomic-helper: Complete fake_commit->flip_done
potentially earlier") narrowed this window, but it is still open as long
as the commit tail has not run after the event was sent.

An unbound plane or connector is never scanned out, so there is no flip
to wait for. The fake_commit exists to keep the old plane and connector
states alive until the previous commit is done with them, and that is
ensured by waiting for its hw_done in drm_atomic_helper_swap_state() and
drm_crtc_commit_wait(). Complete its flip_done as soon as it is created
instead, and keep completing hw_done and cleanup_done where they are.

Fixes: 080de2e5be2d ("drm/atomic: Check for busy planes/connectors before setting the commit")
Closes: https://gitlab.freedesktop.org/drm/i915/kernel/-/issues/13410
Link: https://gitlab.freedesktop.org/wlroots/wlroots/-/issues/3507
Signed-off-by: Alemar Osorio <alemarosorio@gmail.com>
---
 drivers/gpu/drm/drm_atomic_helper.c | 13 +++++++------
 include/drm/drm_atomic.h            |  4 +++-
 2 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/drivers/gpu/drm/drm_atomic_helper.c b/drivers/gpu/drm/drm_atomic_helper.c
index 9d006f984..e866e1686 100644
--- a/drivers/gpu/drm/drm_atomic_helper.c
+++ b/drivers/gpu/drm/drm_atomic_helper.c
@@ -1967,9 +1967,6 @@ void drm_atomic_helper_wait_for_flip_done(struct drm_device *dev,
 			drm_err(dev, "[CRTC:%d:%s] flip_done timed out\n",
 				crtc->base.id, crtc->name);
 	}
-
-	if (state->fake_commit)
-		complete_all(&state->fake_commit->flip_done);
 }
 EXPORT_SYMBOL(drm_atomic_helper_wait_for_flip_done);
 
@@ -2464,6 +2461,12 @@ crtc_or_fake_commit(struct drm_atomic_commit *state, struct drm_crtc *crtc)
 			return NULL;
 
 		init_commit(state->fake_commit, NULL);
+		/*
+		 * Planes and connectors without a CRTC in both the old and the
+		 * new state are never scanned out, so there is no flip to wait
+		 * for. Their state lifetime is still tracked through hw_done.
+		 */
+		complete_all(&state->fake_commit->flip_done);
 	}
 
 	return state->fake_commit;
@@ -2759,10 +2762,8 @@ void drm_atomic_helper_commit_hw_done(struct drm_atomic_commit *state)
 		complete_all(&commit->hw_done);
 	}
 
-	if (state->fake_commit) {
+	if (state->fake_commit)
 		complete_all(&state->fake_commit->hw_done);
-		complete_all(&state->fake_commit->flip_done);
-	}
 }
 EXPORT_SYMBOL(drm_atomic_helper_commit_hw_done);
 
diff --git a/include/drm/drm_atomic.h b/include/drm/drm_atomic.h
index 3ae35b09c..8bab4fc33 100644
--- a/include/drm/drm_atomic.h
+++ b/include/drm/drm_atomic.h
@@ -653,7 +653,9 @@ struct drm_atomic_commit {
 	 * When a connector or plane is not bound to any CRTC, it's still important
 	 * to preserve linearity to prevent the atomic states from being freed too early.
 	 *
-	 * This commit (if set) is not bound to any CRTC, but will be completed when
+	 * This commit (if set) is not bound to any CRTC. Its flip_done is completed
+	 * as soon as it is created, because unbound planes/connectors are never
+	 * scanned out, and its hw_done is completed when
 	 * drm_atomic_helper_commit_hw_done() is called.
 	 */
 	struct drm_crtc_commit *fake_commit;
-- 
