#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. ./config
DOWNLOADS=build/out/cache/downloads
SCRATCH=$PWD/build/out/store-scratch
SHIRU=https://web.archive.org/web/2020id_/https://shiru.untergrund.net/files
INUFUTO=https://web.archive.org/web/2024id_/http://inufuto.web.fc2.com
GITHUB=https://github.com
ARCHIVE=https://archive.org/download
PS2_BOOT_FILE=TEST_000.01
CUBES_DEMO=$GITHUB/glampert/ps2-homebrew/raw/602441a6877a3136709d6320664340d52e3027a1/source/demos/bin/cubes_demo.elf
PS2_RAM_BELOW_PROGRAMS=000FFFF0
TWIN_STICK='{"-lefty": "y", "+lefty": "a", "-leftx": "x", "+leftx": "b", "rightx": "leftx", "righty": "lefty"}'

add_game() {
  mkdir -p "$TEST_STORE/$1/$3/rom"
  jq -n --arg title "$2" --arg platform "$3" --argjson config "${5:-null}" --argjson titles "${6:-null}" \
    '{title: $title} + if $titles then {titles: $titles} else {} end + if $config then {($platform): $config} else {} end' > "$TEST_STORE/$1/manifest.json"
  cp "$4" "$TEST_STORE/$1/$3/rom/$2.${4##*.}"
}

extract() {
  fetch "$DOWNLOADS" "$1" "$2"
  mkdir "$SCRATCH/$1" && unzip -q "$DOWNLOADS/$1" -d "$SCRATCH/$1"
}

add_download() {
  file=${4##*/}
  fetch "$DOWNLOADS" "$file" "$4"
  add_game "$1" "$2" "$3" "$DOWNLOADS/$file" "${5:-}" "${6:-}"
}

add_zipped() {
  file=${4##*/}
  extract "$file" "$4"
  add_game "$1" "$2" "$3" "$(find "$SCRATCH/$file" -iname "$5" | head -1)" "${6:-}"
}

add_zipped_without() {
  slug=$1 title=$2 platform=$3 file=$1-${4##*/} config=$5
  extract "$file" "$4"
  shift 5
  (cd "$SCRATCH/$file" && rm "$@" && python3 -m zipfile -c "$SCRATCH/$slug.zip" *)
  add_game "$slug" "$title" "$platform" "$SCRATCH/$slug.zip" "$config"
}

add_cue_disc() {
  file=${4##*/}
  extract "$file" "$4"
  add_game "$1" "$2" "$3" "$(find "$SCRATCH/$file" -iname '*.cue')"
  cp "$(find "$SCRATCH/$file" -iname '*.bin')" "$TEST_STORE/$1/$3/rom/"
}

pcsx2_crc() { python3 -I -c 'import struct, sys; data = open(sys.argv[1], "rb").read(); crc = 0
for (word,) in struct.iter_unpack("<I", data[: len(data) // 4 * 4]): crc ^= word
print(f"{crc:08X}")' "$1"; }

add_ps2_disc() {
  file=${4##*/} disc=$SCRATCH/$1
  fetch "$DOWNLOADS" "$file" "$4"
  mkdir -p "$disc"
  cp "$DOWNLOADS/$file" "$disc/$PS2_BOOT_FILE"
  printf 'BOOT2 = cdrom0:\\%s;1\r\nVER = 1.00\r\nVMODE = NTSC\r\n' "$PS2_BOOT_FILE" > "$disc/SYSTEM.CNF"
  xorriso -as mkisofs -quiet -o "$SCRATCH/$1.iso" "$disc"
  add_game "$1" "$2" "$3" "$SCRATCH/$1.iso" "$5"
  printf '[Widescreen 16:9]\ngsaspectratio=16:9\npatch=0,EE,%s,word,00000000\n[Standard 4:3]\npatch=0,EE,%s,word,00000000\n' "$PS2_RAM_BELOW_PROGRAMS" "$PS2_RAM_BELOW_PROGRAMS" > "$TEST_STORE/$1/$3/rom/$(pcsx2_crc "$disc/$PS2_BOOT_FILE").pnach"
}

rm -rf "$SCRATCH" "$TEST_STORE"
mkdir -p "$DOWNLOADS" "$SCRATCH"
add_zipped alter-ego "Alter Ego" nes "$SHIRU/nes/alter_ego.zip" '*.nes'
add_zipped lan-master "LAN Master" nes "$SHIRU/nes/lan_master.zip" '*.nes'
add_zipped_without commander-keen "Commander Keen" msdos "$ARCHIVE/keen1-sw/keen1.zip" '{"thumbnail": "Commander Keen 1 - Marooned on Mars (1990)", "refresh": 70}' CATALOG.EXE DEALERS.EXE
add_zipped christmas-craze "Christmas Craze" snes "$SHIRU/snes/christmas_craze.zip" '*.smc'
add_download snes-pride "SNESPride" snes "https://codeberg.org/Telinc1/SNESPride/releases/download/v1.0.0/SNESPride.sfc" '{"region": "usa"}'
add_download gentris "Gentris" genesis "$GITHUB/Stephane-D/SGDK/raw/2eac605a7744a6eb4f61824bb24ccab39b8bd8b8/sample/game/gentris/out/release/rom.bin" '{"options": {"genesis_plus_gx_audio_filter": "low-pass"}}'
add_download libbet "Libbet and the Magic Floor" gb "$GITHUB/pinobatch/libbet/releases/download/v0.08/libbet.gb"
add_zipped the-hat-chooses-the-wizard "The Hat Chooses the Wizard" gba "$GITHUB/agbrs/agb/releases/download/v0.25.0/examples.zip" 'the-hat-chooses-the-wizard.gba'
add_download legendary-spear "Legendary Spear" atari2600 "$GITHUB/DChristianson/legendary-spear/releases/download/v1.1/LegendarySpear_NTSC.bin"
add_download kumi-daiko-beatoff "Kumi-Daiko Beatoff 64" n64 "$GITHUB/ptimonen/n64-riistahillo/releases/download/1.0/Kumi-Daiko-Beatoff-64.n64"
add_zipped cracky "Cracky" wsc "$INUFUTO/16bit/wsc/cracky_bin.zip" '*.wsc'
add_zipped cracky-msx "Cracky MSX" msx2 "$INUFUTO/8bit/msx/cracky_rom.zip" '*.rom' '{"hold": {"key": "KEY_LEFTCTRL", "ms": 15000}}'
add_zipped gc-controller-test "GC Controller Test" gamecube "$GITHUB/corenting/GC-Controller-Test/releases/download/v1.2/gc-1-2.zip" '*.dol'
add_download mini-mine-rt "Mini Mine RT" psp "$GITHUB/Saymond/PSP-apps/releases/download/v2.0/EBOOT.PBP" '{}' '{"es": "Mini Mina RT"}'
add_download system-param "System Param" psp "$GITHUB/hrydgard/pspautotests/raw/a9b26db62a895c93f87550d37bf3833819bdc49f/tests/utility/systemparam/systemparam.prx"
[ ! -d "$TEST_BIOS/ps1" ] || add_cue_disc a-small-journey "A Small Journey" ps1 "$ARCHIVE/asj-1.0/asj-1.0.zip"
[ ! -d "$TEST_BIOS/ps2" ] || add_ps2_disc cubes-demo "Cubes Demo" ps2 "$CUBES_DEMO" '{"enhanced": {"widescreen": true}}'
[ ! -d "$TEST_BIOS/ps2" ] || add_ps2_disc cubes-demo-europe "Cubes Demo Europe" ps2 "$CUBES_DEMO" '{"region": "europe"}'
[ ! -d "$TEST_BIOS/ps3" ] || add_download gcm-cube "GCM Cube" ps3 "$GITHUB/RPCS3/rpcs3/raw/2ba2f75bcea7ef6bdd687046c7fcfb790faf9853/bin/test/gs_gcm_cube.elf"
add_download gravity-wave-twin-stick-shooter "Gravity Wave" dreamcast "$GITHUB/richstokes/dreamcast-homebrew/releases/download/continuous/gravity-wave.cdi" "{\"pad\": $TWIN_STICK}"
