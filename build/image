#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
DISK_SIZE=${DISK_SIZE:-8G}
ESP_SLACK_MIB=64
DISK=build/out/disk.img
INSTALLER=build/out/installer.img
INSTALLER_ROOT=build/out/installer-root.img
MEASURE_FACTOR=2
ALIGNMENT_MIB=1
ESP=build/out/esp
RELEASE=rel/$(cat VERSION)
MOUNT=/mnt/anyconsole

build_esp() {
  rm -rf "$ESP"
  mkdir -p "$ESP/EFI/BOOT" "$ESP/grub"
  grub-mkimage -O x86_64-efi -p '(,gpt1)/grub' -o "$ESP/EFI/BOOT/BOOTX64.EFI" \
    part_gpt ext2 fat normal linux search search_label test all_video gfxterm gfxmenu png efi_gop loadenv
  cp "$RELEASE/usr/share/anyconsole/splash.png" "$ESP/grub/"
  cat > "$ESP/grub/theme.txt" <<'THEME'
desktop-image: "splash.png"
desktop-image-scale-method: "padding"
desktop-color: "#000000"
+ boot_menu { width = 0 height = 0 }
THEME
  cat > "$ESP/grub/grub.cfg" <<'GRUB'
set timeout=2
load_env
set gfxpayload=keep
set theme=$prefix/theme.txt
terminal_output gfxterm
if search --no-floppy --label installer --set=root; then
  set label=installer
  set extra="console=tty0 quiet init=/bin/installer"
else
  set extra="drm_kms_helper.fbdev_emulation=0"
  set target="$prev"
  if [ "$tries" = "1" ]; then
    set target="$slot"
    set tries=0
    save_env tries
  fi
  set label="root-$target"
  search --no-floppy --label "$label" --set=root
fi
menuentry "anyconsole ($label)" {
  linux /boot/kernel console=ttyS0 rootfstype=ext4 rw root=LABEL=$label $extra
  initrd /boot/initramfs
}
GRUB
  grub-editenv "$ESP/grub/grubenv" create
  grub-editenv "$ESP/grub/grubenv" set slot=a prev=a tries=1 gfxmode=auto
}

build_disk() {
  rm -f "$DISK"
  truncate -s "$DISK_SIZE" "$DISK"
  loop=$(losetup -fP --show "$DISK")
  sh guest/mkdisk "$loop" "$RELEASE" "$ESP"
  losetup -d "$loop"
}

fill_installer_root() {
  rm -f "$INSTALLER_ROOT"
  truncate -s "$1" "$INSTALLER_ROOT"
  mke2fs -qF -t ext4 -L installer -N "$(find "$RELEASE" | wc -l)" -d "$RELEASE" "$INSTALLER_ROOT"
}

used_bytes() { tune2fs -l "$1" | awk -F': *' '/^Block count:/ { count = $2 } /^Free blocks:/ { free = $2 } /^Block size:/ { size = $2 } END { print (count - free) * size }'; }

build_installer_root() {
  fill_installer_root "$(( $(du -sm "$RELEASE" | cut -f1) * MEASURE_FACTOR ))M"
  fill_installer_root "$(used_bytes "$INSTALLER_ROOT")"
}

build_installer() {
  rm -f "$INSTALLER"
  build_installer_root
  esp_mib=$(( $(du -sm "$ESP" | cut -f1) + ESP_SLACK_MIB ))
  root_mib=$(du --apparent-size -m "$INSTALLER_ROOT" | cut -f1)
  truncate -s "$((ALIGNMENT_MIB + esp_mib + root_mib + ALIGNMENT_MIB))M" "$INSTALLER"
  loop=$(losetup -fP --show "$INSTALLER")
  sfdisk -q "$loop" <<TABLE
label: gpt
size=${esp_mib}MiB, type=uefi, name=INSTALL
type=linux, name=installer
TABLE
  mkfs.fat -n INSTALL "${loop}p1" >/dev/null
  cat "$INSTALLER_ROOT" > "${loop}p2"
  rm "$INSTALLER_ROOT"
  mkdir -p "$MOUNT"
  mount "${loop}p1" "$MOUNT"
  cp -a "$ESP"/. "$MOUNT"/
  umount "$MOUNT"
  losetup -d "$loop"
}

sh build/rootfs
build_esp
build_disk
build_installer
cp -f /usr/share/OVMF/OVMF_VARS.fd build/out/efivars.fd
