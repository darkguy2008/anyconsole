+
+static DBusMessage *acquire_microphone(DBusConnection *conn,
+					DBusMessage *msg, void *data)
+{
+	struct input_device *idev = data;
+	DBusMessage *reply;
+	int fds[2];
+
+	if (!is_dualsense(idev))
+		return btd_error_not_supported(msg);
+
+	if (socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, fds) < 0)
+		return btd_error_failed(msg, strerror(errno));
+
+	close_microphone(idev);
+	idev->microphone_fd = fds[0];
+	reply = g_dbus_create_reply(msg, DBUS_TYPE_UNIX_FD, &fds[1],
+							DBUS_TYPE_INVALID);
+	close(fds[1]);
+
+	return reply;
 }
 
