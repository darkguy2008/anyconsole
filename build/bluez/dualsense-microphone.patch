+
+static bool is_dualsense(struct input_device *idev)
+{
+	uint16_t product = btd_device_get_product(idev->device);
+
+	return btd_device_get_vendor(idev->device) == DUALSENSE_VENDOR &&
+		(product == DUALSENSE_PRODUCT ||
+		 product == DUALSENSE_EDGE_PRODUCT);
+}
+
+static bool is_microphone_frame(struct input_device *idev,
+					const uint8_t *report, size_t size)
+{
+	return size > 1 && report[0] == DUALSENSE_REPORT &&
+		(report[1] & DUALSENSE_REPORT_TYPE_MASK) ==
+						DUALSENSE_MICROPHONE_TYPE &&
+		is_dualsense(idev);
+}
+
+static void send_microphone_frame(struct input_device *idev,
+					const uint8_t *report, size_t size)
+{
+	if (idev->microphone_fd < 0)
+		return;
+
+	if (send(idev->microphone_fd, report, size,
+				MSG_DONTWAIT | MSG_NOSIGNAL) < 0 && errno != EAGAIN)
+		close_microphone(idev);
 }
 
