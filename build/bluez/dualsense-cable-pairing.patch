+
+	buf[0] = DS5_FEATURE_REPORT_PAIRING_INFO;
+
+	ret = ioctl(fd, HIDIOCGFEATURE(DS5_FEATURE_REPORT_PAIRING_INFO_SIZE),
+									buf);
