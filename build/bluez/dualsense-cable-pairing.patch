+static GSList *stored_link_keys(struct btd_adapter *adapter)
+{
+	char dirname[PATH_MAX];
+	GSList *keys = NULL;
+	DIR *dir;
+	struct dirent *entry;
+
+	create_filename(dirname, PATH_MAX, "/%s",
+				btd_adapter_get_storage_dir(adapter));
+
+	dir = opendir(dirname);
+	if (!dir)
+		return NULL;
+
+	while ((entry = readdir(dir)) != NULL) {
+		char filename[PATH_MAX];
+		GKeyFile *key_file;
+		struct link_key_info *key_info;
+
+		if (entry->d_type == DT_UNKNOWN)
+			entry->d_type = util_get_dt(dirname, entry->d_name);
+
+		if (entry->d_type != DT_DIR || bachk(entry->d_name) < 0)
+			continue;
+
+		create_filename(filename, PATH_MAX, "/%s/%s/info",
+					btd_adapter_get_storage_dir(adapter),
+					entry->d_name);
+
+		key_file = g_key_file_new();
+		g_key_file_load_from_file(key_file, filename, 0, NULL);
+		key_info = get_key_info(key_file, entry->d_name,
+						get_addr_type(key_file));
+		g_key_file_free(key_file);
+
+		if (key_info && key_info->is_blocked)
+			g_free(key_info);
+		else if (key_info)
+			keys = g_slist_append(keys, key_info);
+	}
+
+	closedir(dir);
+
+	return keys;
+}
+
+void btd_adapter_add_link_key(struct btd_adapter *adapter,
+				struct btd_device *device, const uint8_t *key,
+				uint8_t type)
+{
+	GSList *keys;
+
+	store_link_key(adapter, device, key, type, 0);
+	device_set_paired(device, BDADDR_BREDR);
+	device_set_bonded(device, BDADDR_BREDR);
+
+	keys = stored_link_keys(adapter);
+	load_link_keys(adapter, keys, btd_opts.debug_keys);
+	g_slist_free_full(keys, g_free);
+}
+
