+static int ds5_pair(int fd, struct btd_adapter *adapter,
+						struct btd_device *device)
+{
+	uint8_t buf[DS5_FEATURE_REPORT_SET_PAIRING_SIZE];
+	uint8_t *key = buf + 1 + sizeof(bdaddr_t);
+	int ret;
+
+	memset(buf, 0, sizeof(buf));
+
+	buf[0] = DS5_FEATURE_REPORT_SET_PAIRING;
+	bacpy((bdaddr_t *) (buf + 1), btd_adapter_get_address(adapter));
+
+	if (util_getrandom(key, DS5_LINK_KEY_SIZE, 0) < 0) {
+		error("sixaxis: failed to generate DS5 link key (%s)",
+							strerror(errno));
+		return -1;
+	}
+
+	ret = ioctl(fd, HIDIOCSFEATURE(sizeof(buf)), buf);
+	if (ret < 0) {
+		error("sixaxis: failed to write DS5 pairing (%s)",
+							strerror(errno));
+		return ret;
+	}
+
+	btd_adapter_add_link_key(adapter, device, key,
+						HCI_LK_UNAUTH_COMBINATION);
+
+	return 0;
+}
