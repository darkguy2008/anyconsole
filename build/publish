#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. ./config
version=$1 release=${2:-}
index=$RELEASES_DIR/index
staged=$RELEASES_DIR/.$version.new

mkdir -p "$RELEASES_DIR"
lock_releases
trap 'rm -rf "$staged" "$index.new"' EXIT
cat > "$index.new"
if [ -n "$release" ]; then
  require_newer "$version"
  cp -al "$release" "$staged"
  rm -rf "${RELEASES_DIR:?}/$version"
  mv "$staged" "$RELEASES_DIR/$version"
  hardlink -q -t "$RELEASES_DIR"
else
  [ "$version" = "$(published_version)" ] || { echo "v$version is not the published v$(published_version); only that release can be announced again" >&2; exit 1; }
fi
mv "$index.new" "$index"
