#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. config
. guest/config
VERSION=$(cat VERSION)
OUT=build/out/test
TARGET_SIZE=16G
SSH_TEST_PORT=2223
API_TEST_PORT=8081
POLLS_PER_SECOND=10
POLL_INTERVAL=$(awk "BEGIN { print 1 / $POLLS_PER_SECOND }")
STEP_SECONDS=15
BOOT_SECONDS=180
INSTALL_SECONDS=1200
STARTED=$(date +%s)
TEST_VOLUME=10
SECOND_DISPLAY_WIDTH=1920
SECOND_DISPLAY_HEIGHT=1080

monitor() { echo "$1" | socat - UNIX-CONNECT:$OUT/monitor.sock >/dev/null; }
guest() {
  with_password ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR -o ConnectTimeout=1 -o ControlMaster=auto -o ControlPath=$OUT/ssh.sock -o ControlPersist=yes \
    -p $SSH_TEST_PORT root@127.0.0.1 "$@"
}
api() { curl -fsS -X "$1" --data-binary "${3:-}" "127.0.0.1:$API_TEST_PORT/cgi-bin/api/$2"; }
state() { api GET state; }
log() { echo "$1 +$(($(date +%s) - STARTED))s: $2"; }
diagnose() {
  guest "cat $STATE_FILE /tmp/install.log; echo; for log in $LOG_DIR/*.log; do echo \"== \$log\"; tail -n 15 \"\$log\"; done" >&2 || true
}
wait_for() {
  attempts=$(($1 * POLLS_PER_SECOND)) attempt=0
  shift
  until "$@" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    [ $attempt -le $attempts ] || { log FAIL "timed out waiting for: $*" >&2; diagnose; exit 1; }
    sleep $POLL_INTERVAL
  done
}
holds() { state | jq -e "$1"; }
expect() { wait_for $STEP_SECONDS holds "$1"; log ok "$1"; }
game_name() { echo "${1%/*}-${1#*/}"; }
status_of() { echo ".games[] | select(.key == \"$1\") | .status == \"$2\""; }
send() { api POST input "$(printf '%s\n' "$@")" >/dev/null; }
tap() { send "1 $1 1" "1 $1 0"; }
key() { send "EV_KEY $1 1" "EV_KEY $1 0"; }
highlight() {
  target=$(state | jq "[.rows[].label] | index(\"$1\")")
  [ "$target" != null ] || { log FAIL "no row $1" >&2; diagnose; exit 1; }
  while selected=$(state | jq .selected); [ "$selected" != "$target" ]; do
    if [ "$selected" -lt "$target" ]; then tap dpdown; else tap dpup; fi
    wait_for $STEP_SECONDS holds ".selected != $selected"
  done
}
choose() {
  highlight "$1"
  tap a
}
snapshot() { monitor "screendump $OUT/$1.png -f png"; wait_for $STEP_SECONDS test -s "$OUT/$1.png"; }
booted() { guest "grep -q VERSION=$VERSION /etc/anyconsole-release && [ \$(cat /data/boots) = $1 ] && pidof overlay && [ -s $STATE_FILE ]"; }

start_vm() {
  sh build/store
  rm -rf $OUT
  mkdir -p $OUT
  truncate -s $TARGET_SIZE $OUT/target.img
  cp /usr/share/OVMF/OVMF_VARS.fd $OUT/efivars.fd
  run_qemu $OUT/efivars.fd $OUT/target.img \
    "hostfwd=tcp:127.0.0.1:$SSH_TEST_PORT-:22,hostfwd=tcp:127.0.0.1:$API_TEST_PORT-:$API_PORT" \
    -device qemu-xhci -drive file=build/out/installer.img,format=raw,if=none,id=usb0 -device usb-storage,drive=usb0,id=stick \
    -device virtio-gpu-pci,xres=$SECOND_DISPLAY_WIDTH,yres=$SECOND_DISPLAY_HEIGHT -display none -monitor unix:$OUT/monitor.sock,server,nowait -serial file:$OUT/serial.log &
  trap 'monitor quit' EXIT
}

install_from_stick() {
  wait_for $BOOT_SECONDS guest true
  for key in 1 ret y ret; do monitor "sendkey $key"; done
  wait_for $BOOT_SECONDS guest 'findfs LABEL=data && ! pidof mkdisk'
  monitor "device_del stick"
  monitor "sendkey ret"
}

install_game() {
  choose "$2"
  expect '.screen == "game"'
  choose "Install from"
  wait_for $INSTALL_SECONDS holds "$(status_of "$1" installed)"
  log ok "installed $1"
}

play_game() {
  choose Play
  snapshot "${1%/*}-launch"
  expect ".active == \"$1\" and (.dashboard | not) and ($(status_of "$1" running)) and .display.shown == \"$1\" and .display.frame == .display.canvas"
  sandbox_globals=$(guest "WAYLAND_DISPLAY=$SOCKETS_DIR/$(game_name "$1")/wayland-0 wayland-info")
  echo "$sandbox_globals" | grep -q "'wl_compositor'" && ! echo "$sandbox_globals" | grep -q -e zwlr_layer_shell_v1 -e zwlr_screencopy_manager_v1 ||
    { log FAIL "$1 is not confined by its security context" >&2; exit 1; }
  log ok "$1 sees no privileged wayland protocols"
}

open_store() {
  choose Store
  expect '.screen == "store"'
}

change_resolution_in_settings() {
  choose Settings
  expect '.screen == "settings"'
  choose Resolution
  tap dpright
  expect '.settings.resolution == 720 and .display.canvas == "1280x720"'
  tap dpright
  expect '.settings.resolution == 1080 and .display.canvas == "1920x1080" and .display.filter == "linear"'
  snapshot settings
  api POST settings "resolution 0" >/dev/null
  expect '.settings.resolution == 0 and .display.canvas == .display.area'
  ! api POST settings "resolution 1" 2>/dev/null || { log FAIL "accepted a resolution outside RESOLUTIONS" >&2; exit 1; }
  log ok "rejected a resolution outside RESOLUTIONS"
  tap b
  expect '.screen == "home"'
}

switch_gpu_after_games() {
  second=$(state | jq -r '.display as $display | $display.displays[] | select(.gpu != $display.gpu) | .label')
  api POST settings "display $second" >/dev/null
  expect ".display.pending == \"$second\" and any(.notifications[]; startswith(\"Close and restart your games\")) and .display.shown == \"$1\""
  guest games stop
  expect ".display.pending == null and .display.display == \"$second\" and .display.area == \"${SECOND_DISPLAY_WIDTH}x$SECOND_DISPLAY_HEIGHT\" and .screen == \"home\""
  api POST settings "resolution 720" >/dev/null
  expect '.display.canvas == "1280x720" and .display.filter == "pixel"'
  api POST settings "display" >/dev/null
  expect ".settings.display == \"\" and .display.display == \"$second\""
}

remember_guide_position() {
  tap guide
  expect '.guide and .screen == "guide" and .rows[.selected].label == "Rewind"'
  highlight Volume
  tap guide
  expect '.guide | not'
  tap guide
  expect '.guide and .rows[.selected].label == "Volume"'
  tap guide
  expect '.guide | not'
}

rewind_to_older_state() {
  expect '.rewind.states >= 2'
  wait_for $STEP_SECONDS guest "[ \$(ls $REWIND_DIR/$(game_name "$1")/states/*.screen.png | wc -l) -ge 2 ]"
  log ok "the saved $1 states have screen captures"
  tap guide
  expect ".guide and .rows[1].label == \"Rewind\" and .rows[.selected].label == \"Rewind\" and .rewind.back == 0 and ($(status_of "$1" paused))"
  tap dpleft
  expect '.rewind.back == 1 and .rows[.selected].value != "Now"'
  tap guide
  expect "(.guide | not) and ($(status_of "$1" running))"
  tap guide
  expect '.guide and .rewind.back == 0 and .rows[.selected].label == "Rewind" and .rows[.selected].value == "Now"'
  snapshot rewind-now
  tap dpleft
  tap dpleft
  expect '.rewind.back == 2'
  snapshot rewind
  states=$(state | jq .rewind.states)
  tap a
  expect "(.guide | not) and .rewind.states == $((states - 1)) and .rewind.back == 0 and ($(status_of "$1" running))"
  wait_for $STEP_SECONDS guest "grep -q 'Loading state' $LOG_DIR/$(game_name "$1").log"
  log ok "rewound $1 to an older state"
}

play_every_other_game() {
  for directory in "$TEST_STORE"/*/*/; do
    key=${directory#"$TEST_STORE/"}
    key=${key%/}
    holds "$(status_of "$key" "")" >/dev/null || continue
    title=$(jq -r .title "$TEST_STORE/${key%/*}/manifest.json")
    open_store
    install_game "$key" "$title"
    play_game "$key"
    snapshot "$(game_name "$key")"
    back_to_dashboard
    expect "$(status_of "$key" paused)"
    choose "$title"
    choose Close
    expect "$(status_of "$key" installed)"
    tap b
    expect '.screen == "home"'
  done
}

back_to_dashboard() {
  tap guide
  expect '.guide and .screen == "guide"'
  choose Dashboard
  expect '.dashboard and (.guide | not) and .screen == "home"'
}

start_vm
install_from_stick
wait_for $BOOT_SECONDS booted 1
expect '.screen == "home" and .dashboard and (.rows | length) == 2 and (.display.displays | length) == 2 and .display.canvas == .display.area and .display.filter == "nearest"'
snapshot home
wait_for $STEP_SECONDS guest ". /etc/profile; WAYLAND_DISPLAY=wayland-0 grim /tmp/home.png && [ -s /tmp/home.png ]"
log ok "grim captures the idle screen"
change_resolution_in_settings

api POST stores "$TEST_STORE_URL" >/dev/null
expect '.stores[0].online and ([.games[].key] | index("alter-ego/nes") != null)'

open_store
install_game alter-ego/nes "Alter Ego"
play_game alter-ego/nes
snapshot alter-ego
api POST settings "resolution 1080" >/dev/null
expect ".display.canvas == \"1920x1080\" and .display.frame == .display.canvas and ($(status_of alter-ego/nes running))"
snapshot alter-ego-1080
api POST settings "resolution 0" >/dev/null
expect ".display.canvas == .display.area and .display.frame == .display.canvas and ($(status_of alter-ego/nes running))"
wait_for $STEP_SECONDS guest ". /etc/profile; pw-dump | jq -e '[.[] | select(.info.props[\"media.class\"]? == \"Stream/Output/Audio\" and .info.state == \"running\")] | length == 1'"
log ok "the game plays sound into PipeWire"
remember_guide_position

tap guide
expect ".guide and .screen == \"guide\" and ($(status_of alter-ego/nes paused)) and .audio.output != \"\""
snapshot guide
choose Dashboard
expect '.dashboard and (.guide | not) and .screen == "home"'

open_store
install_game lan-master/nes "LAN Master"
play_game lan-master/nes
expect "$(status_of alter-ego/nes paused)"

key KEY_LEFTMETA
expect ".guide and ($(status_of lan-master/nes paused))"
tap b
expect "(.guide | not) and ($(status_of lan-master/nes running))"
send "1 back 1" "1 start 1" "1 start 0" "1 back 0"
expect '.guide'
tap guide
expect "(.guide | not) and ($(status_of lan-master/nes running))"

back_to_dashboard
choose "Alter Ego"
choose Resume
expect ".active == \"alter-ego/nes\" and ($(status_of alter-ego/nes running)) and ($(status_of lan-master/nes paused))"

back_to_dashboard
choose "LAN Master"
choose Close
expect "$(status_of lan-master/nes installed)"
choose Uninstall
expect '[.games[] | select(.key == "lan-master/nes")] | all(.status == "")'

tap b
open_store
install_game commander-keen/msdos "Commander Keen"
play_game commander-keen/msdos
expect '.rewind.states >= 1'
key KEY_ENTER
snapshot keen
rewind_to_older_state commander-keen/msdos
key KEY_LEFTMETA
expect ".guide and ($(status_of commander-keen/msdos paused))"
tap guide

api POST volume $TEST_VOLUME >/dev/null
expect ".audio.volume == $TEST_VOLUME"

api DELETE stores/1 >/dev/null
expect '(.stores | length) == 0 and all(.games[]; (.stores | length) == 0)'
expect '[.games[] | select(.key == "alter-ego/nes" or .key == "commander-keen/msdos") | .status != ""] | length == 2 and all'
api POST stores "$TEST_STORE_URL" >/dev/null
expect '.stores[0].online and all(.games[]; (.stores | length) == 1)'

switch_gpu_after_games commander-keen/msdos
play_every_other_game

guest reboot
wait_for $BOOT_SECONDS booted 2
expect "($(status_of alter-ego/nes installed)) and ($(status_of commander-keen/msdos installed)) and .settings.resolution == 720"
log PASS "v$VERSION installed from USB, installed games from the store, played, switched, closed, uninstalled, rescaled, moved to another GPU once games quit, and kept them across a reboot"
