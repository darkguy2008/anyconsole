  if [ ! -f "$TEST_BIOS/$REDREAM_LICENSE" ]; then
    log skip "rewinding $1: no redream premium key at $TEST_BIOS/$REDREAM_LICENSE on the build host"
    return
  fi
  wait_for $STEP_SECONDS redream_preloaded
  expect '.rewind.states >= 1'
  vmus="$(saves_of "$1")/vmu*.bin"
  saved=$(guest "md5sum $vmus")
  guest "for vmu in $vmus; do printf x >> \$vmu; done"
  open_rewind_row "$1"
  tap dpleft
  expect '.rewind.back == 1'
  tap a
  expect "(.guide | not) and .rewind.back == 0 and ($(status_of "$1" running))"
  wait_for $STEP_SECONDS redream_read_loaded_state "$1"
  [ "$(guest "md5sum $vmus")" = "$saved" ] || { log FAIL "rewinding did not put back the VMUs the state was saved with" >&2; diagnose; exit 1; }
  log ok "rewinding put back the VMUs the state was saved with"
  guest "! grep -q '^\[[A-Z]*\] *SAVE ' $(game_log "$1")" || { log FAIL "redream logged a save state error" >&2; diagnose; exit 1; }
  wait_for $STEP_SECONDS screen_moves
  expect "$(status_of "$1" running)"
