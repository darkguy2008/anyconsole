#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. ./config
. guest/config
. build/slot
. guest/oci
VERSION=$(cat VERSION)
TEST_OUT=build/out/test
TEST_IMAGE=$TEST_IMAGE_PREFIX-${PWD##*/}
FAKEPAD_TAR=$TEST_OUT/fakepad.tar
TEST_SUBNET=${OTA_HOST%.*}
TEST_SMB_SERVER=$TEST_SUBNET.4
TEST_STORE_URL=smb://$TEST_SMB_SERVER/qemu
RSYNC_PORT=873
ENGINE_LIST=rel/$ENGINES_MODULE/contracts/$(engine_contract .)
TEST_VMS=4
TARGET_SIZE=16G
POLLS_PER_SECOND=10
SSH_ALIVE_SECONDS=1
POLL_INTERVAL=$(awk "BEGIN { print 1 / $POLLS_PER_SECOND }")
STEP_SECONDS=15
BOOT_SECONDS=180
INSTALL_SECONDS=1200
STARTED=$(date +%s)
TEST_VOLUME=10
SECOND_DISPLAY_WIDTH=1920
SECOND_DISPLAY_HEIGHT=1080
FAKEPAD_IMAGE=anyconsole-fakepad
FAKEPAD_NAME="PS4 Controller"
FAKEPAD_CROSS=2
REMOTE_PAD="$REMOTE_PAD_NAME 1"
SECOND_REMOTE_PAD="$REMOTE_PAD_NAME 2"
LOW_BATTERY=10
DEFAULT_SLEEP=${SLEEP_MINUTES%% *}
STRONG_RUMBLE_EFFECT=4
REDREAM_ENGINE=$ENGINES/dreamcast/engine
REDREAM_LICENSE=dreamcast/redream.key
VIRGL_GPU=virtio_gpu
PNG_SIGNATURE=89504e470d0a1a0a
REAL_GAMES=/tmp/real-games
PACED_GAMES=/tmp/paced-games
INSTALL_STEPS=/tmp/install-steps
HALFWAY_PERCENT=50
AREA_SIZE='(.display.area_box | "\(.width)x\(.height)")'

monitor() { echo "$1" | socat - UNIX-CONNECT:$OUT/monitor.sock >/dev/null; }
guest() {
  with_password ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR -o ConnectTimeout=1 -o ServerAliveInterval=$SSH_ALIVE_SECONDS -o ServerAliveCountMax=$((STEP_SECONDS / SSH_ALIVE_SECONDS)) -o ControlMaster=auto -o ControlPath=$OUT/ssh.sock -o ControlPersist=yes \
    -p $VM_SSH_PORT root@127.0.0.1 "$@"
}
api_url() { echo "127.0.0.1:$VM_API_PORT/cgi-bin/api/$1"; }
api() { curl -fsS -X "$1" --data-binary "${3:-}" "$(api_url "$2")"; }
state() { api GET state; }
expect_reply() {
  seconds=$1 status=$2 filter=$3
  shift 3
  code=$(jq -n '$ARGS.named' "$@" | curl -sS -m "$seconds" -X POST --data-binary @- -o $OUT/reply.json -w '%{http_code}' "$(api_url action)") || code=$?
  if [ "$code" != "$status" ] || ! jq -e "$filter" $OUT/reply.json >/dev/null; then
    log FAIL "$* did not answer $status with: $filter, got $code: $(cat $OUT/reply.json 2>&1)" >&2
    diagnose
    exit 1
  fi
  log ok "$filter"
}
screenshot_is_png() {
  curl -fsS -m $STEP_SECONDS -o $OUT/screenshot.png "$(api_url screenshot)" &&
    [ "$(od -An -tx1 -N8 $OUT/screenshot.png | tr -d ' \n')" = $PNG_SIGNATURE ]
}
log() { echo "$1 +$(($(date +%s) - STARTED))s${slot:+ vm $slot}: $2"; }
diagnose() {
  guest "cat $STATE_FILE /tmp/install.log; echo; docker ps -a --format '{{.Names}} {{.Status}}'; for container in \$(docker ps -q); do docker top \$container -o pid,stat,args; for pid in \$(docker top \$container -o pid | tail -n +2); do echo \"\$pid \$(cat /proc/\$pid/wchan)\"; done; done; for log in $LOG_DIR/*.log; do echo \"== \$log\"; tail -n 15 \"\$log\"; done" >&2 || true
  guest ". /etc/profile; wpctl status; pw-dump | jq -c '.[] | select(.info.props[\"media.class\"]? == \"Audio/Source\") | {id, props: [.info.params.Props[]? | {channelVolumes, softVolumes, volume}]}'" >&2 || true
}
wait_for() {
  attempts=$(($1 * POLLS_PER_SECOND)) attempt=0
  shift
  until "$@" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    [ $attempt -le $attempts ] || { log FAIL "timed out waiting for: $*" >&2; diagnose; exit 1; }
    sleep $POLL_INTERVAL
  done
}
exec 4>&2
holds() {
  verdict=0
  state | jq -e "$1" 2>&4 || verdict=$?
  case $verdict in
    0|1|4) return $verdict ;;
    *) log FAIL "jq could not evaluate: $1" >&4; exit 1 ;;
  esac
}
expect() { wait_for $STEP_SECONDS holds "$1"; log ok "$1"; }
game_name() { echo "${1%/*}-${1#*/}"; }
game_log() { echo "$LOG_DIR/$(game_name "$1").log"; }
saves_of() { echo "$PROFILES_DIR/1/saves/$(game_name "$1")"; }
status_of() { echo "(.games[] | select(.key == \"$1\") | .status == \"$2\")"; }
close_by_action() { expect_reply $STEP_SECONDS 200 ".ok and (.state | $(status_of "$1" installed))" --arg action close --arg game "$1"; }
row_value() { echo ".rows[] | select(.label == \"$1\") | .value"; }
send() { api POST input "$(printf '%s\n' "$@")" >/dev/null; }
tap() { send "${PAD:-1} $1 1" "${PAD:-1} $1 0"; }
device_named() { echo ".controllers.devices[] | select(.name == \"$1\")"; }
device_id() {
  wait_for $STEP_SECONDS holds "[$(device_named "$1")] != []"
  state | jq "$(device_named "$1") | .id"
}
device_mode() { echo "($(device_named "$1") | .mode)"; }
players() { echo "[.session.players[].profile]"; }
key() { send "EV_KEY $1 1" "EV_KEY $1 0"; }
highlight() {
  wait_for $STEP_SECONDS holds "[.rows[].label] | index(\"$1\") != null"
  while current=$(state); [ "$(echo "$current" | jq -r '.rows[.selected].label')" != "$1" ]; do
    target=$(echo "$current" | jq "[.rows[].label] | index(\"$1\")")
    selected=$(echo "$current" | jq .selected)
    [ "$target" != null ] || { log FAIL "no row $1" >&2; diagnose; exit 1; }
    if [ "$selected" -lt "$target" ]; then tap dpdown; else tap dpup; fi
    wait_for $STEP_SECONDS holds ".selected != $selected or ([.rows[].label] | index(\"$1\")) != $target"
  done
}
adjust_to() {
  while current=$(state | jq -r "$(row_value "$1")"); [ "$current" != "$2" ]; do
    tap dpright
    wait_for $STEP_SECONDS holds "$(row_value "$1") != \"$current\""
  done
}
choose() {
  highlight "$1"
  tap a
}
capture() { gvnccapture "127.0.0.1:$VM_VNC_DISPLAY" "$OUT/$1.png"; }
snapshot() { wait_for $STEP_SECONDS capture "$1"; }
screen_moves() { capture before && capture after && ! cmp -s "$OUT/before.png" "$OUT/after.png"; }
booted() { guest "grep -q VERSION=$VERSION /etc/anyconsole-release && [ \$(cat /data/boots) = $1 ] && pidof overlay && [ -s $STATE_FILE ]"; }

start_vm() {
  claim_slot
  OUT=$TEST_OUT/$slot
  rm -rf $OUT
  mkdir -p $OUT
  serve_engines
  truncate -s $TARGET_SIZE $OUT/target.img
  cp $OVMF_VARS $OUT/efivars.fd
  run_qemu $OUT/efivars.fd $OUT/target.img \
    "hostfwd=tcp:127.0.0.1:$VM_SSH_PORT-:22,hostfwd=tcp:127.0.0.1:$VM_API_PORT-:$API_PORT,net=$TEST_SUBNET.0/24,smbserver=$TEST_SMB_SERVER,guestfwd=tcp:$OTA_HOST:$RSYNC_PORT-cmd:rsync --daemon --config=$PWD/$OUT/rsyncd.conf" \
    -device qemu-xhci -drive file=build/out/installer.img,format=raw,if=none,id=usb0,snapshot=on -device usb-storage,drive=usb0,id=stick \
    -device virtio-gpu-pci,xres=$SECOND_DISPLAY_WIDTH,yres=$SECOND_DISPLAY_HEIGHT -vnc :$VM_VNC_DISPLAY -monitor unix:$OUT/monitor.sock,server,nowait -serial file:$OUT/serial.log &
  trap 'monitor quit; [ ! -p $OUT/gate ] || release_downloads' EXIT
}

install_from_stick() {
  wait_for $BOOT_SECONDS guest true
  for key in 1 ret y ret; do monitor "sendkey $key"; done
  wait_for $BOOT_SECONDS guest 'findfs LABEL=data && ! pidof mkdisk'
  monitor "device_del stick"
  monitor "sendkey ret"
}

start_install() {
  choose "$1"
  expect '.screen == "game"'
  choose "Install from"
}

finish_install() {
  wait_for $INSTALL_SECONDS holds "$(status_of "$1" installed)"
  log ok "installed $1"
}

install_game() {
  start_install "$2"
  finish_install "$1"
}

ensure_installed() {
  if holds "$(status_of "$1" "")" >/dev/null; then
    open_store
    install_game "$1" "$2"
    tap b
    expect '.screen == "store"'
    tap b
    expect '.screen == "home"'
  fi
}

uninstall_game() {
  choose Uninstall
  expect "[.games[] | select(.key == \"$1\")] | all(.status == \"\")"
}

pace_installs() {
  guest "cp /bin/games $REAL_GAMES && mkfifo $INSTALL_STEPS && cat > $PACED_GAMES && chmod +x $PACED_GAMES && nsenter -t \$(pidof overlay) -m mount --bind $PACED_GAMES /bin/games" <<PACED
#!/bin/sh
[ "\$1" = install ] || exec $REAL_GAMES "\$@"
while step=\$(cat $INSTALL_STEPS) && [ -n "\$step" ]; do echo "\$step"; done
exec $REAL_GAMES "\$@"
PACED
}
install_step() {
  guest "timeout $STEP_SECONDS sh -c 'echo $1 > $INSTALL_STEPS'" || { log FAIL "no install read the step \"$1\" within ${STEP_SECONDS}s" >&2; diagnose; exit 1; }
}
unpace_installs() { guest "nsenter -t \$(pidof overlay) -m umount /bin/games && rm $REAL_GAMES $PACED_GAMES $INSTALL_STEPS"; }

install_watching_home() {
  row=$(row_value "$2")
  pace_installs
  start_install "$2"
  install_step "copying 0"
  expect "$(status_of "$1" "copying 0%")"
  tap b
  expect '.screen == "store"'
  tap b
  expect ".screen == \"home\" and ($row) == \"${1#*/}  copying 0%\""
  install_step "copying $HALFWAY_PERCENT"
  expect "($row) == \"${1#*/}  copying $HALFWAY_PERCENT%\""
  log ok "the home list followed $1's install progress"
  install_step ""
  finish_install "$1"
  unpace_installs
  choose "$2"
  expect '.screen == "game"'
}

play_game() {
  choose Play
  snapshot "${1%/*}-launch"
  expect ".active == \"$1\" and (.dashboard | not) and ($(status_of "$1" running)) and .display.shown == \"$1\" and .display.frame != \"\""
  sandbox_globals=$(guest "WAYLAND_DISPLAY=$SOCKETS_DIR/$(game_name "$1")/wayland-0 wayland-info")
  echo "$sandbox_globals" | grep -q "'wl_compositor'" && ! echo "$sandbox_globals" | grep -q -e zwlr_layer_shell_v1 -e zwlr_screencopy_manager_v1 \
    -e ext_foreign_toplevel_list_v1 -e ext_image_copy_capture_manager_v1 -e ext_foreign_toplevel_image_capture_source_manager_v1 ||
    { log FAIL "$1 is not confined by its security context" >&2; exit 1; }
  log ok "$1 sees no privileged wayland protocols"
}

open_store() {
  choose Store
  expect '.screen == "store"'
}

change_resolution_in_settings() {
  choose Settings
  expect '.screen == "settings"'
  highlight "Game resolution"
  tap dpright
  expect "any(.rows[]; .label == \"Apply\") and (.settings.resolution // 0) == 0 and .display.canvas == $AREA_SIZE"
  choose Apply
  expect '.settings.resolution == 720 and .display.canvas == "1280x720" and all(.rows[]; .label != "Apply")'
  highlight "Game resolution"
  tap dpright
  choose Apply
  expect '.settings.resolution == 1080 and .display.canvas == "1920x1080" and .display.filter == "linear"'
  snapshot settings
  api POST settings "resolution 0" >/dev/null
  expect ".settings.resolution == 0 and .display.canvas == $AREA_SIZE"
  ! api POST settings "resolution 1" 2>/dev/null || { log FAIL "accepted a resolution outside RESOLUTIONS" >&2; exit 1; }
  log ok "rejected a resolution outside RESOLUTIONS"
  tap b
  expect '.screen == "home"'
}

stage_mode() {
  highlight "Display resolution"
  for tap in $(seq $taps); do tap dpright; done
}

stage_display_mode_until_saved() {
  read -r auto taps chosen <<MODES
$(state | jq -r '.display.mode as $mode | ([.display.modes[] | . != $mode] | index(true)) as $index | "\($mode) \($index + 1) \(.display.modes[$index])"')
MODES
  choose Settings
  stage_mode
  expect "any(.rows[]; .label == \"Apply\") and .display.mode == \"$auto\" and (.settings.mode // \"\") == \"\""
  tap b
  expect ".screen == \"home\" and .display.mode == \"$auto\" and (.settings.mode // \"\") == \"\""
  choose Settings
  expect '.screen == "settings" and all(.rows[]; .label != "Apply")'
  stage_mode
  choose Apply
  expect ".settings.mode == \"$chosen\" and .display.mode == \"$chosen\" and all(.rows[]; .label != \"Apply\") and .rows[.selected].label == \"Display resolution\""
  api POST settings "mode" >/dev/null
  expect ".settings.mode == \"\" and .display.mode == \"$auto\""
  tap b
  expect '.screen == "home"'
}

switch_gpu_after_games() {
  second=$(state | jq -r '.display as $display | $display.displays[] | select(.label != $display.display) | .label')
  api POST settings "display $second" >/dev/null
  expect ".display.pending == \"$second\" and any(.notifications[]; startswith(\"Close and restart your games\")) and .display.shown == \"$1\""
  guest games stop
  expect ".display.pending == null and .display.display == \"$second\" and $AREA_SIZE == \"${SECOND_DISPLAY_WIDTH}x$SECOND_DISPLAY_HEIGHT\" and .screen == \"home\""
  api POST settings "resolution 720" >/dev/null
  expect '.display.canvas == "1280x720" and .display.filter == "pixel"'
  api POST settings "display" >/dev/null
  expect ".settings.display == \"\" and .display.display == \"$second\""
}

remember_guide_position() {
  tap guide
  expect '.guide and .screen == "guide" and .rows[.selected].label == "Rewind"'
  highlight Volume
  tap guide
  expect '.guide | not'
  tap guide
  expect '.guide and .rows[.selected].label == "Volume"'
  tap guide
  expect '.guide | not'
}

apply_resolution_from_guide() {
  tap guide
  expect '.guide and .screen == "guide"'
  highlight "Game resolution"
  tap dpright
  expect '(.settings.resolution // 0) == 0 and any(.rows[]; .label == "Apply")'
  choose Apply
  expect '.settings.resolution == 720 and .display.canvas == "1280x720" and all(.rows[]; .label != "Apply")'
  api POST settings "resolution 0" >/dev/null
  expect ".settings.resolution == 0 and .display.canvas == $AREA_SIZE"
  tap guide
  expect '.guide | not'
}

open_rewind_row() {
  tap guide
  expect ".guide and .rows[1].label == \"Rewind\" and .rewind.back == 0 and ($(status_of "$1" paused))"
  highlight Rewind
}

rewind_to_older_state() {
  if [ "$(state | jq -r .display.gpu)" = "$VIRGL_GPU" ]; then
    log skip "rewinding $1: virgl reads the overlay's shared capture buffer back as black until Mesa ships virgl-exported-readback"
    return
  fi
  expect '.rewind.states >= 2'
  wait_for $STEP_SECONDS guest "[ \$(ls $REWIND_DIR/$(game_name "$1")/states/*.screen.png | wc -l) -ge 2 ]"
  log ok "the saved $1 states have screen captures"
  open_rewind_row "$1"
  tap dpleft
  expect '.rewind.back == 1 and .rows[.selected].value != "Now"'
  tap guide
  expect "(.guide | not) and ($(status_of "$1" running))"
  tap guide
  expect '.guide and .rewind.back == 0 and .rows[.selected].label == "Rewind" and .rows[.selected].value == "Now"'
  snapshot rewind-now
  tap dpleft
  tap dpleft
  expect '.rewind.back == 2'
  snapshot rewind
  states=$(state | jq .rewind.states)
  tap a
  expect "(.guide | not) and .rewind.states == $((states - 1)) and .rewind.back == 0 and ($(status_of "$1" running))"
  wait_for $STEP_SECONDS guest "grep -q 'Loading state' $(game_log "$1") && ! grep -q 'Failed to load state' $(game_log "$1")"
  log ok "rewound $1 to an older state"
}

install_and_play() {
  ensure_installed "$1" "$2"
  choose "$2"
  play_game "$1"
}

close_game() {
  back_to_dashboard
  expect "$(status_of "$1" paused)"
  choose "$2"
  expect '.screen == "game"'
  choose Close
  expect "$(status_of "$1" installed)"
  tap b
  expect '.screen == "home"'
}

game_container() { echo "\$(docker ps -q --filter label=$GAME_LABEL=$1)"; }

core_options_hold() {
  guest "docker exec $(game_container "$1") cat /tmp/core.opt" |
    jq -nRe --argjson options "$2" '[inputs] as $lines | $options | to_entries | all("\(.key) = \"\(.value)\"" as $line | $lines | any(. == $line))'
}

play_every_other_game() {
  for directory in "$TEST_STORE"/*/*/; do
    key=${directory#"$TEST_STORE/"}
    key=${key%/}
    holds "$(status_of "$key" "")" >/dev/null || continue
    title=$(jq -r .title "$TEST_STORE/${key%/*}/manifest.json")
    install_and_play "$key" "$title"
    snapshot "$(game_name "$key")"
    wait_for $STEP_SECONDS core_options_hold "$key" "$(jq -c --arg platform "${key#*/}" '.[$platform].options // {}' "$TEST_STORE/${key%/*}/manifest.json")"
    log ok "$key core options reached RetroArch"
    close_game "$key" "$title"
  done
}

save_fakepad() (
  flock 7
  [ ! -f $FAKEPAD_TAR ] || exit 0
  docker build -q --network host -t "$TEST_IMAGE:$FAKEPAD_IMAGE" build/fakepad >/dev/null
  docker save -o $FAKEPAD_TAR.part "$TEST_IMAGE:$FAKEPAD_IMAGE"
  mv $FAKEPAD_TAR.part $FAKEPAD_TAR
) 7>"$TEST_OUT/fakepad.lock"

preload_fakepad() {
  save_fakepad
  guest "docker load -q" < $FAKEPAD_TAR >/dev/null
  guest "docker tag $TEST_IMAGE:$FAKEPAD_IMAGE $FAKEPAD_IMAGE && docker image rm $TEST_IMAGE:$FAKEPAD_IMAGE >/dev/null"
  log ok "preloaded the fakepad"
}
serve_engines() {
  cp -al build/out/rel $OUT/rel
  touch $OUT/rsyncd.log
  served=$PWD/$OUT
  cat > $OUT/hold-blobs <<HOLD
[ "\$RSYNC_REQUEST" != $ENGINES_MODULE/ ] || [ ! -p $served/gate ] || { touch $served/held; cat $served/gate >/dev/null; }
HOLD
  releases_rsyncd_conf "$served/rel" "log file = $served/rsyncd.log" "transfer logging = yes" "pre-xfer exec = sh $served/hold-blobs" > $OUT/rsyncd.conf
}
hold_downloads() { rm -f $OUT/held; mkfifo $OUT/gate; }
download_held() { [ -e $OUT/held ]; }
console_sees_nes() { [ "$(guest "jq -r '.manifests[0].digest' $ENGINE_IMAGES/published/nes.json")" = "$(published_digest $OUT/$ENGINE_LIST/nes.json)" ]; }
release_downloads() { exec 3<>$OUT/gate; rm $OUT/gate; exec 3>&-; }
publish_nes() { cp "$1" $OUT/$ENGINE_LIST/nes.json.new && mv $OUT/$ENGINE_LIST/nes.json.new $OUT/$ENGINE_LIST/nes.json; }
console_nes() { guest "docker image inspect -f '{{.Id}}' $GAME_IMAGE/nes"; }
nes_is_published() { [ "$(console_nes)" = "$(published_digest $OUT/$ENGINE_LIST/nes.json)" ]; }
build_prepared_nes() {
  { cat app/recipes/Dockerfile; cat <<'STAGE'; } > $OUT/Dockerfile
FROM nes AS nes-prepared
RUN printf '#!/bin/sh\ntouch /engine/prepared\n' > /prepare && chmod +x /prepare
VOLUME /engine
LABEL anyconsole.prepare=/prepare
STAGE
  export_engine_image "docker.io/$GAME_IMAGE/nes:latest" $OUT/prepared -f $OUT/Dockerfile --target nes-prepared app/recipes
  rsync -a --ignore-existing $OUT/prepared/blobs/ $OUT/rel/$ENGINES_MODULE/blobs/
  jq '.manifests |= [last]' $OUT/prepared/index.json > $OUT/prepared-nes.json
}
act_in_background() {
  reply=$OUT/$1.json
  shift
  jq -n '$ARGS.named' "$@" | curl -sS -m $INSTALL_SECONDS -X POST --data-binary @- -o "$reply" "$(api_url action)"
}
replied() {
  jq -e "$2" $OUT/$1.json >/dev/null || { log FAIL "$1 did not answer: $2, got: $(cat $OUT/$1.json 2>&1)" >&2; diagnose; exit 1; }
  log ok "$1: $2"
}
leave_game() {
  ! holds "$(status_of "$1" running) or $(status_of "$1" paused)" >/dev/null ||
    close_by_action "$1"
  ! holds "$(status_of "$1" installed)" >/dev/null ||
    expect_reply $STEP_SECONDS 200 ".ok and (.state | $(status_of "$1" ''))" --arg action uninstall --arg game "$1"
}
blobs_fetched_since() { tail -n +$(($1 + 1)) $OUT/rsyncd.log | grep -o 'blobs/[^ ]*'; }

install_nes_twice_at_once() {
  leave_game alter-ego/nes
  leave_game lan-master/nes
  wait_for $STEP_SECONDS guest "[ -z \"\$(docker image ls -q $GAME_IMAGE/nes)\" ] && [ ! -e $ENGINE_IMAGES/loaded/nes.json ]"
  log ok "uninstalling the last nes game deleted the nes engine"
  logged=$(wc -l < $OUT/rsyncd.log)
  act_in_background install-alter-ego --arg action install --arg game alter-ego/nes & first=$!
  act_in_background install-lan-master --arg action install --arg game lan-master/nes & second=$!
  wait $first
  wait $second
  replied install-alter-ego ".ok and (.state | $(status_of alter-ego/nes installed))"
  replied install-lan-master ".ok and (.state | $(status_of lan-master/nes installed))"
  fetched=$(blobs_fetched_since "$logged")
  [ -n "$fetched" ] && [ -z "$(echo "$fetched" | sort | uniq -d)" ] ||
    { log FAIL "the two nes installs did not download each engine blob exactly once" >&2; diagnose; exit 1; }
  log ok "two nes installs at once downloaded the nes engine once"
}

update_nes_in_background() {
  logged=$(wc -l < $OUT/rsyncd.log)
  blobs_of $OUT/rel/$ENGINES_MODULE $OUT/nes.json > $OUT/nes-blobs
  publish_nes $OUT/prepared-nes.json
  wait_for $STEP_SECONDS nes_is_published
  wait_for $STEP_SECONDS guest "[ -f $ENGINES/nes/engine/prepared ]"
  fetched=$(blobs_fetched_since "$logged")
  [ -n "$fetched" ] && [ -z "$(echo "$fetched" | grep -xFf $OUT/nes-blobs)" ] ||
    { log FAIL "the nes update downloaded blobs the console already had" >&2; diagnose; exit 1; }
  log ok "the console updated its nes engine in the background with only the new blobs and ran its prepare hook"
}

launch_waits_for_background_download() {
  hold_downloads
  publish_nes $OUT/nes.json
  wait_for $STEP_SECONDS download_held
  act_in_background play-alter-ego --arg action play --arg game alter-ego/nes & playing=$!
  expect "$(status_of alter-ego/nes "downloading 0%")"
  release_downloads
  wait $playing
  replied play-alter-ego ".ok and (.state | $(status_of alter-ego/nes running))"
  nes_is_published
  log ok "the launch followed the background download, then played"
  close_by_action alter-ego/nes
}

cancel_launch_download() {
  expect_reply $STEP_SECONDS 200 ".ok and (.state | $(status_of lan-master/nes running))" --arg action play --arg game lan-master/nes
  before=$(console_nes)
  hold_downloads
  publish_nes $OUT/prepared-nes.json
  wait_for $STEP_SECONDS console_sees_nes
  act_in_background play-alter-ego --arg action play --arg game alter-ego/nes & playing=$!
  wait_for $STEP_SECONDS download_held
  expect "$(status_of alter-ego/nes "downloading 0%")"
  tap b
  wait $playing
