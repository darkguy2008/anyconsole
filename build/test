  case " $TESTS " in
    *" $name "*) ;;
    *) log FAIL "no test named $name, tests are: $TESTS" >&2; exit 1 ;;
  esac
done

run_tests() {
  start_vm
  install_from_stick
  wait_for $BOOT_SECONDS booted 1
  log ok "booted v$VERSION from the installed disk"
  push_test_bios
  preload_fakepad
  sign_in_from_attract
  expect ".screen == \"home\" and .dashboard and (.rows | length) == 2 and (.display.displays | length) == 2 and .display.canvas == $AREA_SIZE and .display.filter == \"nearest\""
  api POST stores "$TEST_STORE_URL" >/dev/null
  expect '.stores[0].online and ([.games[].key] | index("alter-ego/nes") != null)'
  for name; do "test_$name"; done
  log PASS "v$VERSION installed from USB, then passed: $*"
}

sh build/store
sh build/engines build
mkdir -p $TEST_OUT
rm -f $FAKEPAD_TAR
pids=
for vm in $(seq $TEST_VMS); do
  group=$(echo $names | awk -v vms=$TEST_VMS -v vm=$vm '{ for (name = vm; name <= NF; name += vms) printf "%s ", $name }')
  [ -z "$group" ] || { (run_tests $group) & pids="$pids $!"; }
done
failed=0
for pid in $pids; do wait $pid || failed=1; done
[ $failed = 0 ] || { log FAIL "a test VM failed, see its lines above" >&2; exit 1; }
log PASS "v$VERSION passed: $names"
