  log ok "the launch followed the background download, then played"
  close_by_action alter-ego/nes
}

cancel_launch_download() {
  expect_reply $STEP_SECONDS 200 ".ok and (.state | $(status_of lan-master/nes running))" --arg action play --arg game lan-master/nes
  before=$(console_nes)
  hold_downloads
  publish_nes $OUT/prepared-nes.json
  wait_for $STEP_SECONDS console_sees_nes
  act_in_background play-alter-ego --arg action play --arg game alter-ego/nes & playing=$!
  wait_for $STEP_SECONDS download_held
  expect "$(status_of alter-ego/nes "downloading 0%")"
  tap b
  wait $playing
  replied play-alter-ego ".ok and (.state | ($(status_of alter-ego/nes installed)) and ($(status_of lan-master/nes paused) or $(status_of lan-master/nes running)) and all(.notifications[]; startswith(\"Could not start\") | not))"
  [ "$(console_nes)" = "$before" ] || { log FAIL "the cancelled launch changed the nes engine" >&2; diagnose; exit 1; }
  release_downloads
  log ok "Back cancelled the launch's download and kept the engine it had"
  close_by_action lan-master/nes
  wait_for $STEP_SECONDS nes_is_published
  log ok "with no game running, the console downloaded the cancelled engine in the background"
}

