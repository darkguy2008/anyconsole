serve_engines() {
  cp -al build/out/rel $OUT/rel
  touch $OUT/rsyncd.log
  served=$PWD/$OUT
  cat > $OUT/hold-blobs <<HOLD
[ "\$RSYNC_REQUEST" != $ENGINES_MODULE/ ] || [ ! -p $served/gate ] || { touch $served/held; cat $served/gate >/dev/null; }
HOLD
  releases_rsyncd_conf "$served/rel" "log file = $served/rsyncd.log" "transfer logging = yes" "pre-xfer exec = sh $served/hold-blobs" > $OUT/rsyncd.conf
}
hold_downloads() { rm -f $OUT/held; mkfifo $OUT/gate; }
download_held() { [ -e $OUT/held ]; }
console_sees_nes() { [ "$(guest "jq -r '.manifests[0].digest' $PUBLISHED_ENGINES/nes.json")" = "$(published_digest $OUT/$ENGINE_LIST/nes.json)" ]; }
release_downloads() { exec 3<>$OUT/gate; rm $OUT/gate; exec 3>&-; }
publish_nes() { cp "$1" $OUT/$ENGINE_LIST/nes.json.new && mv $OUT/$ENGINE_LIST/nes.json.new $OUT/$ENGINE_LIST/nes.json; }
nes_is_prepared() { [ "$(guest "cat $PREPARED/nes")" = "$(published_digest $OUT/$ENGINE_LIST/nes.json)" ]; }
prune_waits_for_other_downloads() {
  dangling=$(guest "docker create --name dangling $FAKEPAD_IMAGE >/dev/null && docker commit dangling && docker rm dangling >/dev/null")
  mkfifo $OUT/store-holder
  guest "flock -s $ENGINE_RUN/store.lock cat" < $OUT/store-holder > /dev/null & holder=$!
  exec 3>$OUT/store-holder
  wait_for $STEP_SECONDS guest "! flock -n -x $ENGINE_RUN/store.lock true"
  publish_nes $OUT/nes.json
  wait_for $STEP_SECONDS nes_is_prepared
  guest "docker image inspect $dangling >/dev/null" ||
    { log FAIL "a finished nes download pruned images while another download held the engine store" >&2; diagnose; exit 1; }
  exec 3>&-
  wait $holder
  rm $OUT/store-holder
  publish_nes $OUT/prepared-nes.json
  wait_for $STEP_SECONDS nes_is_prepared
  wait_for $STEP_SECONDS guest "! docker image inspect $dangling"
  log ok "an engine download prunes images only once no other download is loading one"
}
console_nes() { guest "docker image inspect -f '{{.Id}}' $GAME_IMAGE/nes"; }
nes_is_published() { [ "$(console_nes)" = "$(published_digest $OUT/$ENGINE_LIST/nes.json)" ]; }
build_prepared_nes() {
  { cat app/recipes/Dockerfile; cat <<'STAGE'; } > $OUT/Dockerfile
FROM nes AS nes-prepared
RUN printf '#!/bin/sh\ntouch /engine/prepared\n' > /prepare && chmod +x /prepare
VOLUME /engine
LABEL anyconsole.prepare=/prepare
STAGE
  export_engine_image "docker.io/$GAME_IMAGE/nes:latest" $OUT/prepared -f $OUT/Dockerfile --target nes-prepared app/recipes
  rsync -a --ignore-existing $OUT/prepared/blobs/ $OUT/rel/$ENGINES_MODULE/blobs/
  jq '.manifests |= [last]' $OUT/prepared/index.json > $OUT/prepared-nes.json
}
act_in_background() {
  reply=$OUT/$1.json
  shift
  jq -n '$ARGS.named' "$@" | curl -sS -m $INSTALL_SECONDS -X POST --data-binary @- -o "$reply" "$(api_url action)"
}
replied() {
  jq -e "$2" $OUT/$1.json >/dev/null || { log FAIL "$1 did not answer: $2, got: $(cat $OUT/$1.json 2>&1)" >&2; diagnose; exit 1; }
  log ok "$1: $2"
}
leave_game() {
  ! holds "$(status_of "$1" running) or $(status_of "$1" paused)" >/dev/null ||
    close_by_action "$1"
  ! holds "$(status_of "$1" installed)" >/dev/null ||
    expect_reply $STEP_SECONDS 200 ".ok and (.state | $(status_of "$1" ''))" --arg action uninstall --arg game "$1"
}
blobs_fetched_since() { tail -n +$(($1 + 1)) $OUT/rsyncd.log | grep -o 'blobs/[^ ]*'; }

install_nes_twice_at_once() {
  leave_game alter-ego/nes
  leave_game lan-master/nes
  wait_for $STEP_SECONDS guest "[ -z \"\$(docker image ls -q $GAME_IMAGE/nes)\" ] && [ ! -e $ENGINE_IMAGES/loaded/nes.json ]"
  log ok "uninstalling the last nes game deleted the nes engine"
  logged=$(wc -l < $OUT/rsyncd.log)
  act_in_background install-alter-ego --arg action install --arg game alter-ego/nes & first=$!
  act_in_background install-lan-master --arg action install --arg game lan-master/nes & second=$!
  wait $first
  wait $second
  replied install-alter-ego ".ok and (.state | $(status_of alter-ego/nes installed))"
  replied install-lan-master ".ok and (.state | $(status_of lan-master/nes installed))"
  fetched=$(blobs_fetched_since "$logged")
  [ -n "$fetched" ] && [ -z "$(echo "$fetched" | sort | uniq -d)" ] ||
    { log FAIL "the two nes installs did not download each engine blob exactly once" >&2; diagnose; exit 1; }
  log ok "two nes installs at once downloaded the nes engine once"
}

update_nes_in_background() {
  logged=$(wc -l < $OUT/rsyncd.log)
  blobs_of $OUT/rel/$ENGINES_MODULE $OUT/nes.json > $OUT/nes-blobs
  publish_nes $OUT/prepared-nes.json
  wait_for $STEP_SECONDS nes_is_published
  wait_for $STEP_SECONDS guest "[ -f $ENGINES/nes/engine/prepared ]"
  fetched=$(blobs_fetched_since "$logged")
  [ -n "$fetched" ] && [ -z "$(echo "$fetched" | grep -xFf $OUT/nes-blobs)" ] ||
    { log FAIL "the nes update downloaded blobs the console already had" >&2; diagnose; exit 1; }
  log ok "the console updated its nes engine in the background with only the new blobs and ran its prepare hook"
}

launch_waits_for_background_download() {
  hold_downloads
  publish_nes $OUT/nes.json
  wait_for $STEP_SECONDS download_held
