  expect ".display.canvas == $AREA_SIZE and .display.frame == .display.canvas and ($(status_of alter-ego/nes running))"
  wait_for $STEP_SECONDS guest ". /etc/profile; pw-dump | jq -e '[.[] | select(.info.props[\"media.class\"]? == \"Stream/Output/Audio\" and .info.state == \"running\")] | length == 1'"
  log ok "the game plays sound into PipeWire"
  remember_guide_position
  apply_resolution_from_guide
  blow_into_microphone
  change_emulation
  second_player_joins_and_leaves alter-ego/nes

  tap guide
  expect ".guide and .screen == \"guide\" and ($(status_of alter-ego/nes paused)) and .audio.output != \"\""
  snapshot guide
  choose Dashboard
  expect '.dashboard and (.guide | not) and .screen == "home"'

  install_and_play lan-master/nes "LAN Master"
  expect "$(status_of alter-ego/nes paused)"

  join_keyboard
  key KEY_LEFTMETA
  expect ".guide and ($(status_of lan-master/nes paused))"
