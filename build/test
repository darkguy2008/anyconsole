picture_frame() { height=$(state | jq ".display.canvas | $SIZE_NUMBERS | .[1]"); echo "$((height * $1 / $2))x$height"; }

ps2_nvm_holds() {
  bios=$(guest "sed -n 's/^BIOS = //p' $PCSX2_CONFIG/inis/PCSX2.ini")
  read -r language flags offset <<BYTES
$(guest "od -A n -t u1 -j $((PS2_CONFIG_BLOCK + 1)) -N 3 '$PCSX2_CONFIG/bios/${bios%.*}.nvm'")
BYTES
  language=$((language & PS2_LANGUAGE_BITS))
  minutes=$((((flags << PS2_OFFSET_HIGH_SHIFT) | offset) & ((1 << PS2_OFFSET_BITS) - 1)))
  [ $minutes -lt $((1 << (PS2_OFFSET_BITS - 1))) ] || minutes=$((minutes - (1 << PS2_OFFSET_BITS)))
  [ $language -eq "$1" ] && [ $((flags & PS2_INITIALIZED)) -ne 0 ] && [ $minutes -eq "$2" ] && [ $((flags & PS2_DAYLIGHT_SAVING)) -eq 0 ] ||
    { log FAIL "the BIOS settings of $bios hold language $language, flags $flags, offset $minutes minutes, not language $1, initialized, $2 minutes without daylight saving" >&2; exit 1; }
}

test_ps2() {
  if [ ! -d "$TEST_BIOS/ps2" ]; then
    log skip "ps2: no PS2 BIOS in $TEST_BIOS/ps2 on the build host"
    return
  fi
  key=cubes-demo/ps2
  api POST settings "game-language es_419" >/dev/null
  api POST settings "time-zone $TEST_ZONE" >/dev/null
  install_and_play $key "Cubes Demo"
  wait_for $PS2_BOOT_SECONDS analog_state_has $key "1 on locked"
  log ok "PCSX2's log shows $key locking its DualShock 2 in analog mode"
  guest "grep -q 'rom0:PS2LOGO' $(game_log $key)"
  ps2_nvm_holds $PS2_SPANISH $TEST_ZONE_MINUTES
  log ok "$key boots through the BIOS intro without its first-time setup, with Game language es_419 set to the BIOS's Spanish and the time zone's UTC offset"
  api POST settings "game-language en" >/dev/null
  expect ".display.frame == \"$(picture_frame 4 3)\""
  restart_into $key 'Loading GS' expect_reply $STEP_SECONDS 200 ".ok and .state.settings.picture == \"enhanced\" and (.state | $(closed_and_running $key))" --arg action picture --arg step -1
  expect ".display.frame == \"$(picture_frame 16 9)\""
  log ok "Enhanced restarts $key with its widescreen patch, loads the state it left, and the compositor widens its window to 16:9"
  restart_into $key 'Loading GS' api POST settings "picture original"
  expect ".display.frame == \"$(picture_frame 4 3)\""
  log ok "Original restarts $key in its 4:3 window and loads the state it left"
  ps2_nvm_holds $PS2_ENGLISH $TEST_ZONE_MINUTES
  api POST settings "game-language" >/dev/null
  api POST settings "time-zone" >/dev/null
  log ok "the restart wrote the new Game language into the BIOS settings"
  close_game $key "Cubes Demo"
  key=cubes-demo-europe/ps2
  install_and_play $key "Cubes Demo Europe"
  wait_for $PS2_BOOT_SECONDS guest "grep -q 'BIOS Found: Europe' $(game_log $key)"
  ps2_nvm_holds $PS2_ENGLISH 0
  log ok "a manifest region boots $key on the matching BIOS with its own first-boot settings"
  close_game $key "Cubes Demo Europe"
}

test_gpu() {
  install_and_play alter-ego/nes "Alter Ego"
  switch_gpu_after_games alter-ego/nes
  play_every_other_game
  first=$(other_display)
  api POST settings "display $first" >/dev/null
  expect ".display.display == \"$first\""
  api POST settings "display" >/dev/null
  api POST settings "resolution 0" >/dev/null
  expect ".settings.display == \"\" and .display.display == \"$first\" and .settings.resolution == 0 and .display.canvas == $AREA_SIZE"
}

test_reboot() {
  ensure_installed alter-ego/nes "Alter Ego"
  ensure_installed commander-keen/msdos "Commander Keen"
  api POST settings "resolution 720" >/dev/null
  expect '.settings.resolution == 720'
  expect_reply $STEP_SECONDS 200 ".ok and (.state | $(status_of alter-ego/nes running))" --arg action play --arg game alter-ego/nes
  expect '.rewind.states >= 1'
  guest reboot
  wait_for $BOOT_SECONDS booted 2
  wait_for $STEP_SECONDS kept_rewinds alter-ego/nes
  log ok "the states of a game the reboot interrupted are kept"
  wait_for $STEP_SECONDS guest "grep -qF ' $KERNEL_ARGS' /proc/cmdline"
  log ok "the kernel booted with $KERNEL_ARGS"
  expect ".screen == \"attract\" and ($(status_of alter-ego/nes installed)) and ($(status_of commander-keen/msdos installed)) and .settings.resolution == 720"
  expect_reply $STEP_SECONDS 409 '.error == "Could not start Alter Ego: log in a player first"' --arg action play --arg game alter-ego/nes
  sign_in_from_attract
  api POST settings "resolution 0" >/dev/null
  expect ".settings.resolution == 0 and .display.canvas == $AREA_SIZE"
}

open_store_by_action() { expect_reply $STEP_SECONDS 200 .ok --arg action open-store; }

test_thumbnails() {
  api POST settings "skin switch-black" >/dev/null
  expect '.skin == "switch-black" and (.games[] | select(.key == "alter-ego/nes") | .thumbnail == null)'
  open_store_by_action
  expect "$KEEN_ART | .thumbnailCached and .thumbnailAspect > 0"
  guest "[ -e $LOG_DIR/kiosk.log ] && ! grep -q '$UNDECODABLE' $LOG_DIR/kiosk.log"
  log ok "the Store downloads and draws the boxart of the games it shows"
  art=$(state | jq -r "$KEEN_ART | .thumbnail")
  unnamed=$THUMBNAILS_DIR/msdos/unnamed$THUMBNAIL_EXTENSION
  guest "printf $STALE_ART > /tmp/stale && cp /tmp/stale '$art' && touch -d $STALE_DATE '$art' && cp /tmp/stale '$unnamed'"
  expect "$KEEN_ART | .thumbnailCached and .thumbnailAspect == null"
  open_store_by_action
  wait_for $STEP_SECONDS guest "! cmp -s /tmp/stale '$art' && [ ! -e '$unnamed' ]"
  log ok "a refresh downloads boxart libretro changed and deletes boxart no manifest names"
  undecodable=$(guest "grep -c '$UNDECODABLE' $LOG_DIR/kiosk.log || true")
  expect_reply $STEP_SECONDS 200 .ok --arg action open-settings
  guest "printf $STALE_ART > /tmp/stale && touch -r '$art' /tmp/stale && cp -p /tmp/stale '$art'"
  open_store_by_action
  expect_reply $STEP_SECONDS 200 .ok --arg action clear-thumbnails
  wait_for $STEP_SECONDS guest "[ ! -e $THUMBNAILS_DIR ]"
  expect "$KEEN_ART | .thumbnailCached | not"
  log ok "Clear thumbnails deletes every cached boxart"
  open_store_by_action
  expect "$KEEN_ART | .thumbnailCached"
  log ok "cleared boxart downloads again when shown"
  guest "[ \$(grep -c '$UNDECODABLE' $LOG_DIR/kiosk.log) = $undecodable ]"
  log ok "boxart drawn before stays drawn after leaving the Store and coming back, without decoding it again"
  oracle=$THUMBNAILS_DIR/msdos/$ORACLE_ART$THUMBNAIL_EXTENSION
  armageddon=$THUMBNAILS_DIR/msdos/$ARMAGEDDON_ART$THUMBNAIL_EXTENSION
  guest "thumbnails fetch '$oracle' '$armageddon' && [ -s '$oracle' ] && [ -s '$armageddon' ]"
  log ok "one fetch downloads every boxart it asks for"
}

TESTS="capture symlinks display audio controllers nes atari ps1 genesis snes actions dreamcast msdos msx2 stores gpu logout reboot skins engines thumbnails enhanced ps2 language time_zone"
names=${*:-$TESTS}
for name in $names; do
  case " $TESTS " in
    *" $name "*) ;;
    *) log FAIL "no test named $name, tests are: $TESTS" >&2; exit 1 ;;
  esac
done

run_tests() {
  start_vm
  install_from_stick
  wait_for $BOOT_SECONDS booted 1
  log ok "booted v$VERSION from the installed disk"
  push_test_bios
  preload_fakepad
  sign_in_from_attract
  expect ".screen == \"home\" and .dashboard and (.rows | length) == 2 and (.display.displays | length) == 2 and .display.canvas == $AREA_SIZE and .display.filter == \"nearest\""
  api POST stores "$TEST_STORE_URL" >/dev/null
  expect '.stores[0].online and ([.games[].key] | index("alter-ego/nes") != null)'
  for name; do "test_$name"; done
  log PASS "v$VERSION installed from USB, then passed: $*"
}

sh build/store
sh build/engines build
mkdir -p $TEST_OUT
rm -f $FAKEPAD_TAR
pids=
for vm in $(seq $TEST_VMS); do
  group=$(echo $names | awk -v vms=$TEST_VMS -v vm=$vm '{ for (name = vm; name <= NF; name += vms) printf "%s ", $name }')
  [ -z "$group" ] || { (run_tests $group) & pids="$pids $!"; }
done
failed=0
for pid in $pids; do wait $pid || failed=1; done
[ $failed = 0 ] || { log FAIL "a test VM failed, see its lines above" >&2; exit 1; }
log PASS "v$VERSION passed: $names"
