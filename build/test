#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. config
. guest/config
VERSION=$(cat VERSION)
OUT=build/out/test
TARGET_SIZE=16G
SSH_TEST_PORT=2223
API_TEST_PORT=8081
POLLS_PER_SECOND=10
SSH_ALIVE_SECONDS=1
POLL_INTERVAL=$(awk "BEGIN { print 1 / $POLLS_PER_SECOND }")
STEP_SECONDS=15
BOOT_SECONDS=180
INSTALL_SECONDS=1200
STARTED=$(date +%s)
TEST_VOLUME=10
SECOND_DISPLAY_WIDTH=1920
SECOND_DISPLAY_HEIGHT=1080
FAKEPAD_IMAGE=anyconsole-fakepad
FAKEPAD_DIR=/tmp/fakepad
FAKEPAD_NAME="PS4 Controller"
FAKEPAD_CROSS=2
REMOTE_PAD="$REMOTE_PAD_NAME 1"
SECOND_REMOTE_PAD="$REMOTE_PAD_NAME 2"
LOW_BATTERY=10
STRONG_RUMBLE_EFFECT=4
REDREAM_ENGINE=$ENGINES/dreamcast/engine
AREA_SIZE='(.display.area_box | "\(.width)x\(.height)")'

monitor() { echo "$1" | socat - UNIX-CONNECT:$OUT/monitor.sock >/dev/null; }
guest() {
  with_password ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR -o ConnectTimeout=1 -o ServerAliveInterval=$SSH_ALIVE_SECONDS -o ServerAliveCountMax=$((STEP_SECONDS / SSH_ALIVE_SECONDS)) -o ControlMaster=auto -o ControlPath=$OUT/ssh.sock -o ControlPersist=yes \
    -p $SSH_TEST_PORT root@127.0.0.1 "$@"
}
api() { curl -fsS -X "$1" --data-binary "${3:-}" "127.0.0.1:$API_TEST_PORT/cgi-bin/api/$2"; }
state() { api GET state; }
log() { echo "$1 +$(($(date +%s) - STARTED))s: $2"; }
diagnose() {
  guest "cat $STATE_FILE /tmp/install.log; echo; for log in $LOG_DIR/*.log; do echo \"== \$log\"; tail -n 15 \"\$log\"; done" >&2 || true
}
wait_for() {
  attempts=$(($1 * POLLS_PER_SECOND)) attempt=0
  shift
  until "$@" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    [ $attempt -le $attempts ] || { log FAIL "timed out waiting for: $*" >&2; diagnose; exit 1; }
    sleep $POLL_INTERVAL
  done
}
holds() { state | jq -e "$1"; }
expect() { wait_for $STEP_SECONDS holds "$1"; log ok "$1"; }
game_name() { echo "${1%/*}-${1#*/}"; }
game_log() { echo "$LOG_DIR/$(game_name "$1").log"; }
status_of() { echo ".games[] | select(.key == \"$1\") | .status == \"$2\""; }
row_value() { echo ".rows[] | select(.label == \"$1\") | .value"; }
send() { api POST input "$(printf '%s\n' "$@")" >/dev/null; }
tap() { send "${PAD:-1} $1 1" "${PAD:-1} $1 0"; }
device_named() { echo ".controllers.devices[] | select(.name == \"$1\")"; }
device_id() {
  wait_for $STEP_SECONDS holds "[$(device_named "$1")] != []"
  state | jq "$(device_named "$1") | .id"
}
device_mode() { echo "($(device_named "$1") | .mode)"; }
players() { echo "[.session.players[].profile]"; }
key() { send "EV_KEY $1 1" "EV_KEY $1 0"; }
highlight() {
  while current=$(state); [ "$(echo "$current" | jq -r '.rows[.selected].label')" != "$1" ]; do
    target=$(echo "$current" | jq "[.rows[].label] | index(\"$1\")")
    selected=$(echo "$current" | jq .selected)
    [ "$target" != null ] || { log FAIL "no row $1" >&2; diagnose; exit 1; }
    if [ "$selected" -lt "$target" ]; then tap dpdown; else tap dpup; fi
    wait_for $STEP_SECONDS holds ".selected != $selected or ([.rows[].label] | index(\"$1\")) != $target"
  done
}
adjust_to() {
  while current=$(state | jq -r "$(row_value "$1")"); [ "$current" != "$2" ]; do
    tap dpright
    wait_for $STEP_SECONDS holds "$(row_value "$1") != \"$current\""
  done
}
choose() {
  highlight "$1"
  tap a
}
snapshot() { monitor "screendump $OUT/$1.png -f png"; wait_for $STEP_SECONDS test -s "$OUT/$1.png"; }
booted() { guest "grep -q VERSION=$VERSION /etc/anyconsole-release && [ \$(cat /data/boots) = $1 ] && pidof overlay && [ -s $STATE_FILE ]"; }

start_vm() {
  sh build/store
  rm -rf $OUT
  mkdir -p $OUT
  truncate -s $TARGET_SIZE $OUT/target.img
  cp /usr/share/OVMF/OVMF_VARS.fd $OUT/efivars.fd
  run_qemu $OUT/efivars.fd $OUT/target.img \
    "hostfwd=tcp:127.0.0.1:$SSH_TEST_PORT-:22,hostfwd=tcp:127.0.0.1:$API_TEST_PORT-:$API_PORT" \
    -device qemu-xhci -drive file=build/out/installer.img,format=raw,if=none,id=usb0 -device usb-storage,drive=usb0,id=stick \
    -device virtio-gpu-pci,xres=$SECOND_DISPLAY_WIDTH,yres=$SECOND_DISPLAY_HEIGHT -display none -monitor unix:$OUT/monitor.sock,server,nowait -serial file:$OUT/serial.log &
  trap 'monitor quit' EXIT
}

install_from_stick() {
  wait_for $BOOT_SECONDS guest true
  for key in 1 ret y ret; do monitor "sendkey $key"; done
  wait_for $BOOT_SECONDS guest 'findfs LABEL=data && ! pidof mkdisk'
  monitor "device_del stick"
  monitor "sendkey ret"
}

start_install() {
  choose "$1"
  expect '.screen == "game"'
  choose "Install from"
}

finish_install() {
  wait_for $INSTALL_SECONDS holds "$(status_of "$1" installed)"
  log ok "installed $1"
}

install_game() {
  start_install "$2"
  finish_install "$1"
}

install_watching_home() {
  row=$(row_value "$2")
  start_install "$2"
  expect ".games[] | select(.key == \"$1\") | .status | test(\"^building [0-9]+%$\")"
  tap b
  expect '.screen == "store"'
  tap b
  expect ".screen == \"home\" and ($row | test(\"^${1#*/}  (building|copying) [0-9]+%$\"))"
  shown=$(state | jq -r "$row")
  wait_for $INSTALL_SECONDS holds "$row != \"$shown\""
  log ok "the home list moved on from \"$shown\" while $1 installed"
  finish_install "$1"
  choose "$2"
  expect '.screen == "game"'
}

play_game() {
  choose Play
  snapshot "${1%/*}-launch"
  expect ".active == \"$1\" and (.dashboard | not) and ($(status_of "$1" running)) and .display.shown == \"$1\" and .display.frame != \"\""
  sandbox_globals=$(guest "WAYLAND_DISPLAY=$SOCKETS_DIR/$(game_name "$1")/wayland-0 wayland-info")
  echo "$sandbox_globals" | grep -q "'wl_compositor'" && ! echo "$sandbox_globals" | grep -q -e zwlr_layer_shell_v1 -e zwlr_screencopy_manager_v1 ||
    { log FAIL "$1 is not confined by its security context" >&2; exit 1; }
  log ok "$1 sees no privileged wayland protocols"
}

open_store() {
  choose Store
  expect '.screen == "store"'
}

change_resolution_in_settings() {
  choose Settings
  expect '.screen == "settings"'
  choose "Game resolution"
  tap dpright
  expect '.settings.resolution == 720 and .display.canvas == "1280x720"'
  tap dpright
  expect '.settings.resolution == 1080 and .display.canvas == "1920x1080" and .display.filter == "linear"'
  snapshot settings
  api POST settings "resolution 0" >/dev/null
  expect ".settings.resolution == 0 and .display.canvas == $AREA_SIZE"
  ! api POST settings "resolution 1" 2>/dev/null || { log FAIL "accepted a resolution outside RESOLUTIONS" >&2; exit 1; }
  log ok "rejected a resolution outside RESOLUTIONS"
  tap b
  expect '.screen == "home"'
}

stage_mode() {
  highlight "Display resolution"
  for tap in $(seq $taps); do tap dpright; done
}

stage_display_mode_until_saved() {
  read -r auto taps chosen <<MODES
$(state | jq -r '.display.mode as $mode | ([.display.modes[] | . != $mode] | index(true)) as $index | "\($mode) \($index + 1) \(.display.modes[$index])"')
MODES
  choose Settings
  stage_mode
  expect "any(.rows[]; .label == \"Save\") and .display.mode == \"$auto\" and (.settings.mode // \"\") == \"\""
  tap b
  expect ".screen == \"home\" and .display.mode == \"$auto\" and (.settings.mode // \"\") == \"\""
  choose Settings
  expect '.screen == "settings" and all(.rows[]; .label != "Save")'
  stage_mode
  choose Save
  expect ".settings.mode == \"$chosen\" and .display.mode == \"$chosen\" and all(.rows[]; .label != \"Save\") and .rows[.selected].label == \"Display resolution\""
  api POST settings "mode" >/dev/null
  expect ".settings.mode == \"\" and .display.mode == \"$auto\""
  tap b
  expect '.screen == "home"'
}

switch_gpu_after_games() {
  second=$(state | jq -r '.display as $display | $display.displays[] | select(.gpu != $display.gpu) | .label')
  api POST settings "display $second" >/dev/null
  expect ".display.pending == \"$second\" and any(.notifications[]; startswith(\"Close and restart your games\")) and .display.shown == \"$1\""
  guest games stop
  expect ".display.pending == null and .display.display == \"$second\" and $AREA_SIZE == \"${SECOND_DISPLAY_WIDTH}x$SECOND_DISPLAY_HEIGHT\" and .screen == \"home\""
  api POST settings "resolution 720" >/dev/null
  expect '.display.canvas == "1280x720" and .display.filter == "pixel"'
  api POST settings "display" >/dev/null
  expect ".settings.display == \"\" and .display.display == \"$second\""
}

remember_guide_position() {
  tap guide
  expect '.guide and .screen == "guide" and .rows[.selected].label == "Rewind"'
  highlight Volume
  tap guide
  expect '.guide | not'
  tap guide
  expect '.guide and .rows[.selected].label == "Volume"'
  tap guide
  expect '.guide | not'
}

rewind_to_older_state() {
  expect '.rewind.states >= 2'
  wait_for $STEP_SECONDS guest "[ \$(ls $REWIND_DIR/$(game_name "$1")/states/*.screen.png | wc -l) -ge 2 ]"
  log ok "the saved $1 states have screen captures"
  tap guide
  expect ".guide and .rows[1].label == \"Rewind\" and .rewind.back == 0 and ($(status_of "$1" paused))"
  highlight Rewind
  tap dpleft
  expect '.rewind.back == 1 and .rows[.selected].value != "Now"'
  tap guide
  expect "(.guide | not) and ($(status_of "$1" running))"
  tap guide
  expect '.guide and .rewind.back == 0 and .rows[.selected].label == "Rewind" and .rows[.selected].value == "Now"'
  snapshot rewind-now
  tap dpleft
  tap dpleft
  expect '.rewind.back == 2'
  snapshot rewind
  states=$(state | jq .rewind.states)
  tap a
  expect "(.guide | not) and .rewind.states == $((states - 1)) and .rewind.back == 0 and ($(status_of "$1" running))"
  wait_for $STEP_SECONDS guest "grep -q 'Loading state' $(game_log "$1") && ! grep -q 'Failed to load state' $(game_log "$1")"
  log ok "rewound $1 to an older state"
}

play_new_game() {
  open_store
  install_game "$1" "$2"
  play_game "$1"
}

close_game() {
  back_to_dashboard
  expect "$(status_of "$1" paused)"
  choose "$2"
  choose Close
  expect "$(status_of "$1" installed)"
  tap b
  expect '.screen == "home"'
}

play_every_other_game() {
  for directory in "$TEST_STORE"/*/*/; do
    key=${directory#"$TEST_STORE/"}
    key=${key%/}
    holds "$(status_of "$key" "")" >/dev/null || continue
    title=$(jq -r .title "$TEST_STORE/${key%/*}/manifest.json")
    play_new_game "$key" "$title"
    snapshot "$(game_name "$key")"
    close_game "$key" "$title"
  done
}

build_fakepad() {
  guest "mkdir -p $FAKEPAD_DIR"
  for file in Dockerfile ds4.py; do guest "cat > $FAKEPAD_DIR/$file" < "build/fakepad/$file"; done
  guest "docker build -q --network host -t $FAKEPAD_IMAGE $FAKEPAD_DIR"
}
fakepad_logs() { guest "docker logs fakepad-$1 2>&1"; }
fakepad_created() { fakepad_logs "$1" | grep -qx created; }
fakepad_rumbled() { fakepad_logs bluetooth | grep -q '^rumble '; }
plug_fakepad() {
  guest "docker run -d --rm --name fakepad-$1 --network host --device /dev/uhid $FAKEPAD_IMAGE $1" >/dev/null
  wait_for $STEP_SECONDS fakepad_created "$1"
}
fakepad() { bus=$1; shift; guest "docker exec fakepad-$bus sh -c 'echo $* > /tmp/control'"; }
has_fakepad() { echo ".controllers.controllers | any(.name == \"$FAKEPAD_NAME\" and .connection == \"$1\" and .battery != null)"; }

hotplug_wired_controller() {
  plug_fakepad usb
  expect "($(has_fakepad wired)) and (.controllers.bluetooth | not) and any(.notifications[]; . == \"Connected $FAKEPAD_NAME\")"
  wired=$(device_id "$FAKEPAD_NAME")
  api POST login "1 $wired" >/dev/null
  expect "(.session.players[0].devices | index($wired) != null) and ([$(device_named "$FAKEPAD_NAME") | .pad] == [1])"
  tap guide
  expect '.guide and .screen == "guide"'
  choose Controllers
  expect ".screen == \"controllers\" and ([.rows[].label] | index(\"Pair new controller\") == null) and any(.rows[]; .label == \"$FAKEPAD_NAME\" and (.value | startswith(\"Wired\")))"
  snapshot controllers
  tap b
  tap guide
  expect '.guide | not'
  fakepad usb unplug
  expect "(.controllers.controllers | length) == 0 and any(.notifications[]; . == \"Disconnected $FAKEPAD_NAME\")"
}

play_wireless_controller() {
  plug_fakepad bluetooth
  expect "$(has_fakepad bluetooth)"
  pad=$(device_id "$FAKEPAD_NAME")
  expect ".screen == \"whois\" and .session.picker == $pad and (.guide | not)"
  fakepad bluetooth press $FAKEPAD_CROSS
  fakepad bluetooth release $FAKEPAD_CROSS
  expect "(.screen == \"whois\" | not) and (.session.players[0].devices | index($pad) != null) and ([.controllers.devices[] | select(.id == $pad) | .pad] == [1])"
  fakepad bluetooth press
  expect '.guide and .screen == "guide" and ([.rows[].label] | index("Microphone") != null)'
  fakepad bluetooth release
  fakepad bluetooth press
  fakepad bluetooth release
  expect '.guide | not'
  guest "docker run -d -i --name rumble --network none --device $PAD_NODES/event0:/dev/input/event0 --entrypoint sh $FAKEPAD_IMAGE -c '{ echo $STRONG_RUMBLE_EFFECT; cat; } | fftest /dev/input/event0'" >/dev/null
  wait_for $STEP_SECONDS fakepad_rumbled
  guest "docker rm -f rumble" >/dev/null
  log ok "rumble played on the virtual pad reached the physical pad"
  fakepad bluetooth battery $LOW_BATTERY
  expect "any(.notifications[]; . == \"$FAKEPAD_NAME battery low\")"
  fakepad bluetooth unplug
  expect '(.controllers.controllers | length) == 0'
}

hotplug_controllers() {
  build_fakepad
  hotplug_wired_controller
  play_wireless_controller
  api POST settings "sleep 30" >/dev/null
  expect '.settings.sleep == 30'
  ! api POST settings "sleep 7" 2>/dev/null || { log FAIL "accepted a sleep outside SLEEP_MINUTES" >&2; exit 1; }
  log ok "rejected a sleep outside SLEEP_MINUTES"
}

sign_in_from_attract() {
  expect '.screen == "attract" and (.session.players | length) == 0'
  snapshot attract
  tap a
  pad=$(device_id "$REMOTE_PAD")
  expect ".screen == \"whois\" and .session.picker == $pad"
  snapshot whois
  choose "Player 1"
  expect ".screen == \"home\" and $(players) == [1] and .session.players[0].devices == [$pad] and $(device_mode "$REMOTE_PAD") == \"analog\""
}

join_keyboard() {
  key KEY_UP
  keyboard=$(device_id "$REMOTE_KEYBOARD_NAME")
  expect ".screen == \"whois\" and .session.picker == $keyboard and (.guide | not)"
  key KEY_ENTER
  expect "(.screen == \"whois\" | not) and (.session.players[0].devices | index($keyboard) != null)"
}

second_player_joins_and_leaves() {
  PAD=2 tap guide
  second=$(device_id "$SECOND_REMOTE_PAD")
  expect ".screen == \"whois\" and .session.picker == $second and ($(status_of "$1" paused))"
  PAD=2 choose "Player 2"
  expect "$(players) == [1, 2] and .session.players[1].devices == [$second] and ($(status_of "$1" running))"
  wait_for $STEP_SECONDS guest "[ -e $PAD_NODES/event1 ]"
  log ok "Player 2 got the second virtual pad"
  [ -z "${2:-}" ] || { wait_for $STEP_SECONDS "$2"; log ok "$2"; }
  PAD=2 tap guide
  expect ".guide and .session.focus == $second and .rows[-1].label == \"Log out\""
  PAD=2 choose "Log out"
  expect "$(players) == [1] and (.guide | not) and ($(status_of "$1" running))"
  wait_for $STEP_SECONDS guest "[ ! -e $PAD_NODES/event1 ]"
  log ok "Player 2 logged out and gave the pad back"
}

change_emulation() {
  tap guide
  expect '.guide'
  highlight Emulate
  expect "($(row_value Emulate)) == \"Default (Digital pad)\" and $(device_mode "$REMOTE_PAD") == \"digital\""
  tap dpright
  expect "($(row_value Emulate)) == \"Analog pad\" and $(device_mode "$REMOTE_PAD") == \"analog\""
  tap dpleft
  expect "($(row_value Emulate)) == \"Default (Digital pad)\" and $(device_mode "$REMOTE_PAD") == \"digital\""
  tap guide
  expect '.guide | not'
}

emulate_keyboard_with_pad() {
  tap guide
  expect '.guide'
  highlight Emulate
  expect "($(row_value Emulate)) == \"Default (Analog pad)\""
  adjust_to Emulate Keyboard
  expect "($(row_value Emulate)) == \"Keyboard\" and $(device_mode "$REMOTE_PAD") == \"keyboard\""
  tap guide
  expect "(.guide | not) and ($(status_of commander-keen/msdos running))"
}

input_holds() {
  directory=$1 name=$2
  shift 2
  guest "docker run --rm -i --network none --device-cgroup-rule 'c 13:* rw' -v $directory:/dev/input:ro --entrypoint python3 $FAKEPAD_IMAGE - '$name' $*" <<'PYTHON'
import glob, sys, libevdev
devices = (libevdev.Device(open(path, "rb")) for path in sorted(glob.glob("/dev/input/event*")))
device = next(device for device in devices if device.name == sys.argv[1])
sys.exit(any(device.value[libevdev.evbit(code)] != int(value) for code, value in zip(sys.argv[2::2], sys.argv[3::2])))
PYTHON
}

redream_gave_second_pad() {
  port=$(guest "sed -n 's/^port1=dev:\([0-9]*\),desc:\([0-9a-f]*\),.*/registered device \1 desc=\2/p' $REDREAM_ENGINE/redream.cfg")
  [ -n "$port" ] && guest "grep -qF '$port name=$PAD_NAME #2' $REDREAM_ENGINE/redream.log"
}

play_dreamcast_with_two_players() {
  play_new_game gravity-wave/dreamcast "Gravity Wave"
  send "1 lefty 0"
  wait_for $STEP_SECONDS input_holds $PAD_NODES "$PAD_NAME" BTN_NORTH 1 ABS_Y $AXIS_CENTER
  send "1 lefty $AXIS_CENTER" "1 righty 0"
  wait_for $STEP_SECONDS input_holds $PAD_NODES "$PAD_NAME" BTN_NORTH 0 ABS_Y 0
  send "1 righty $AXIS_CENTER"
  log ok "the manifest's pad map moves with the left stick and aims with the right"
  second_player_joins_and_leaves gravity-wave/dreamcast redream_gave_second_pad
  close_game gravity-wave/dreamcast "Gravity Wave"
}

log_out_closing_games() {
  choose "Alter Ego"
  choose Play
  expect ".active == \"alter-ego/nes\" and ($(status_of alter-ego/nes running)) and (.games[] | select(.key == \"alter-ego/nes\") | .owner) == 1"
  tap guide
  expect '.guide'
  choose "Log out"
  expect '.screen == "logout" and .rows[0].value == "Closes 1 games"'
  choose "Log out"
  expect ".screen == \"whois\" and (.session.players | length) == 0 and ($(status_of alter-ego/nes installed))"
  tap b
  expect '.screen == "attract"'
  snapshot attract-after-logout
}

back_to_dashboard() {
  tap guide
  expect '.guide and .screen == "guide"'
  choose Dashboard
  expect '.dashboard and (.guide | not) and .screen == "home"'
}

start_vm
install_from_stick
wait_for $BOOT_SECONDS booted 1
sign_in_from_attract
expect ".screen == \"home\" and .dashboard and (.rows | length) == 2 and (.display.displays | length) == 2 and .display.canvas == $AREA_SIZE and .display.filter == \"nearest\""
snapshot home
wait_for $STEP_SECONDS guest ". /etc/profile; WAYLAND_DISPLAY=wayland-0 grim /tmp/home.png && [ -s /tmp/home.png ]"
log ok "grim captures the idle screen"
change_resolution_in_settings
stage_display_mode_until_saved
wait_for $STEP_SECONDS guest "! grep -q '^snd_pcsp ' /proc/modules && ! grep -q 'BlueZ SPA plugin is missing' $LOG_DIR/pipewire.log"
log ok "the PC speaker is no audio output and PipeWire loaded its Bluetooth plugin"
hotplug_controllers

api POST stores "$TEST_STORE_URL" >/dev/null
expect '.stores[0].online and ([.games[].key] | index("alter-ego/nes") != null)'

open_store
install_watching_home alter-ego/nes "Alter Ego"
play_game alter-ego/nes
wait_for $STEP_SECONDS guest "grep -qF 'configured in port 1' $(game_log alter-ego/nes)"
log ok "RetroArch configured the virtual pad"
wait_for $STEP_SECONDS guest "[ -d $PROFILES_DIR/1/saves/$(game_name alter-ego/nes) ]"
log ok "Player 1 plays with its own saves"
snapshot alter-ego
api POST settings "resolution 1080" >/dev/null
expect ".display.canvas == \"1920x1080\" and .display.frame == .display.canvas and ($(status_of alter-ego/nes running))"
snapshot alter-ego-1080
api POST settings "resolution 0" >/dev/null
expect ".display.canvas == $AREA_SIZE and .display.frame == .display.canvas and ($(status_of alter-ego/nes running))"
wait_for $STEP_SECONDS guest ". /etc/profile; pw-dump | jq -e '[.[] | select(.info.props[\"media.class\"]? == \"Stream/Output/Audio\" and .info.state == \"running\")] | length == 1'"
log ok "the game plays sound into PipeWire"
remember_guide_position
change_emulation
second_player_joins_and_leaves alter-ego/nes

tap guide
expect ".guide and .screen == \"guide\" and ($(status_of alter-ego/nes paused)) and .audio.output != \"\""
snapshot guide
choose Dashboard
expect '.dashboard and (.guide | not) and .screen == "home"'

play_new_game lan-master/nes "LAN Master"
expect "$(status_of alter-ego/nes paused)"

join_keyboard
key KEY_LEFTMETA
expect ".guide and ($(status_of lan-master/nes paused))"
key KEY_ESC
expect "(.guide | not) and ($(status_of lan-master/nes running))"
send "1 back 1" "1 start 1" "1 start 0" "1 back 0"
expect '.guide'
tap guide
expect "(.guide | not) and ($(status_of lan-master/nes running))"

back_to_dashboard
choose "Alter Ego"
choose Resume
expect ".active == \"alter-ego/nes\" and ($(status_of alter-ego/nes running)) and ($(status_of lan-master/nes paused))"

back_to_dashboard
choose "LAN Master"
choose Close
expect "$(status_of lan-master/nes installed)"
choose Uninstall
expect '[.games[] | select(.key == "lan-master/nes")] | all(.status == "")'

tap b
play_new_game commander-keen/msdos "Commander Keen"
expect '.rewind.states >= 1'
emulate_keyboard_with_pad
wait_for $STEP_SECONDS guest "grep -q 'DOSBOX STATUS\] Program: KEEN1 ' $(game_log commander-keen/msdos)"
log ok "DOSBox Pure started the only executable, KEEN1"
snapshot keen
rewind_to_older_state commander-keen/msdos
send "1 a 1"
wait_for $STEP_SECONDS input_holds $INPUT_NODES "$KEYBOARD_NAME" KEY_ENTER 1
send "1 a 0"
wait_for $STEP_SECONDS input_holds $INPUT_NODES "$KEYBOARD_NAME" KEY_ENTER 0
log ok "the pad's A pressed and released Enter on the virtual keyboard"
key KEY_LEFTMETA
expect ".guide and ($(status_of commander-keen/msdos paused))"
tap guide

api POST volume $TEST_VOLUME >/dev/null
expect ".audio.volume == $TEST_VOLUME"

api DELETE stores/1 >/dev/null
expect '(.stores | length) == 0 and all(.games[]; (.stores | length) == 0)'
expect '[.games[] | select(.key == "alter-ego/nes" or .key == "commander-keen/msdos") | .status != ""] | length == 2 and all'
api POST stores "$TEST_STORE_URL" >/dev/null
expect '.stores[0].online and all(.games[]; (.stores | length) == 1)'

switch_gpu_after_games commander-keen/msdos
play_dreamcast_with_two_players
play_every_other_game
log_out_closing_games

guest reboot
wait_for $BOOT_SECONDS booted 2
expect ".screen == \"attract\" and ($(status_of alter-ego/nes installed)) and ($(status_of commander-keen/msdos installed)) and .settings.resolution == 720"
log PASS "v$VERSION installed from USB, signed players in and out, installed games from the store, played, emulated, switched, closed, uninstalled, rescaled, moved to another GPU once games quit, and kept them across a reboot"
