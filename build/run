#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. config
. guest/config
sh build/store
run_qemu build/out/efivars.fd build/out/disk.img \
  "hostfwd=tcp:127.0.0.1:$API_PORT-:$API_PORT,hostfwd=tcp:127.0.0.1:$SSH_PORT-:22" \
  -vnc :0 -monitor unix:build/out/monitor.sock,server,nowait -serial file:build/out/boot.log
