#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. ./config
. guest/config
. build/slot
exec 8>>"$VM_FILE"
flock -n 8 || { echo "this worktree's VM is already running" >&2; exit 1; }
claim_slot
printf 'VM_SSH_PORT=%s\nVM_API_PORT=%s\n' "$VM_SSH_PORT" "$VM_API_PORT" > "$VM_FILE"
sh build/store
run_qemu build/out/efivars.fd build/out/disk.img \
  "hostfwd=tcp:127.0.0.1:$VM_API_PORT-:$API_PORT,hostfwd=tcp:127.0.0.1:$VM_SSH_PORT-:22" \
  -vnc :$VM_VNC_DISPLAY -monitor unix:build/out/monitor.sock,server,nowait -serial file:build/out/boot.log -daemonize
