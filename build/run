#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. config
exec qemu-system-x86_64 \
  -machine q35,accel=kvm -cpu host -smp 4 -m 4096 \
  -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE.fd \
  -drive if=pflash,format=raw,file=build/out/efivars.fd \
  -device ich9-ahci,id=ahci -drive file=build/out/disk.img,format=raw,if=none,id=d0 -device ide-hd,drive=d0,bus=ahci.0 \
  -netdev user,id=net0,hostfwd=tcp:127.0.0.1:$API_PORT-:$API_PORT,hostfwd=tcp:127.0.0.1:$SSH_PORT-:22 \
  -device e1000e,netdev=net0,id=$NIC \
  -vga none -device virtio-gpu-pci -vnc :0 \
  -monitor unix:build/out/monitor.sock,server,nowait \
  -serial file:build/out/boot.log
