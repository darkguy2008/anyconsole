#!/bin/sh
set -eu
cd "$(dirname "$0")"
. ./config
. guest/config
ROOTFS_LOG=build/out/rootfs.log
ENGINES_LOG=build/out/engines.log
RSYNCD_CONF=$HOST_DIR/rsyncd.conf
RSYNCD_PID=/run/rsyncd.pid

push_to_host() {
  case "${1:-}" in force|engines) ;; *) echo $(( $(cat VERSION) + 1 )) > VERSION ;; esac
  sync_host
  on_host env ANYCONSOLE_ONHOST=1 sh "$DEPLOY_PATH/deploy" "$@"
}

logged() {
  log=$1
  shift
  "$@" > "$log" 2>&1 || { tail -n 40 "$log" >&2; exit 1; }
}

build_release() {
  date -u > app/changelog
  printf '#!/bin/sh\necho "feature %s online"\n' "$1" > "app/feature-$1"
  chmod +x "app/feature-$1"
  mkdir -p "${ROOTFS_LOG%/*}"
  logged "$ROOTFS_LOG" sh build/host sh build/rootfs
}

publish_engines() {
  logged "$ENGINES_LOG" sh -c 'sh build/engines build && sh build/engines publish'
}

serve_releases() {
  releases_rsyncd_conf "$RELEASES_DIR" "pid file = $RSYNCD_PID" > "$RSYNCD_CONF"
  pgrep -F "$RSYNCD_PID" -L >/dev/null 2>&1 || rsync --daemon --config="$RSYNCD_CONF"
}

[ "${ANYCONSOLE_ONHOST:-}" = 1 ] || { push_to_host "$@"; exit; }

case "${1:-}" in
  engines) publish_engines; serve_releases; echo "published the engines"; exit ;;
  force) mode=${2:-} ;;
  --now) mode=all ;;
  *) mode= ;;
esac

version=$(cat VERSION)
release=
[ "${1:-}" = force ] || { require_newer "$version"; build_release "$version"; publish_engines; release=rel/$version; }

{
  echo "REL=$version"
  case "$mode" in
    install) printf 'SYNC_DELAY=0\nAUTO_INSTALL=1\n' ;;
    all) printf 'SYNC_DELAY=0\nAUTO_INSTALL=1\nAUTO_REBOOT=1\n' ;;
  esac
} | sh build/publish "$version" "$release"
serve_releases
echo "published v$version mode=${mode:-none}"
