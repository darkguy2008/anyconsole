#!/bin/sh
set -eu
cd "$(dirname "$0")"
. ./config
INDEX=rel/index
ROOTFS_LOG=build/out/rootfs.log
RSYNCD_CONF=build/out/rsyncd.conf
RSYNCD_PID=/run/rsyncd.pid

push_to_host() {
  [ "${1:-}" = force ] || echo $(( $(cat VERSION) + 1 )) > VERSION
  sync_host
  exec ssh "$DEPLOY_HOST" "cd $DEPLOY_PATH && ANYCONSOLE_ONHOST=1 ./deploy $*"
}

build_release() {
  date -u > app/changelog
  printf '#!/bin/sh\necho "feature %s online"\n' "$1" > "app/feature-$1"
  chmod +x "app/feature-$1"
  sh build/host sh build/rootfs > "$ROOTFS_LOG" 2>&1 || { tail -n 40 "$ROOTFS_LOG" >&2; exit 1; }
}

serve_releases() {
  mkdir -p "${RSYNCD_CONF%/*}"
  printf 'use chroot = no\nuid = root\ngid = root\npid file = %s\n[rel]\npath = %s/rel\nread only = yes\n' \
    "$RSYNCD_PID" "$PWD" > "$RSYNCD_CONF"
  pgrep -F "$RSYNCD_PID" -L >/dev/null 2>&1 || rsync --daemon --config="$PWD/$RSYNCD_CONF"
}

[ "${ANYCONSOLE_ONHOST:-}" = 1 ] || push_to_host "$@"

case "${1:-}" in
  force) mode=${2:-} ;;
  --now) mode=all ;;
  *) mode= ;;
esac

version=$(cat VERSION)
[ "${1:-}" = force ] || build_release "$version"

{
  echo "REL=$version"
  case "$mode" in
    install) printf 'SYNC_DELAY=0\nAUTO_INSTALL=1\n' ;;
    all) printf 'SYNC_DELAY=0\nAUTO_INSTALL=1\nAUTO_REBOOT=1\n' ;;
  esac
} > "$INDEX"
serve_releases
echo "published v$version mode=${mode:-none}"
